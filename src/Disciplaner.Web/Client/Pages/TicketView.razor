@page "/tickets/{Id:guid}"
@page "/tickets/{Ref}"
@attribute [Authorize]
@inject TicketApiClient TicketApi
@inject ProjectApiClient ProjectApi
@inject CommentApiClient CommentApi
@inject NavigationManager Nav
@inject IStringLocalizer<AppResources> L

<PageTitle>@(_ticket?.TicketRef ?? L["Title"].Value) — Disciplaner</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_ticket is not null)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="flex items-center gap-1 text-sm text-gray-500">
            <li><a href="/projects" class="hover:text-gray-700">Projets</a></li>
            <li class="text-gray-300">/</li>
            <li><a href="/projects/@_ticket.ProjectId" class="hover:text-gray-700">@_ticket.ProjectKey</a></li>
            <li class="text-gray-300">/</li>
            <li class="text-gray-800">@_ticket.TicketRef</li>
        </ol>
    </nav>

    <div class="surface mx-auto" style="max-width:860px">
        <div class="flex flex-wrap items-center gap-2 px-6 py-4 border-b border-gray-100">
            <span class="badge badge-dark font-mono">@_ticket.TicketRef</span>
            <h1 class="text-lg font-semibold text-gray-900 flex-1">@_ticket.Title</h1>
            <span class="badge badge-gray">@_ticket.Type</span>
            <span class="badge @PriorityClass(_ticket.Priority)">@_ticket.Priority</span>
        </div>

        <div class="px-6 py-5">
            @if (_editing)
            {
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">@L["Title"]</label>
                        <InputText class="form-input" @bind-Value="_form.Title" />
                        <ValidationMessage For="() => _form.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Description"]</label>
                        <InputTextArea class="form-textarea" rows="5" @bind-Value="_form.Description" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="form-label">@L["Type"]</label>
                            <InputSelect class="form-select" @bind-Value="_form.Type">
                                @foreach (var type in Enum.GetValues<TicketType>())
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="form-label">@L["Priority"]</label>
                            <InputSelect class="form-select" @bind-Value="_form.Priority">
                                @foreach (var priority in Enum.GetValues<CardPriority>())
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="form-label">@L["Ticket.StoryPoints"]</label>
                            <InputNumber class="form-input" @bind-Value="_form.StoryPoints" />
                        </div>
                        <div>
                            <label class="form-label">@L["Ticket.DueDate"]</label>
                            <InputDate class="form-input" @bind-Value="_form.DueDate" />
                        </div>
                    </div>
                    @if (_actionError is not null)
                    {
                        <div class="mt-3"><ErrorAlert Message="@_actionError" /></div>
                    }
                    <div class="flex justify-end gap-2 mt-4">
                        <button type="button" class="btn btn-outline" @onclick="() => _editing = false" disabled="@_busy">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "…" : L["Save"].Value)</button>
                    </div>
                </EditForm>
            }
            else
            {
                @* Status selector *@
                <div class="flex items-center gap-2 mb-4">
                    <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:@_ticket.Status.Color"></span>
                    @if (_statuses.Count > 0)
                    {
                        <select class="form-select" style="width:auto;"
                                value="@_ticket.Status.Id"
                                @onchange="OnStatusChangeAsync"
                                disabled="@_busy">
                            @foreach (var s in _statuses.OrderBy(s => s.Order))
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <span class="badge badge-gray">@_ticket.Status.Name</span>
                    }
                </div>

                @* Description *@
                @if (!string.IsNullOrWhiteSpace(_ticket.Description))
                {
                    <div class="mb-4">
                        <p class="section-label mb-1">Description</p>
                        <div class="detail-description">@_ticket.Description</div>
                    </div>
                }
                else
                {
                    <p class="text-gray-400 text-sm italic mb-4">@L["Ticket.NoDescription"]</p>
                }

                @* Meta *@
                <div class="flex flex-wrap gap-4 text-xs text-gray-500 mb-4">
                    @if (_ticket.StoryPoints.HasValue)
                    {
                        <span><i class="bi bi-stars mr-1"></i>@_ticket.StoryPoints pts</span>
                    }
                    @if (_ticket.DueDate.HasValue)
                    {
                        var overdue = _ticket.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                        <span class="@(overdue ? "text-red-600 font-semibold" : string.Empty)">
                            <i class="bi bi-calendar3 mr-1"></i>@_ticket.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")
                            @(overdue ? " — " + L["Ticket.Overdue"].Value : string.Empty)
                        </span>
                    }
                    @if (_ticket.SprintName is not null)
                    {
                        <span><i class="bi bi-lightning mr-1"></i>@_ticket.SprintName</span>
                    }
                    @if (_ticket.ParentTicketRef is not null)
                    {
                        <span><i class="bi bi-diagram-3 mr-1"></i>Parent : @_ticket.ParentTicketRef</span>
                    }
                </div>

                <div class="text-xs text-gray-400 border-t border-gray-100 pt-3 flex gap-4 flex-wrap">
                    <span><i class="bi bi-person mr-1"></i>@L["Ticket.Reporter"] <strong class="text-gray-600">@_ticket.ReporterName</strong></span>
                    @if (_ticket.AssigneeName is not null)
                    {
                        <span><i class="bi bi-person-check mr-1"></i>@L["Ticket.Assignee"] <strong class="text-gray-600">@_ticket.AssigneeName</strong></span>
                    }
                    <span>le @_ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    @if (_ticket.UpdatedAt.HasValue)
                    {
                        <span>Modifié le @_ticket.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </div>

                @* Comments *@
                <div class="mt-5">
                    <p class="section-label mb-3"><i class="bi bi-chat-left-text mr-1"></i>@L["Ticket.Comments"]</p>
                    @if (_commentsLoading)
                    {
                        <p class="text-gray-400 text-sm">@L["Loading"]</p>
                    }
                    else
                    {
                        @foreach (var c in _comments)
                        {
                            <div class="flex gap-3 mb-4">
                                <div class="w-8 h-8 rounded-full bg-gray-300 text-white flex items-center justify-center text-xs font-bold shrink-0">
                                    @(c.AuthorName.Length > 0 ? c.AuthorName[0].ToString().ToUpper() : "?")
                                </div>
                                <div class="flex-1">
                                    <div class="flex gap-2 items-baseline mb-1">
                                        <span class="text-sm font-semibold text-gray-800">@c.AuthorName</span>
                                        <span class="text-gray-400" style="font-size:.72rem">@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (_editingCommentId == c.Id)
                                    {
                                        <textarea class="form-textarea text-sm" rows="2" @bind="_editCommentContent"></textarea>
                                        <div class="flex gap-1 mt-1">
                                            <button class="btn btn-primary btn-sm" @onclick="() => SaveCommentEditAsync(c.Id)">@L["Ticket.Comment.Save"]</button>
                                            <button class="btn btn-outline btn-sm" @onclick="() => _editingCommentId = null">@L["Cancel"]</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-sm text-gray-700">@c.Content</div>
                                        <div class="flex gap-2 mt-1">
                                            <button class="text-xs text-gray-400 hover:text-gray-600" @onclick="() => StartEditComment(c)">@L["Ticket.Comment.Edit"]</button>
                                            <button class="text-xs text-red-400 hover:text-red-600" @onclick="() => DeleteCommentAsync(c.Id)">@L["Ticket.Comment.Delete"]</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="flex gap-2 mt-3">
                            <div class="flex-1">
                                <textarea class="form-textarea text-sm" rows="2" placeholder="@L["Ticket.Comment.Add"].Value" @bind="_newCommentContent"></textarea>
                            </div>
                            <button class="btn btn-primary btn-sm self-end" @onclick="AddCommentAsync" disabled="@(string.IsNullOrWhiteSpace(_newCommentContent))">
                                <i class="bi bi-send"></i>
                            </button>
                        </div>
                    }
                </div>

                @if (_actionError is not null)
                {
                    <div class="mt-3"><ErrorAlert Message="@_actionError" /></div>
                }
            }
        </div>

        @if (!_editing)
        {
            <div class="flex justify-end gap-2 px-6 py-4 border-t border-gray-100">
                <button class="btn btn-danger btn-sm" @onclick="DeleteAsync" disabled="@_busy">
                    <i class="bi bi-trash mr-1"></i>@L["Delete"]
                </button>
                <button class="btn btn-primary btn-sm" @onclick="EnterEdit">
                    <i class="bi bi-pencil mr-1"></i>@L["Edit"]
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Ref { get; set; }

    private TicketDto? _ticket;
    private readonly List<TicketStatusDto> _statuses = [];
    private bool _loading = true;
    private bool _busy;
    private bool _editing;
    private string? _error;
    private string? _actionError;
    private TicketEditForm _form = new();

    // Comments
    private IReadOnlyList<CommentDto> _comments = [];
    private bool _commentsLoading;
    private string _newCommentContent = string.Empty;
    private Guid? _editingCommentId;
    private string _editCommentContent = string.Empty;

    private sealed class TicketEditForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public TicketType Type { get; set; } = TicketType.Story;
        public CardPriority Priority { get; set; } = CardPriority.Medium;
        public int? StoryPoints { get; set; }
        public DateTime? DueDate { get; set; }
    }

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            if (Id != Guid.Empty)
            {
                _ticket = await TicketApi.GetByIdAsync(Id);
            }
            else if (!string.IsNullOrEmpty(Ref))
            {
                var parts = Ref.Split('-');
                if (parts.Length >= 2 && int.TryParse(parts[^1], out var num))
                {
                    var key = string.Join('-', parts[..^1]);
                    _ticket = await TicketApi.GetByRefAsync(key, num);
                }
                else
                {
                    _error = $"Référence invalide : {Ref}";
                    return;
                }
            }

            if (_ticket is not null)
            {
                var project = await ProjectApi.GetProjectAsync(_ticket.ProjectId);
                _statuses.Clear();
                if (project is not null)
                    _statuses.AddRange(project.Statuses);

                _commentsLoading = true;
                try { _comments = await CommentApi.GetByTicketAsync(_ticket.Id); }
                catch { _comments = []; }
                finally { _commentsLoading = false; }
            }
            else if (_error is null)
            {
                _error = "Ticket introuvable.";
            }
        }
        catch { _error = "Impossible de charger ce ticket."; }
        finally { _loading = false; }
    }

    private void EnterEdit()
    {
        if (_ticket is null) return;
        _form = new()
        {
            Title       = _ticket.Title,
            Description = _ticket.Description,
            Type        = _ticket.Type,
            Priority    = _ticket.Priority,
            StoryPoints = _ticket.StoryPoints,
            DueDate     = _ticket.DueDate
        };
        _actionError = null;
        _editing     = true;
    }

    private async Task SaveAsync()
    {
        if (_ticket is null) return;
        _busy = true; _actionError = null;
        try
        {
            await TicketApi.UpdateAsync(_ticket.Id, new UpdateTicketRequest(
                _form.Title, _form.Description, _form.Type, _form.Priority,
                _form.StoryPoints, _form.DueDate, _ticket.AssigneeId));
            _editing = false;
            await LoadAsync();
        }
        catch { _actionError = "La mise à jour a échoué."; }
        finally { _busy = false; }
    }

    private async Task OnStatusChangeAsync(ChangeEventArgs e)
    {
        if (_ticket is null || !Guid.TryParse(e.Value?.ToString(), out var statusId)) return;
        _busy = true; _actionError = null;
        try
        {
            await TicketApi.ChangeStatusAsync(_ticket.Id, new ChangeTicketStatusRequest(statusId));
            await LoadAsync();
        }
        catch { _actionError = "Impossible de changer le statut."; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (_ticket is null) return;
        _busy = true; _actionError = null;
        try
        {
            var projectId = _ticket.ProjectId;
            await TicketApi.DeleteAsync(_ticket.Id);
            Nav.NavigateTo($"/projects/{projectId}");
        }
        catch { _actionError = "Impossible de supprimer ce ticket."; _busy = false; }
    }

    private static string PriorityClass(CardPriority priority) => priority switch
    {
        CardPriority.Low      => "badge-prio-low",
        CardPriority.Medium   => "badge-prio-medium",
        CardPriority.High     => "badge-prio-high",
        CardPriority.Critical => "badge-prio-critical",
        _                     => "badge-gray"
    };

    private async Task AddCommentAsync()
    {
        if (_ticket is null || string.IsNullOrWhiteSpace(_newCommentContent)) return;
        try
        {
            var comment = await CommentApi.CreateForTicketAsync(_ticket.Id, new CreateCommentRequest(_newCommentContent));
            if (comment is not null) _comments = [.. _comments, comment];
            _newCommentContent = string.Empty;
        }
        catch { }
    }

    private void StartEditComment(CommentDto c)
    {
        _editingCommentId   = c.Id;
        _editCommentContent = c.Content;
    }

    private async Task SaveCommentEditAsync(Guid commentId)
    {
        try
        {
            var updated = await CommentApi.UpdateAsync(commentId, new UpdateCommentRequest(_editCommentContent));
            if (updated is not null)
                _comments = _comments.Select(c => c.Id == commentId ? updated : c).ToList().AsReadOnly();
            _editingCommentId = null;
        }
        catch { }
    }

    private async Task DeleteCommentAsync(Guid commentId)
    {
        try
        {
            await CommentApi.DeleteAsync(commentId);
            _comments = _comments.Where(c => c.Id != commentId).ToList().AsReadOnly();
        }
        catch { }
    }
}
