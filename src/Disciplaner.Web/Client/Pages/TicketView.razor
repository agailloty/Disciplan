@page "/tickets/{Id:guid}"
@page "/tickets/{Ref}"
@attribute [Authorize]
@inject TicketApiClient TicketApi
@inject ProjectApiClient ProjectApi
@inject CommentApiClient CommentApi
@inject NavigationManager Nav

<PageTitle>@(_ticket?.TicketRef ?? "Ticket") — Disciplaner</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_ticket is not null)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/projects">Projets</a></li>
            <li class="breadcrumb-item"><a href="/projects/@_ticket.ProjectId">@_ticket.ProjectKey</a></li>
            <li class="breadcrumb-item active" aria-current="page">@_ticket.TicketRef</li>
        </ol>
    </nav>

    <div class="card shadow-sm mx-auto" style="max-width:860px">
        <div class="card-header bg-white d-flex flex-wrap align-items-center gap-2">
            <span class="badge bg-dark">@_ticket.TicketRef</span>
            <h1 class="h5 mb-0 flex-grow-1">@_ticket.Title</h1>
            <span class="badge bg-light text-dark border">@_ticket.Type</span>
            <span class="badge @PriorityClass(_ticket.Priority)">@_ticket.Priority</span>
        </div>

        <div class="card-body">
            @if (_editing)
            {
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Titre</label>
                        <InputText class="form-control" @bind-Value="_form.Title" />
                        <ValidationMessage For="() => _form.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" rows="5" @bind-Value="_form.Description" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Type</label>
                            <InputSelect class="form-select" @bind-Value="_form.Type">
                                @foreach (var type in Enum.GetValues<TicketType>())
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Priorité</label>
                            <InputSelect class="form-select" @bind-Value="_form.Priority">
                                @foreach (var priority in Enum.GetValues<CardPriority>())
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Story points</label>
                            <InputNumber class="form-control" @bind-Value="_form.StoryPoints" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Échéance</label>
                            <InputDate class="form-control" @bind-Value="_form.DueDate" />
                        </div>
                    </div>
                    @if (_actionError is not null)
                    {
                        <div class="alert alert-danger py-1 small mt-3">@_actionError</div>
                    }
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => _editing = false" disabled="@_busy">Annuler</button>
                        <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "…" : "Enregistrer")</button>
                    </div>
                </EditForm>
            }
            else
            {
                @* Status selector *@
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="status-dot flex-shrink-0" style="background:@_ticket.Status.Color"></span>
                    @if (_statuses.Count > 0)
                    {
                        <select class="form-select form-select-sm ticket-status-select"
                                value="@_ticket.Status.Id"
                                @onchange="OnStatusChangeAsync"
                                disabled="@_busy">
                            @foreach (var s in _statuses.OrderBy(s => s.Order))
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        <span class="badge bg-light text-dark border">@_ticket.Status.Name</span>
                    }
                </div>

                @* Description *@
                @if (!string.IsNullOrWhiteSpace(_ticket.Description))
                {
                    <div class="mb-3">
                        <p class="form-label fw-semibold text-muted small text-uppercase mb-1">Description</p>
                        <div class="card-detail-description">@_ticket.Description</div>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic small mb-3">Aucune description.</p>
                }

                @* Meta *@
                <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                    @if (_ticket.StoryPoints.HasValue)
                    {
                        <span><i class="bi bi-stars me-1"></i>@_ticket.StoryPoints pts</span>
                    }
                    @if (_ticket.DueDate.HasValue)
                    {
                        var overdue = _ticket.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                        <span class="@(overdue ? "text-danger fw-semibold" : string.Empty)">
                            <i class="bi bi-calendar3 me-1"></i>@_ticket.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")
                            @(overdue ? " — en retard" : string.Empty)
                        </span>
                    }
                    @if (_ticket.SprintName is not null)
                    {
                        <span><i class="bi bi-lightning me-1"></i>@_ticket.SprintName</span>
                    }
                    @if (_ticket.ParentTicketRef is not null)
                    {
                        <span><i class="bi bi-diagram-3 me-1"></i>Parent : @_ticket.ParentTicketRef</span>
                    }
                </div>

                <div class="text-muted small border-top pt-2 d-flex gap-3 flex-wrap">
                    <span>Créé le @_ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    @if (_ticket.UpdatedAt.HasValue)
                    {
                        <span>Modifié le @_ticket.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </div>

                @* Comments *@
                <div class="mt-4">
                    <p class="fw-semibold text-muted small text-uppercase mb-2"><i class="bi bi-chat-left-text me-1"></i>Commentaires</p>
                    @if (_commentsLoading)
                    {
                        <p class="text-muted small">Chargement…</p>
                    }
                    else
                    {
                        @foreach (var c in _comments)
                        {
                            <div class="d-flex gap-2 mb-3">
                                <div class="flex-shrink-0 rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:30px;height:30px;font-size:.75rem">
                                    @(c.AuthorName.Length > 0 ? c.AuthorName[0].ToString().ToUpper() : "?")
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex gap-2 align-items-baseline mb-1">
                                        <span class="fw-semibold small">@c.AuthorName</span>
                                        <span class="text-muted" style="font-size:.72rem">@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (_editingCommentId == c.Id)
                                    {
                                        <textarea class="form-control form-control-sm" rows="2" @bind="_editCommentContent"></textarea>
                                        <div class="d-flex gap-1 mt-1">
                                            <button class="btn btn-sm btn-primary py-0" @onclick="() => SaveCommentEditAsync(c.Id)">Sauvegarder</button>
                                            <button class="btn btn-sm btn-secondary py-0" @onclick="() => _editingCommentId = null">Annuler</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small">@c.Content</div>
                                        <div class="d-flex gap-2 mt-1">
                                            <button class="btn btn-link btn-sm p-0 text-muted" style="font-size:.72rem" @onclick="() => StartEditComment(c)">Modifier</button>
                                            <button class="btn btn-link btn-sm p-0 text-danger" style="font-size:.72rem" @onclick="() => DeleteCommentAsync(c.Id)">Supprimer</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="d-flex gap-2 mt-2">
                            <div class="flex-grow-1">
                                <textarea class="form-control form-control-sm" rows="2" placeholder="Ajouter un commentaire…" @bind="_newCommentContent"></textarea>
                            </div>
                            <button class="btn btn-sm btn-primary align-self-end" @onclick="AddCommentAsync" disabled="@(string.IsNullOrWhiteSpace(_newCommentContent))">
                                <i class="bi bi-send"></i>
                            </button>
                        </div>
                    }
                </div>

                @if (_actionError is not null)
                {
                    <div class="alert alert-danger py-1 small mt-2">@_actionError</div>
                }
            }
        </div>

        @if (!_editing)
        {
            <div class="card-footer bg-transparent d-flex justify-content-end gap-2">
                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteAsync" disabled="@_busy">
                    <i class="bi bi-trash me-1"></i>Supprimer
                </button>
                <button class="btn btn-sm btn-primary" @onclick="EnterEdit">
                    <i class="bi bi-pencil me-1"></i>Modifier
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Ref { get; set; }

    private TicketDto? _ticket;
    private readonly List<TicketStatusDto> _statuses = [];
    private bool _loading = true;
    private bool _busy;
    private bool _editing;
    private string? _error;
    private string? _actionError;
    private TicketEditForm _form = new();

    // Comments
    private IReadOnlyList<CommentDto> _comments = [];
    private bool _commentsLoading;
    private string _newCommentContent = string.Empty;
    private Guid? _editingCommentId;
    private string _editCommentContent = string.Empty;

    private sealed class TicketEditForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public TicketType Type { get; set; } = TicketType.Story;
        public CardPriority Priority { get; set; } = CardPriority.Medium;
        public int? StoryPoints { get; set; }
        public DateTime? DueDate { get; set; }
    }

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            if (Id != Guid.Empty)
            {
                _ticket = await TicketApi.GetByIdAsync(Id);
            }
            else if (!string.IsNullOrEmpty(Ref))
            {
                var parts = Ref.Split('-');
                if (parts.Length >= 2 && int.TryParse(parts[^1], out var num))
                {
                    var key = string.Join('-', parts[..^1]);
                    _ticket = await TicketApi.GetByRefAsync(key, num);
                }
                else
                {
                    _error = $"Référence invalide : {Ref}";
                    return;
                }
            }

            if (_ticket is not null)
            {
                var project = await ProjectApi.GetProjectAsync(_ticket.ProjectId);
                _statuses.Clear();
                if (project is not null)
                    _statuses.AddRange(project.Statuses);

                _commentsLoading = true;
                try { _comments = await CommentApi.GetByTicketAsync(_ticket.Id); }
                catch { _comments = []; }
                finally { _commentsLoading = false; }
            }
            else if (_error is null)
            {
                _error = "Ticket introuvable.";
            }
        }
        catch { _error = "Impossible de charger ce ticket."; }
        finally { _loading = false; }
    }

    private void EnterEdit()
    {
        if (_ticket is null) return;
        _form = new()
        {
            Title       = _ticket.Title,
            Description = _ticket.Description,
            Type        = _ticket.Type,
            Priority    = _ticket.Priority,
            StoryPoints = _ticket.StoryPoints,
            DueDate     = _ticket.DueDate
        };
        _actionError = null;
        _editing     = true;
    }

    private async Task SaveAsync()
    {
        if (_ticket is null) return;
        _busy = true; _actionError = null;
        try
        {
            await TicketApi.UpdateAsync(_ticket.Id, new UpdateTicketRequest(
                _form.Title, _form.Description, _form.Type, _form.Priority,
                _form.StoryPoints, _form.DueDate, _ticket.AssigneeId));
            _editing = false;
            await LoadAsync();
        }
        catch { _actionError = "La mise à jour a échoué."; }
        finally { _busy = false; }
    }

    private async Task OnStatusChangeAsync(ChangeEventArgs e)
    {
        if (_ticket is null || !Guid.TryParse(e.Value?.ToString(), out var statusId)) return;
        _busy = true; _actionError = null;
        try
        {
            await TicketApi.ChangeStatusAsync(_ticket.Id, new ChangeTicketStatusRequest(statusId));
            await LoadAsync();
        }
        catch { _actionError = "Impossible de changer le statut."; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (_ticket is null) return;
        _busy = true; _actionError = null;
        try
        {
            var projectId = _ticket.ProjectId;
            await TicketApi.DeleteAsync(_ticket.Id);
            Nav.NavigateTo($"/projects/{projectId}");
        }
        catch { _actionError = "Impossible de supprimer ce ticket."; _busy = false; }
    }

    private static string PriorityClass(CardPriority priority) => priority switch
    {
        CardPriority.Low      => "bg-secondary",
        CardPriority.Medium   => "bg-info text-dark",
        CardPriority.High     => "bg-warning text-dark",
        CardPriority.Critical => "bg-danger",
        _                     => "bg-secondary"
    };

    private async Task AddCommentAsync()
    {
        if (_ticket is null || string.IsNullOrWhiteSpace(_newCommentContent)) return;
        try
        {
            var comment = await CommentApi.CreateForTicketAsync(_ticket.Id, new CreateCommentRequest(_newCommentContent));
            if (comment is not null) _comments = [.. _comments, comment];
            _newCommentContent = string.Empty;
        }
        catch { }
    }

    private void StartEditComment(CommentDto c)
    {
        _editingCommentId   = c.Id;
        _editCommentContent = c.Content;
    }

    private async Task SaveCommentEditAsync(Guid commentId)
    {
        try
        {
            var updated = await CommentApi.UpdateAsync(commentId, new UpdateCommentRequest(_editCommentContent));
            if (updated is not null)
                _comments = _comments.Select(c => c.Id == commentId ? updated : c).ToList().AsReadOnly();
            _editingCommentId = null;
        }
        catch { }
    }

    private async Task DeleteCommentAsync(Guid commentId)
    {
        try
        {
            await CommentApi.DeleteAsync(commentId);
            _comments = _comments.Where(c => c.Id != commentId).ToList().AsReadOnly();
        }
        catch { }
    }
}
