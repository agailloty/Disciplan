@page "/tickets/{Id:guid}"
@page "/tickets/{Ref}"
@attribute [Authorize]
@inject TicketApiClient TicketApi
@inject ProjectApiClient ProjectApi
@inject CommentApiClient CommentApi
@inject UserApiClient UserApi
@inject SprintApiClient SprintApi
@inject LabelApiClient LabelApi
@inject ActivityApiClient ActivityApi
@inject NavigationManager Nav
@inject IStringLocalizer<AppResources> L
@inject AttachmentApiClient AttachmentApi
@inject IJSRuntime JS
@using Disciplaner.Application.DTOs.User
@using Disciplaner.Application.DTOs.Sprint
@using Disciplaner.Application.DTOs.Activity

<PageTitle>@(_ticket?.TicketRef ?? L["Title"].Value) — Disciplaner</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_ticket is not null)
{
    <div class="ticket-page">
    <nav aria-label="breadcrumb" class="ticket-breadcrumb">
        <ol class="flex items-center gap-1 text-sm" style="color:var(--text-muted)">
            <li><a href="/projects" class="hover:underline" style="color:var(--text-muted)">@L["Nav.Projects"]</a></li>
            <li style="color:var(--border)"> / </li>
            <li><a href="/projects/@_ticket.ProjectId" class="hover:underline" style="color:var(--text-muted)">@_ticket.ProjectKey</a></li>
            <li style="color:var(--border)"> / </li>
            <li style="color:var(--text-base)">@_ticket.TicketRef</li>
        </ol>
    </nav>

    <div class="ticket-page-body">

        <EditForm Model="_form" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        @* ── Ticket header ── *@
        <div class="px-6 pt-5 pb-4 relative" style="border-bottom:1px solid var(--border)">
            <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
                <span class="font-mono text-xs font-semibold tracking-wide" style="color:var(--text-muted)">@_ticket.TicketRef</span>
                <span class="tdm-type-badge">@_ticket.Type</span>
                <span class="badge @PriorityClass(_ticket.Priority)">@_ticket.Priority</span>
            </div>
            @if (_editing)
            {
                <InputText class="form-input text-base font-semibold" @bind-Value="_form.Title" />
                <ValidationMessage For="() => _form.Title" />
            }
            else
            {
                <h1 class="text-lg font-semibold leading-snug pr-10" style="color:var(--text-base)">@_ticket.Title</h1>
                <button type="button" class="modal-close-btn absolute top-4 right-4" title="@L["Edit"]" @onclick="EnterEdit">
                    <i class="bi bi-pencil"></i>
                </button>
            }
        </div>

        @* ── Two-column layout (shared by view and edit modes) ── *@
        <div class="flex flex-col lg:flex-row gap-6 px-6 py-5">

            @* ── Main column ── *@
            <div class="flex-1 min-w-0 flex flex-col gap-6">

                @if (_editing)
                {
                    @* Edit fields *@
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="form-label">@L["Type"]</label>
                            <div class="tdm-select-wrap">
                                <InputSelect class="tdm-select" @bind-Value="_form.Type">
                                    @foreach (var type in Enum.GetValues<TicketType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div>
                            <label class="form-label">@L["Priority"]</label>
                            <div class="tdm-select-wrap">
                                <InputSelect class="tdm-select" @bind-Value="_form.Priority">
                                    @foreach (var priority in Enum.GetValues<CardPriority>())
                                    {
                                        <option value="@priority">@priority</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="form-label">@L["Description"]</label>
                        <InputTextArea class="form-textarea" rows="8" @bind-Value="_form.Description" />
                    </div>

                    @* Attachments in edit mode *@
                    <AttachmentPanel TicketId="_ticket.Id" />

                    @if (_actionError is not null)
                    {
                        <ErrorAlert Message="@_actionError" />
                    }
                }
                else
                {
                    @* Description view *@
                    <div>
                        <span class="tdm-section-label mb-2">@L["Description"]</span>
                        @if (!string.IsNullOrWhiteSpace(_ticket.Description))
                        {
                            <div class="tdm-description">@_ticket.Description</div>
                        }
                        else
                        {
                            <p class="text-sm italic py-1" style="color:var(--text-muted)">@L["Ticket.NoDescription"]</p>
                        }
                    </div>

                    @* ── Onglets Commentaires / Activité ── *@
                    <div>
                        @* Tab bar *@
                        <div class="flex gap-0 mb-4" style="border-bottom:1px solid var(--border)">
                            <button type="button"
                                    class="px-4 py-2 text-sm font-medium transition-colors"
                                    style="@(_activeTab == "comments" ? "border-bottom:2px solid var(--accent);color:var(--accent)" : "color:var(--text-muted)")"
                                    @onclick='() => SetTab("comments")'>
                                <span class="flex items-center gap-2">
                                    @L["Ticket.Comments"]
                                    @if (_comments.Count > 0)
                                    {
                                        <span class="inline-flex items-center justify-center w-4 h-4 rounded-full text-xs font-semibold" style="background:var(--bg-accent);color:var(--text-muted)">@_comments.Count</span>
                                    }
                                </span>
                            </button>
                            <button type="button"
                                    class="px-4 py-2 text-sm font-medium transition-colors"
                                    style="@(_activeTab == "history" ? "border-bottom:2px solid var(--accent);color:var(--accent)" : "color:var(--text-muted)")"
                                    @onclick='() => SetTab("history")'>
                                @L["Ticket.History"]
                            </button>
                        </div>

                        @* Tab: Comments *@
                        @if (_activeTab == "comments")
                        {
                            @if (_commentsLoading)
                            {
                                <p class="text-sm py-2" style="color:var(--text-muted)">@L["Loading"]</p>
                            }
                            else
                            {
                                @if (_comments.Count > 0)
                                {
                                    <div class="flex flex-col gap-3 mb-4">
                                        @foreach (var c in _comments)
                                        {
                                            <div class="tdm-comment-row group">
                                                <div class="tdm-avatar @AvatarColor(c.AuthorName)">
                                                    @(c.AuthorName.Length > 0 ? c.AuthorName[0].ToString().ToUpper() : "?")
                                                </div>
                                                <div class="tdm-comment-body">
                                                    <div class="tdm-comment-header">
                                                        <span class="tdm-comment-author">@c.AuthorName</span>
                                                        <span class="tdm-comment-date">@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                                    </div>
                                                    @if (_editingCommentId == c.Id)
                                                    {
                                                        <textarea class="form-textarea text-sm" rows="2" @bind="_editCommentContent"></textarea>
                                                        <div class="mt-1.5 pl-0.5">
                                                            <AttachmentPanel CommentId="c.Id" />
                                                        </div>
                                                        <div class="flex gap-1.5 mt-1.5">
                                                            <button class="btn btn-primary btn-sm" type="button" @onclick="() => SaveCommentEditAsync(c.Id)">@L["Ticket.Comment.Save"]</button>
                                                            <button class="btn btn-outline btn-sm" type="button" @onclick="() => _editingCommentId = null">@L["Cancel"]</button>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="tdm-comment-bubble">@c.Content</div>
                                                        <div class="mt-1.5 pl-0.5">
                                                            <AttachmentPanel CommentId="c.Id" CanAdd="false" />
                                                        </div>
                                                        <div class="tdm-comment-actions">
                                                            <button class="text-xs transition-colors" style="color:var(--text-muted)" type="button" @onclick="() => StartEditComment(c)">@L["Ticket.Comment.Edit"]</button>
                                                            <button class="text-xs text-red-400 hover:text-red-600 transition-colors" type="button" @onclick="() => DeleteCommentAsync(c.Id)">@L["Ticket.Comment.Delete"]</button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @* Add comment *@
                            }
                        }

                        @* Tab: History *@
                        @if (_activeTab == "history")
                        {
                            @if (_historyLoading)
                            {
                                <p class="text-sm py-2" style="color:var(--text-muted)">@L["Loading"]</p>
                            }
                            else if (_history.Count == 0)
                            {
                                <p class="text-sm italic py-2" style="color:var(--text-muted)">@L["Ticket.History.Empty"]</p>
                            }
                            else
                            {
                                <div class="flex flex-col gap-3">
                                    @foreach (var entry in _history)
                                    {
                                        var h = entry;
                                        <div class="flex items-start gap-3">
                                            <span class="mt-1 w-2.5 h-2.5 rounded-full @HistoryDotColor(h.Kind) shrink-0"></span>
                                            <div class="flex-1 min-w-0">
                                                <div class="flex flex-wrap items-baseline gap-y-0.5">
                                                    <span class="text-xs font-semibold" style="color:var(--text-base);margin-right:0.3rem">@h.ActorName</span>
                                                    <span class="text-xs" style="color:var(--text-muted)">@HistoryLabel(h)</span>
                                                    <span class="ml-auto text-xs shrink-0" style="color:var(--text-muted)">@h.OccurredAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                                </div>
                                                @if (HistoryDetail(h) is { } detail)
                                                {
                                                    <div class="mt-0.5 text-xs rounded px-2 py-1 break-words" style="color:var(--text-muted);background:var(--surface)">@detail</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    @* ── Pièces jointes du ticket ── *@
                    <AttachmentPanel TicketId="_ticket.Id" />

                    @if (_actionError is not null)
                    {
                        <ErrorAlert Message="@_actionError" />
                    }
                }
            </div>

            @* ── Sidebar ── *@
            <div class="lg:w-56 shrink-0">

                @* Status *@
                <div class="tdm-prop">
                    <span class="tdm-sidebar-label">@L["Status"]</span>
                    @if (_statuses.Count > 0)
                    {
                        <div class="tdm-select-wrap">
                            <span class="tdm-status-dot" style="background:@_ticket.Status.Color"></span>
                            <select class="tdm-select tdm-select-with-dot"
                                    value="@_ticket.Status.Id"
                                    @onchange="OnStatusChangeAsync"
                                    disabled="@_busy">
                                @foreach (var s in _statuses.OrderBy(s => s.Order))
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <span class="badge badge-gray">@_ticket.Status.Name</span>
                    }
                </div>

                @* Assignee *@
                <div class="tdm-prop">
                    <span class="tdm-sidebar-label">@L["Ticket.Assignee"]</span>
                    <div class="tdm-select-wrap">
                        <select class="tdm-select"
                                value="@(_ticket.AssigneeId ?? string.Empty)"
                                @onchange="OnAssigneeChangeAsync"
                                disabled="@_busy">
                            <option value="">@L["Ticket.NoAssignee"]</option>
                            @foreach (var u in _users)
                            {
                                <option value="@u.Id">@u.DisplayName</option>
                            }
                        </select>
                    </div>
                </div>

                @* Sprint *@
                @if (_sprints.Count > 0)
                {
                    <div class="tdm-prop">
                        <span class="tdm-sidebar-label">@L["Sprint.Label"]</span>
                        <div class="tdm-select-wrap">
                            <select class="tdm-select"
                                    value="@(_ticket.SprintId?.ToString() ?? string.Empty)"
                                    @onchange="OnSprintChangeAsync"
                                    disabled="@_busy">
                                <option value="">@L["Ticket.BacklogOption"]</option>
                                @foreach (var s in _sprints)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                }

                <div class="my-3" style="border-top:1px solid var(--border)"></div>

                @* Story points and due date: input when editing, display when viewing *@
                @if (_editing)
                {
                    <div class="tdm-prop">
                        <span class="tdm-sidebar-label">@L["Ticket.StoryPoints"]</span>
                        <InputNumber class="form-input text-sm" @bind-Value="_form.StoryPoints" />
                    </div>
                    <div class="tdm-prop">
                        <span class="tdm-sidebar-label">@L["Ticket.DueDate"]</span>
                        <InputDate class="form-input text-sm" @bind-Value="_form.DueDate" />
                    </div>
                }
                else
                {
                    @if (_ticket.StoryPoints.HasValue)
                    {
                        <div class="tdm-meta-row">
                            <i class="bi bi-stars tdm-meta-icon"></i>
                            <span class="tdm-meta-label">@L["Ticket.StoryPoints"]</span>
                            <span class="tdm-meta-value">@_ticket.StoryPoints pts</span>
                        </div>
                    }
                    @if (_ticket.DueDate.HasValue)
                    {
                        var overdue = _ticket.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                        <div class="tdm-meta-row">
                            <i class="bi bi-calendar3 tdm-meta-icon @(overdue ? "text-red-500" : "")"></i>
                            <span class="tdm-meta-label">@L["Ticket.DueDate"]</span>
                            <span class="tdm-meta-value @(overdue ? "font-semibold text-red-600" : "")">@_ticket.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                    @if (_ticket.ParentTicketRef is not null)
                    {
                        <div class="tdm-meta-row">
                            <i class="bi bi-diagram-3 tdm-meta-icon"></i>
                            <span class="tdm-meta-label">@L["Ticket.ParentLabel"]</span>
                            <span class="tdm-meta-value font-mono">@_ticket.ParentTicketRef</span>
                        </div>
                    }
                }

                <div class="my-3" style="border-top:1px solid var(--border)"></div>

                @* Labels *@
                <div class="tdm-prop">
                    <span class="tdm-sidebar-label">@L["Label.Field"]</span>
                    <LabelPicker SelectedLabels="_labels" Editable="true"
                                 OnAttach="async l => { await LabelApi.AttachToTicketAsync(l.Id, _ticket!.Id); }"
                                 OnDetach="async l => { await LabelApi.DetachFromTicketAsync(l.Id, _ticket!.Id); }" />
                </div>

                <div class="my-3" style="border-top:1px solid var(--border)"></div>

                @* Reporter + timestamps (always visible) *@
                <div class="tdm-meta-row">
                    <i class="bi bi-person tdm-meta-icon"></i>
                    <span class="tdm-meta-label">@L["Ticket.Reporter"]</span>
                    <span class="tdm-meta-value">@_ticket.ReporterName</span>
                </div>
                <div class="tdm-meta-row">
                    <i class="bi bi-clock-history tdm-meta-icon"></i>
                    <span class="tdm-meta-label">@L["Created"]</span>
                    <span class="tdm-meta-value">@_ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                </div>
                @if (_ticket.UpdatedAt.HasValue)
                {
                    <div class="tdm-meta-row">
                        <i class="bi bi-pencil-square tdm-meta-icon"></i>
                        <span class="tdm-meta-label">@L["Updated"]</span>
                        <span class="tdm-meta-value">@_ticket.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
        </div>

        @* ── Footer (edit mode) ── *@
        @if (_editing)
        {
            <div class="flex justify-end gap-2 px-6 py-4" style="border-top:1px solid var(--border)">
                <button type="button" class="btn btn-outline" @onclick="() => _editing = false" disabled="@_busy">@L["Cancel"]</button>
                <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "…" : L["Save"].Value)</button>
            </div>
        }
        </EditForm>
    </div>

    @* ── Sticky comment bar ── *@
    @if (!_editing && _activeTab == "comments")
    {
        <div class="ticket-comment-bar">
            <div class="flex gap-2.5 items-start">
                <div class="tdm-avatar av-gray shrink-0">
                    <i class="bi bi-person" style="font-size:.8rem"></i>
                </div>
                <div class="flex-1">
                    <textarea class="form-textarea text-sm"
                              rows="2"
                              placeholder="@L["Ticket.Comment.Add"]"
                              @bind="_newCommentContent"
                              @bind:event="oninput"></textarea>

                    @* Pending files chips *@
                    @if (_pendingCommentFiles.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1.5 mt-1.5">
                            @foreach (var f in _pendingCommentFiles)
                            {
                                var file = f;
                                <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-xs text-blue-700 max-w-[180px]">
                                    <i class="bi bi-paperclip shrink-0"></i>
                                    <span class="truncate">@file.Name</span>
                                    <button type="button" class="ml-0.5 text-blue-400 hover:text-red-500 shrink-0"
                                            @onclick="() => _pendingCommentFiles.Remove(file)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </span>
                            }
                        </div>
                    }

                    <div class="flex items-center justify-between mt-1.5">
                        <label class="inline-flex items-center gap-1 text-xs cursor-pointer select-none px-2 py-1 rounded hover:bg-gray-100 transition-colors"
                               style="color:var(--text-muted)"
                               title="@L["Attachment.AttachFiles"]">
                            <i class="bi bi-paperclip text-sm"></i>@L["Attachment.Attach"]
                            <InputFile OnChange="HandlePendingCommentFilesAsync" class="hidden" multiple
                                       accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip" />
                        </label>
                        <button class="btn btn-primary btn-sm" type="button"
                                @onclick="AddCommentAsync"
                                disabled="@(string.IsNullOrWhiteSpace(_newCommentContent) && _pendingCommentFiles.Count == 0)">
                            <i class="bi bi-send-fill mr-1"></i>@L["Ticket.Comment.Submit"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Ref { get; set; }

    private TicketDto? _ticket;
    private List<LabelDto> _labels = [];
    private readonly List<TicketStatusDto> _statuses = [];
    private List<UserSummaryDto> _users = [];
    private List<SprintDto> _sprints = [];
    private bool _loading = true;
    private bool _busy;
    private bool _editing;
    private string? _error;
    private string? _actionError;
    private TicketEditForm _form = new();

    // Tabs
    private string _activeTab = "comments";

    // Comments
    private IReadOnlyList<CommentDto> _comments = [];
    private bool _commentsLoading;

    // History
    private IReadOnlyList<TicketHistoryEntryDto> _history = [];
    private bool _historyLoading;
    private string _newCommentContent = string.Empty;
    private Guid? _editingCommentId;
    private string _editCommentContent = string.Empty;
    private List<IBrowserFile> _pendingCommentFiles = [];

    private sealed class TicketEditForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public TicketType Type { get; set; } = TicketType.Story;
        public CardPriority Priority { get; set; } = CardPriority.Medium;
        public int? StoryPoints { get; set; }
        public DateTime? DueDate { get; set; }
    }

    protected override async Task OnParametersSetAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        try
        {
            if (Id != Guid.Empty)
            {
                _ticket = await TicketApi.GetByIdAsync(Id);
            }
            else if (!string.IsNullOrEmpty(Ref))
            {
                var parts = Ref.Split('-');
                if (parts.Length >= 2 && int.TryParse(parts[^1], out var num))
                {
                    var key = string.Join('-', parts[..^1]);
                    _ticket = await TicketApi.GetByRefAsync(key, num);
                }
                else
                {
                    _error = $"Référence invalide : {Ref}";
                    return;
                }
            }

            if (_ticket is not null)
            {
                _labels = _ticket.Labels.ToList();
                var project = await ProjectApi.GetProjectAsync(_ticket.ProjectId);
                _statuses.Clear();
                if (project is not null)
                    _statuses.AddRange(project.Statuses);

                // Load users and sprints in parallel
                var usersTask   = UserApi.GetAllAsync();
                var sprintsTask = SprintApi.GetByProjectAsync(_ticket.ProjectId);
                await Task.WhenAll(usersTask, sprintsTask);
                _users   = usersTask.Result   ?? [];
                _sprints = sprintsTask.Result ?? [];

                _commentsLoading = true;
                try { _comments = await CommentApi.GetByTicketAsync(_ticket.Id); }
                catch { _comments = []; }
                finally { _commentsLoading = false; }

                // Preload history silently
                _ = LoadHistoryAsync(_ticket.Id);
            }
            else if (_error is null)
            {
                _error = L["Ticket.NotFound"];
            }
        }
        catch { _error = L["Error.Load"]; }
        finally { _loading = false; }
    }

    private async Task LoadHistoryAsync(Guid ticketId)
    {
        _historyLoading = true;
        StateHasChanged();
        try { _history = await ActivityApi.GetTicketHistoryAsync(ticketId) ?? []; }
        catch { _history = []; }
        finally { _historyLoading = false; StateHasChanged(); }
    }

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        if (tab == "history" && _history.Count == 0 && !_historyLoading && _ticket is not null)
            await LoadHistoryAsync(_ticket.Id);
    }

    private static string HistoryDotColor(string kind) => kind switch
    {
        "created" => "bg-green-400",
        "comment_added" or "comment_deleted" => "bg-blue-400",
        "status_changed" => "bg-purple-400",
        _ => "bg-gray-300"
    };

    private string HistoryLabel(TicketHistoryEntryDto h) => h.Kind switch
    {
        "created" => L["History.created"],
        "title_changed" => L["History.title_changed"],
        "description_changed" => L["History.description_changed"],
        "status_changed" => L["History.status_changed"],
        "type_changed" => L["History.type_changed"],
        "priority_changed" => L["History.priority_changed"],
        "assignee_changed" => L["History.assignee_changed"],
        "sprint_changed" => L["History.sprint_changed"],
        "story_points_changed" => L["History.story_points_changed"],
        "due_date_changed" => L["History.due_date_changed"],
        "comment_added" => L["History.comment_added"],
        "comment_deleted" => L["History.comment_deleted"],
        _ => h.Kind
    };

    private static string? HistoryDetail(TicketHistoryEntryDto h) => h.Kind switch
    {
        "created" => null,
        "comment_added" => h.NewValue is { Length: > 0 } v ? $"« {v} »" : null,
        "comment_deleted" => h.OldValue is { Length: > 0 } v ? $"« {v} »" : null,
        _ when h.OldValue is not null && h.NewValue is not null => $"{h.OldValue} → {h.NewValue}",
        _ when h.NewValue is not null => h.NewValue,
        _ => null
    };

    private void EnterEdit()
    {
        if (_ticket is null) return;
        _form = new()
        {
            Title       = _ticket.Title,
            Description = _ticket.Description,
            Type        = _ticket.Type,
            Priority    = _ticket.Priority,
            StoryPoints = _ticket.StoryPoints,
            DueDate     = _ticket.DueDate
        };
        _actionError = null;
        _editing     = true;
    }

    private async Task SaveAsync()
    {
        if (_ticket is null) return;
        _busy = true; _actionError = null;
        try
        {
            await TicketApi.UpdateAsync(_ticket.Id, new UpdateTicketRequest(
                _form.Title, _form.Description, _form.Type, _form.Priority,
                _form.StoryPoints, _form.DueDate, _ticket.AssigneeId));
            _editing = false;
            await LoadAsync();
        }
        catch { _actionError = L["Error.Update"]; }
        finally { _busy = false; }
    }

    private async Task OnStatusChangeAsync(ChangeEventArgs e)
    {
        if (_ticket is null || !Guid.TryParse(e.Value?.ToString(), out var statusId)) return;
        _busy = true; _actionError = null;
        try
        {
            await TicketApi.ChangeStatusAsync(_ticket.Id, new ChangeTicketStatusRequest(statusId));
            await LoadAsync();
        }
        catch { _actionError = L["Error.Update"]; }
        finally { _busy = false; }
    }

    private async Task OnAssigneeChangeAsync(ChangeEventArgs e)
    {
        if (_ticket is null) return;
        _busy = true; _actionError = null;
        try
        {
            var raw        = e.Value?.ToString();
            var assigneeId = string.IsNullOrEmpty(raw) ? null : raw;
            await TicketApi.UpdateAsync(_ticket.Id, new UpdateTicketRequest(
                _ticket.Title, _ticket.Description, _ticket.Type, _ticket.Priority,
                _ticket.StoryPoints, _ticket.DueDate, assigneeId));
            await LoadAsync();
        }
        catch { _actionError = L["Error.Update"]; }
        finally { _busy = false; }
    }

    private async Task OnSprintChangeAsync(ChangeEventArgs e)
    {
        if (_ticket is null) return;
        _busy = true; _actionError = null;
        try
        {
            var raw      = e.Value?.ToString();
            var sprintId = string.IsNullOrEmpty(raw) ? (Guid?)null : Guid.Parse(raw);
            await TicketApi.MoveToSprintAsync(_ticket.Id, new MoveTicketToSprintRequest(sprintId));
            await LoadAsync();
        }
        catch { _actionError = L["Error.Update"]; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (_ticket is null) return;
        _busy = true; _actionError = null;
        try
        {
            var projectId = _ticket.ProjectId;
            await TicketApi.DeleteAsync(_ticket.Id);
            Nav.NavigateTo($"/projects/{projectId}");
        }
        catch { _actionError = L["Error.Delete"]; _busy = false; }
    }

    private static string PriorityClass(CardPriority priority) => priority switch
    {
        CardPriority.Low      => "badge-prio-low",
        CardPriority.Medium   => "badge-prio-medium",
        CardPriority.High     => "badge-prio-high",
        CardPriority.Critical => "badge-prio-critical",
        _                     => "badge-gray"
    };

    private static string AvatarColor(string name) => (name.Length > 0 ? char.ToUpper(name[0]) : '?') switch
    {
        >= 'A' and <= 'D' => "av-sky",
        >= 'E' and <= 'H' => "av-violet",
        >= 'I' and <= 'L' => "av-green",
        >= 'M' and <= 'P' => "av-amber",
        >= 'Q' and <= 'T' => "av-rose",
        _                 => "av-gray",
    };

    private async Task AddCommentAsync()
    {
        if (_ticket is null) return;
        if (string.IsNullOrWhiteSpace(_newCommentContent) && _pendingCommentFiles.Count == 0) return;
        try
        {
            var content = string.IsNullOrWhiteSpace(_newCommentContent) ? "📎" : _newCommentContent;
            var comment = await CommentApi.CreateForTicketAsync(_ticket.Id, new CreateCommentRequest(content));
            if (comment is not null)
            {
                _comments = [.. _comments, comment];
                // Upload pending files to the new comment
                foreach (var file in _pendingCommentFiles)
                {
                    try { await AttachmentApi.UploadForCommentAsync(comment.Id, file); } catch { /* ignore */ }
                }
                _pendingCommentFiles.Clear();
            }
            _newCommentContent = string.Empty;
        }
        catch { }
    }

    private void HandlePendingCommentFilesAsync(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
            _pendingCommentFiles.Add(file);
    }

    private void StartEditComment(CommentDto c)
    {
        _editingCommentId   = c.Id;
        _editCommentContent = c.Content;
    }

    private async Task SaveCommentEditAsync(Guid commentId)
    {
        try
        {
            var updated = await CommentApi.UpdateAsync(commentId, new UpdateCommentRequest(_editCommentContent));
            if (updated is not null)
                _comments = _comments.Select(c => c.Id == commentId ? updated : c).ToList().AsReadOnly();
            _editingCommentId = null;
        }
        catch { }
    }

    private async Task DeleteCommentAsync(Guid commentId)
    {
        try
        {
            await CommentApi.DeleteAsync(commentId);
            _comments = _comments.Where(c => c.Id != commentId).ToList().AsReadOnly();
        }
        catch { }
    }
}
