@page "/login"
@layout AuthLayout
@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject IStringLocalizer<AppResources> L

@if (_checking)
{
    <LoadingSpinner />
}
else
{
<div class="w-full max-w-sm mx-auto" style="margin-top:6rem">
    @* Logo *@
    <div class="text-center mb-8">
        <span style="font-size:2rem">&#9654;</span>
        <h1 class="text-xl font-semibold text-gray-900 mt-2">Disciplaner</h1>
        <p class="text-sm text-gray-500 mt-1">@L["Auth.Subtitle"]</p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-8 py-8">
        @if (_error is not null)
        {
            <div class="flex items-center gap-2 px-3 py-2 mb-5 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg">
                <i class="bi bi-exclamation-circle shrink-0"></i>
                <span>@_error</span>
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
            <DataAnnotationsValidator />

            <div class="mb-4">
                <label class="form-label">@L["Auth.Email"]</label>
                <InputText @bind-Value="_model.Email" class="form-input" type="email" autocomplete="email" />
                <ValidationMessage For="() => _model.Email" />
            </div>

            <div class="mb-6">
                <label class="form-label">@L["Auth.Password"]</label>
                <InputText @bind-Value="_model.Password" class="form-input" type="password" autocomplete="current-password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <button type="submit" class="btn btn-primary btn-full" disabled="@_loading">
                @(_loading ? L["Auth.Submitting"].Value : L["Auth.Submit"].Value)
            </button>
        </EditForm>
    </div>
</div>
}

@code {
    private sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(8)]
        public string Password { get; set; } = string.Empty;
    }

    private readonly LoginForm _model = new();
    private string? _error;
    private bool _checking = true;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        var setupRequired = await Auth.IsSetupRequiredAsync();
        if (setupRequired)
            Nav.NavigateTo("/setup", replace: true);
        _checking = false;
    }

    private async Task HandleLoginAsync()
    {
        _loading = true;
        _error = null;
        var (_, error) = await Auth.LoginAsync(new LoginRequest(_model.Email, _model.Password));
        if (error is not null)
        {
            _error = L["Auth.Error.Invalid"];
            _loading = false;
        }
        else
        {
            Nav.NavigateTo("/");
        }
    }
}
