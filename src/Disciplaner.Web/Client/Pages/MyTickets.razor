@page "/my-tickets"
@attribute [Authorize]
@inject TicketApiClient TicketApi
@inject NavigationManager Nav

@using Disciplaner.Application.DTOs.Ticket
@using Disciplaner.Domain.Enums

<PageTitle>Mes tickets — Disciplaner</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-person-check me-2"></i>Mes tickets</h1>
    <span class="badge bg-secondary">@(_tickets?.Count ?? 0) ticket(s)</span>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_tickets is not null && _tickets.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-4 d-block mb-3"></i>
        <p>Aucun ticket ne vous est assigné pour l'instant.</p>
    </div>
}
else if (_tickets is not null)
{
    @* Group by status category *@
    var groups = _tickets
        .GroupBy(t => t.Status.Category)
        .OrderBy(g => g.Key)
        .ToList();

    @foreach (var group in groups)
    {
        var g = group;
        <div class="mb-4">
            <h6 class="text-muted text-uppercase small mb-2">@CategoryLabel(g.Key)</h6>
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover table-sm align-middle mb-0 bg-white">
                    <thead class="table-light">
                        <tr>
                            <th style="width:90px">Réf.</th>
                            <th>Titre</th>
                            <th style="width:90px">Priorité</th>
                            <th style="width:130px">Statut</th>
                            <th style="width:130px">Sprint</th>
                            <th style="width:100px">Échéance</th>
                            <th style="width:80px">Projet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in g.OrderBy(t => t.CreatedAt))
                        {
                            var t = ticket;
                            <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/tickets/{t.TicketRef}"))">
                                <td><span class="badge bg-dark font-monospace">@t.TicketRef</span></td>
                                <td class="fw-semibold small">@t.Title</td>
                                <td><span class="badge @PriorityClass(t.Priority)">@t.Priority</span></td>
                                <td>
                                    <span class="d-inline-flex align-items-center gap-1">
                                        <span style="width:8px;height:8px;border-radius:50%;background:@t.Status.Color;display:inline-block;flex-shrink:0"></span>
                                        <span class="small text-muted">@t.Status.Name</span>
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @if (t.SprintName is not null)
                                    {
                                        <span><i class="bi bi-lightning me-1"></i>@t.SprintName</span>
                                    }
                                </td>
                                <td>
                                    @if (t.DueDate.HasValue)
                                    {
                                        var overdue = t.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                                        <span class="small @(overdue ? "text-danger fw-semibold" : "text-muted")">
                                            <i class="bi bi-calendar3 me-1"></i>@t.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@t.ProjectKey</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<TicketDto>? _tickets;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _tickets = await TicketApi.GetAssignedToMeAsync() ?? [];
        }
        catch
        {
            _error = "Impossible de charger vos tickets.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string CategoryLabel(StatusCategory c) => c switch
    {
        StatusCategory.Backlog    => "Backlog",
        StatusCategory.InProgress => "En cours",
        StatusCategory.Done       => "Terminé",
        _                         => c.ToString()
    };

    private static string PriorityClass(CardPriority p) => p switch
    {
        CardPriority.Low      => "bg-secondary",
        CardPriority.Medium   => "bg-info text-dark",
        CardPriority.High     => "bg-warning text-dark",
        CardPriority.Critical => "bg-danger",
        _                     => "bg-secondary"
    };
}
