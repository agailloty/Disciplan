@page "/my-tickets"
@attribute [Authorize]
@inject TicketApiClient TicketApi
@inject NavigationManager Nav
@inject IStringLocalizer<AppResources> L

@using Disciplaner.Application.DTOs.Ticket
@using Disciplaner.Domain.Enums

<PageTitle>@L["MyTickets.Title"] — Disciplaner</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="page-title">@L["MyTickets.Title"]</h1>
    @if (_tickets is not null)
    {
        <span class="badge badge-gray">@_tickets.Count ticket(s)</span>
    }
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_tickets is not null && _tickets.Count == 0)
{
    <div class="text-center py-20 text-gray-400">
        <i class="bi bi-inbox text-5xl block mb-3"></i>
        <p class="text-sm">@L["MyTickets.Empty"]</p>
    </div>
}
else if (_tickets is not null)
{
    var groups = _tickets.GroupBy(t => t.Status.Category).OrderBy(g => g.Key).ToList();

    @foreach (var group in groups)
    {
        var g = group;
        <div class="mb-6">
            <div class="section-label mb-2">@CategoryLabel(g.Key)</div>
            <div class="surface overflow-hidden">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 text-left">
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 w-24">@L["Col.Ref"]</th>
                            <th class="px-4 py-2 text-xs font-medium text-gray-500">@L["Col.Title"]</th>
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 w-24">@L["Col.Priority"]</th>
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 w-36">@L["Col.Status"]</th>
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 w-36">@L["Col.Sprint"]</th>
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 w-28">@L["Col.DueDate"]</th>
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 w-20">@L["Col.Project"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @foreach (var ticket in g.OrderBy(t => t.CreatedAt))
                        {
                            var t = ticket;
                            <tr class="hover:bg-gray-50 cursor-pointer transition-colors"
                                @onclick="@(() => Nav.NavigateTo($"/tickets/{t.TicketRef}"))">
                                <td class="px-4 py-2.5"><span class="badge badge-dark font-mono">@t.TicketRef</span></td>
                                <td class="px-4 py-2.5 font-medium text-gray-900">@t.Title</td>
                                <td class="px-4 py-2.5"><span class="badge @PriorityBadge(t.Priority)">@t.Priority</span></td>
                                <td class="px-4 py-2.5">
                                    <span class="flex items-center gap-1.5">
                                        <span class="w-2 h-2 rounded-full shrink-0" style="background:@t.Status.Color"></span>
                                        <span class="text-xs text-gray-600">@t.Status.Name</span>
                                    </span>
                                </td>
                                <td class="px-4 py-2.5 text-xs text-gray-500">
                                    @if (t.SprintName is not null)
                                    {
                                        <span><i class="bi bi-lightning mr-1"></i>@t.SprintName</span>
                                    }
                                </td>
                                <td class="px-4 py-2.5">
                                    @if (t.DueDate.HasValue)
                                    {
                                        var overdue = t.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                                        <span class="text-xs @(overdue ? "text-red-600 font-semibold" : "text-gray-400")">
                                            @t.DueDate.Value.ToLocalTime().ToString("d", System.Globalization.CultureInfo.CurrentCulture)
                                        </span>
                                    }
                                </td>
                                <td class="px-4 py-2.5"><span class="badge badge-gray">@t.ProjectKey</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<TicketDto>? _tickets;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _tickets = await TicketApi.GetAssignedToMeAsync(); }
        catch { _error = L["Error.Load"]; }
        finally { _loading = false; }
    }

    private string CategoryLabel(StatusCategory c) => c switch
    {
        StatusCategory.Backlog    => L["StatusCategory.Backlog"],
        StatusCategory.InProgress => L["StatusCategory.InProgress"],
        StatusCategory.Done       => L["StatusCategory.Done"],
        _                         => c.ToString()
    };

    private static string PriorityBadge(CardPriority p) => p switch
    {
        CardPriority.Low      => "badge-prio-low",
        CardPriority.Medium   => "badge-prio-medium",
        CardPriority.High     => "badge-prio-high",
        CardPriority.Critical => "badge-prio-critical",
        _                     => "badge-gray"
    };
}

