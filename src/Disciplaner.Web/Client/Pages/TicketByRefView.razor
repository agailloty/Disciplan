@page "/tickets/{Ref}"
@attribute [Authorize]
@inject TicketApiClient TicketApi
@inject NavigationManager Nav

<PageTitle>Ticket — Disciplaner</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}

@code {
    [Parameter] public string Ref { get; set; } = string.Empty;

    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null;
        var parts = Ref.Split('-');
        if (parts.Length < 2 || !int.TryParse(parts[^1], out var number))
        {
            _error   = $"Référence invalide : {Ref}";
            _loading = false;
            return;
        }
        var projectKey = string.Join('-', parts[..^1]);

        try
        {
            var ticket = await TicketApi.GetByRefAsync(projectKey, number);
            if (ticket is null)
            {
                _error = $"Ticket {Ref} introuvable.";
                _loading = false;
            }
            else
            {
                Nav.NavigateTo($"/tickets/{ticket.Id}", replace: true);
            }
        }
        catch
        {
            _error   = "Impossible de charger ce ticket.";
            _loading = false;
        }
    }
}
