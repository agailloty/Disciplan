@page "/projects/{Id:guid}"
@attribute [Authorize]
@inject ProjectApiClient Projects
@inject SprintApiClient Sprints
@inject TicketApiClient Tickets
@inject NavigationManager Nav
@inject IStringLocalizer<AppResources> L
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@(_project?.Name ?? L["Nav.Projects"].Value) - Disciplaner</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_project is not null)
{
    <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="badge badge-dark font-mono text-base">@_project.Key</span>
                <h1 class="text-2xl font-semibold text-gray-900 m-0">@_project.Name</h1>
            </div>
            <p class="text-gray-500 text-sm m-0">@(_project.Description ?? L["NoDescription"].Value)</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="surface p-4">
            <div class="section-label mb-1">@L["Project.Stats.Backlog"]</div>
            <div class="text-4xl font-light text-gray-800">@_backlog.Count</div>
            <div class="text-xs text-gray-400 mt-1">@L["Project.Stats.BacklogSub"]</div>
        </div>
        <div class="surface p-4">
            <div class="section-label mb-1">@L["Project.Stats.Sprints"]</div>
            <div class="text-4xl font-light text-gray-800">@_sprints.Count</div>
            <div class="text-xs text-gray-400 mt-1">@L["Project.Stats.SprintsSub"]</div>
        </div>
        <div class="surface p-4">
            <div class="section-label mb-1">@L["Project.Stats.Workflow"]</div>
            <div class="text-4xl font-light text-gray-800">@_project.Statuses.Count</div>
            <div class="text-xs text-gray-400 mt-1">@L["Project.Stats.WorkflowSub"]</div>
        </div>
    </div>

    <div class="flex gap-1 mb-5 border-b border-gray-200">
        <button class="tab-link @(_tab == "active" ? "active-tab" : "")" @onclick="@(() => _tab = "active")">@L["Sprint.Active"]</button>
        <button class="tab-link @(_tab == "planning" ? "active-tab" : "")" @onclick="@(() => _tab = "planning")">@L["Sprint.Planning"]</button>
        <button class="tab-link @(_tab == "settings" ? "active-tab" : "")" @onclick="@(() => { _tab = "settings"; _settingsEditMode = false; })">@L["Project.Settings"]</button>
    </div>

    @if (_tab == "active")
    {
        var activeSprint = ActiveSprint;
        var activeTickets = activeSprint is not null && _ticketsBySprint.TryGetValue(activeSprint.Id, out var tickets)
            ? tickets
            : [];

        <div class="surface">
            <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 border-b border-gray-100">
                <div>
                    <span class="font-semibold text-gray-900">@L["Sprint.Active"]</span>
                    @if (activeSprint is not null)
                    {
                        <span class="badge badge-dark ml-2">@activeSprint.Name</span>
                        <span class="text-gray-500 text-xs ml-2">@L["Sprint.TicketCount", activeTickets.Count]</span>
                    }
                </div>
                <div class="flex items-center gap-2">
                    @if (activeSprint is not null)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => ShowCreateTicketForSprint(activeSprint.Id)"><i class="bi bi-plus-lg mr-1"></i>@L["Sprint.AddTicket"]</button>
                    }
                    <div class="flex border border-gray-200 rounded-md overflow-hidden">
                        <button class="@SprintViewCss("kanban") px-2.5 py-1 text-xs" @onclick="@(() => _activeSprintView = "kanban")">@L["Sprint.View.Kanban"]</button>
                        <button class="@SprintViewCss("list") px-2.5 py-1 text-xs border-l border-gray-200" @onclick="@(() => _activeSprintView = "list")">@L["Sprint.View.List"]</button>
                        <button class="@SprintViewCss("grid") px-2.5 py-1 text-xs border-l border-gray-200" @onclick="@(() => _activeSprintView = "grid")">@L["Sprint.View.Grid"]</button>
                    </div>
                </div>
            </div>
            <div class="p-4">
                @if (activeSprint is null)
                {
                    <div class="text-center text-gray-400 py-10">
                        <div class="text-3xl font-light mb-2">@L["Sprint.NoActive"]</div>
                        <p class="text-sm">@L["Sprint.NoActiveDesc"]</p>
                    </div>
                }
                else if (activeTickets.Count == 0)
                {
                    <div class="text-center text-gray-400 py-10">
                        <p class="text-sm mb-4">@L["Sprint.NoTickets"]</p>
                        <button class="btn btn-primary btn-sm" @onclick="() => ShowCreateTicketForSprint(activeSprint.Id)">
                            <i class="bi bi-plus-lg mr-1"></i>@L["Sprint.AddTicketNew"]
                        </button>
                    </div>
                }
                else if (_activeSprintView == "list")
                {
                    <div class="divide-y divide-gray-50">
                        @foreach (var ticket in activeTickets.OrderBy(t => t.TicketNumber))
                        {
                            <div class="py-2">
                                @TicketRow(ticket)
                            </div>
                        }
                        <div class="py-2">
                            <button class="text-xs text-gray-400 hover:text-gray-600" @onclick="() => ShowCreateTicketForSprint(activeSprint.Id)">
                                <i class="bi bi-plus-lg mr-1"></i>@L["Sprint.AddTicketNew"]
                            </button>
                        </div>
                    </div>
                }
                else if (_activeSprintView == "grid")
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                        @foreach (var ticket in activeTickets.OrderBy(t => t.TicketNumber))
                        {
                            <div>
                                @TicketCard(ticket)
                            </div>
                        }
                        <div class="flex items-center">
                            <button class="surface w-full py-8 text-center text-gray-400 hover:text-gray-600 border-dashed text-sm"
                                    @onclick="() => ShowCreateTicketForSprint(activeSprint.Id)">
                                <i class="bi bi-plus-lg mr-1"></i>Nouveau ticket
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="active-sprint-kanban flex gap-3 overflow-x-auto pb-2">
                        @foreach (var status in _project.Statuses.OrderBy(s => s.Order))
                        {
                            var s = status;
                            var statusTickets = activeTickets
                                .Where(t => t.Status.Id == s.Id)
                                .OrderBy(t => t.TicketNumber)
                                .ToList();

                            <section class="sprint-column @(_dragOverStatusId == s.Id ? "sprint-drag-over" : string.Empty)"
                                     @ondragover:preventDefault
                                     @ondragenter="() => _dragOverStatusId = s.Id"
                                     @ondrop="async () => await DropToStatusAsync(s.Id)">
                                <div class="sprint-column-header">
                                    <span class="w-2 h-2 rounded-full inline-block shrink-0" style="background:@s.Color"></span>
                                    <strong class="text-sm">@s.Name</strong>
                                    <span class="badge badge-gray ml-auto">@statusTickets.Count</span>
                                </div>
                                <div class="sprint-column-body">
                                    @if (statusTickets.Count == 0)
                                    {
                                        <div class="text-gray-400 text-xs text-center py-3">@L["Sprint.ColumnEmpty"]</div>
                                    }
                                    else
                                    {
                                        @foreach (var ticket in statusTickets)
                                        {
                                            @TicketCard(ticket)
                                        }
                                    }
                                </div>
                                <button class="btn-ghost text-xs w-full text-left px-2 py-1"
                                        @onclick="() => ShowCreateTicketForSprint(activeSprint.Id)">
                                    <i class="bi bi-plus-lg mr-1"></i>@L["Sprint.AddCard"]
                                </button>
                            </section>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (_tab == "planning")
    {
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
            <div class="lg:col-span-2">
                <div class="surface">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
                        <div>
                            <span class="font-semibold text-gray-900">@L["Project.Backlog"]</span>
                            <span class="text-gray-400 text-xs ml-2">@L["Sprint.SelectedCount", _selectedTicketIds.Count]</span>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="ShowCreateTicket">+ @L["Sprint.AddTicket"]</button>
                    </div>
                    <div>
                        @if (_backlog.Count == 0)
                        {
                            <div class="p-4 text-gray-400 text-center text-sm">@L["Project.BacklogEmpty"]</div>
                        }
                        else
                        {
                            <div class="divide-y divide-gray-50">
                                @foreach (var ticket in _backlog)
                                {
                                    <div class="px-4 py-2">
                                        <div class="flex items-start gap-2">
                                            <input class="mt-1 accent-gray-700" type="checkbox"
                                                   checked="@_selectedTicketIds.Contains(ticket.Id)"
                                                   @onchange="e => ToggleTicketSelection(ticket.Id, e)" />
                                            <div class="flex-1">
                                                @TicketRow(ticket)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="flex justify-between items-center px-4 py-3 border-t border-gray-100">
                        <span class="text-xs text-gray-400">@L["Sprint.TicketHint"]</span>
                        <button class="btn btn-outline btn-sm"
                                disabled="@(_selectedTicketIds.Count == 0)"
                                @onclick="ShowCreateSprint">
                            @L["Sprint.CreateButton"]
                        </button>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-3">
                <div class="flex flex-col gap-3">
                    @if (_sprints.Count == 0)
                    {
                        <div class="surface p-6 text-center text-gray-400 text-sm">
                            @L["Project.Stats.NoSprints"]
                        </div>
                    }
                    @foreach (var sprint in _sprints)
                    {
                        var sprintTickets = _ticketsBySprint.TryGetValue(sprint.Id, out var list) ? list : [];
                        <div class="surface">
                            <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 border-b border-gray-100">
                                <div>
                                    <span class="font-semibold text-gray-900">@sprint.Name</span>
                                    <span class="badge badge-gray ml-2">@sprint.Status</span>
                                    <span class="text-gray-400 text-xs ml-2">@L["Sprint.TicketCount", sprintTickets.Count]</span>
                                </div>
                                <div class="flex gap-1">
                                    @if (sprint.Status == SprintStatus.Planned)
                                    {
                                        <button class="btn btn-outline btn-sm"
                                                disabled="@(ActiveSprint is not null)"
                                                title="@(ActiveSprint is null ? L["Sprint.StartHint"].Value : L["Sprint.AlreadyActive"].Value)"
                                                @onclick="() => StartSprintAsync(sprint.Id)">
                                            @L["Sprint.Start"]
                                        </button>
                                    }
                                    @if (sprint.Status == SprintStatus.Active)
                                    {
                                        <button class="btn btn-outline btn-sm" @onclick="() => CloseSprintAsync(sprint.Id)">@L["Sprint.Close"]</button>
                                    }
                                </div>
                            </div>
                            <div>
                                @if (sprintTickets.Count == 0)
                                {
                                    <div class="p-3 text-gray-400 text-xs">@L["Sprint.NoTickets"]</div>
                                }
                                else
                                {
                                    <div class="divide-y divide-gray-50">
                                        @foreach (var ticket in sprintTickets)
                                        {
                                            <div class="px-4 py-2">
                                                <div class="flex gap-3 items-start">
                                                    <div class="flex-1">@TicketRow(ticket)</div>
                                                    <button class="btn btn-outline btn-sm"
                                                            @onclick="() => MoveTicketToSprintAsync(ticket.Id, null)">
                                                        @L["Sprint.MoveToBacklog"]
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        @* ── Settings tab ── *@
        <div class="flex flex-col gap-6">

            @* Edit project *@
            <div class="surface">
                <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
                    <span class="font-semibold text-gray-900">@L["Project.EditTitle"]</span>
                    @if (!_settingsEditMode)
                    {
                        <button class="btn btn-outline btn-sm" @onclick="ShowEditProject">@L["Edit"]</button>
                    }
                </div>
                @if (_settingsEditMode)
                {
                    <EditForm Model="_projectForm" OnValidSubmit="UpdateProjectAsync">
                        <div class="p-4 flex flex-col gap-3">
                            <div>
                                <label class="form-label">@L["Name"]</label>
                                <InputText class="form-input" @bind-Value="_projectForm.Name" />
                            </div>
                            <div>
                                <label class="form-label">@L["Description"]</label>
                                <InputTextArea class="form-textarea" rows="3" @bind-Value="_projectForm.Description" />
                            </div>
                            @if (_modalError is not null)
                            {
                                <ErrorAlert Message="@_modalError" />
                            }
                        </div>
                        <div class="flex justify-end gap-2 px-4 py-3 border-t border-gray-100">
                            <button type="button" class="btn btn-outline" @onclick="() => _settingsEditMode = false">@L["Cancel"]</button>
                            <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "…" : L["Save"].Value)</button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <div class="p-4 text-sm text-gray-600">
                        <p><span class="font-medium">@L["Name"] :</span> @_project.Name</p>
                        @if (!string.IsNullOrWhiteSpace(_project.Description))
                        {
                            <p class="mt-1"><span class="font-medium">@L["Description"] :</span> @_project.Description</p>
                        }
                        <p class="mt-1"><span class="font-medium">Clé :</span> <span class="font-mono badge badge-dark">@_project.Key</span></p>
                    </div>
                }
            </div>

            @* Statuses *@
            <div class="surface">
                <div class="flex justify-between items-center px-4 py-3 border-b border-gray-100">
                    <span class="font-semibold text-gray-900">@L["Project.Statuses"]</span>
                    <button class="btn btn-primary btn-sm" @onclick="ShowCreateStatus">+ @L["Col.Status"]</button>
                </div>
                <div class="p-4">
                    <div class="flex flex-col gap-2">
                        @foreach (var status in _project.Statuses.OrderBy(s => s.Order))
                        {
                            var s = status;
                            <div class="flex flex-wrap items-center gap-2 p-2 border border-gray-200 rounded-md">
                                <span class="w-3 h-3 rounded-full inline-block shrink-0" style="background:@s.Color"></span>
                                <strong class="text-sm text-gray-900">@s.Name</strong>
                                <span class="badge badge-gray">@s.Category</span>
                                <span class="text-gray-400 text-xs">@(string.Format(@L["Status.OrderLabel"], @s.Order))</span>
                                <span class="flex-1"></span>
                                <button class="btn btn-outline btn-sm" @onclick="() => ShowEditStatus(s)">@L["Edit"]</button>
                                <button class="btn btn-danger btn-sm" @onclick="() => DeleteStatusAsync(s.Id)">@L["Delete"]</button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Ticket defaults *@
            <div class="surface">
                <div class="px-4 py-3 border-b border-gray-100">
                    <span class="font-semibold text-gray-900">@L["Project.Defaults"]</span>
                    <p class="text-xs text-gray-400 mt-0.5">@L["Project.Defaults.Hint"]</p>
                </div>
                <EditForm Model="_defaultsForm" OnValidSubmit="SaveDefaultsAsync">
                    <div class="p-4 grid grid-cols-2 gap-3">
                        <div>
                            <label class="form-label">@L["Project.DefaultTicketType"]</label>
                            <InputSelect class="form-select" @bind-Value="_defaultsForm.DefaultTicketType">
                                @foreach (var t in Enum.GetValues<TicketType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="form-label">@L["Project.DefaultAssignee"]</label>
                            <InputSelect class="form-select" @bind-Value="_defaultsForm.DefaultAssigneePolicy">
                                @foreach (var p in Enum.GetValues<DefaultAssigneePolicy>())
                                {
                                    <option value="@p">@L[$"DefaultAssigneePolicy.{p}"]</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="flex items-center justify-end gap-3 px-4 py-3 border-t border-gray-100">
                        @if (_defaultsSaved)
                        {
                            <span class="text-xs text-green-600"><i class="bi bi-check2 mr-1"></i>@L["Settings.DisplayName.Saved"]</span>
                        }
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@_defaultsBusy">
                            @(_defaultsBusy ? "…" : L["Save"].Value)
                        </button>
                    </div>
                </EditForm>
            </div>

            @* Danger zone *@
            <div class="surface border border-red-100">
                <div class="px-4 py-3 border-b border-red-100">
                    <span class="font-semibold text-red-700">@L["Project.DangerZone"]</span>
                </div>
                <div class="p-4 flex items-center justify-between">
                    <div>
                        <p class="text-sm font-medium text-gray-900">@L["Project.Delete.Title"]</p>
                        <p class="text-xs text-gray-400 mt-0.5">@L["Project.Delete.Warning"]</p>
                    </div>
                    <button class="btn btn-danger" @onclick="() => _showDeleteProject = true">@L["Delete"]</button>
                </div>
            </div>
        </div>
    }
}

<TicketDetailModal Ticket="_detailTicket"
                   Statuses="@(_project?.Statuses ?? Array.Empty<TicketStatusDto>())"
                   Sprints="_sprints"
                   ActiveSprintId="ActiveSprint?.Id"
                   Visible="_showTicketDetail"
                   OnClose="() => { _showTicketDetail = false; _detailTicket = null; }"
                   OnChanged="OnTicketChangedAsync" />

<Modal Title=@L["Ticket.CreateTitle"] Visible="_showTicket" OnClose="() => _showTicket = false">
    <EditForm Model="_ticketForm" OnValidSubmit="CreateTicketAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">@L["Title"]</label>
            <InputText class="form-input" @bind-Value="_ticketForm.Title" />
            <ValidationMessage For="() => _ticketForm.Title" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["Description"]</label>
            <InputTextArea class="form-textarea" rows="3" @bind-Value="_ticketForm.Description" />
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="form-label">@L["Type"]</label>
                <InputSelect class="form-select" @bind-Value="_ticketForm.Type">
                    @foreach (var type in Enum.GetValues<TicketType>())
                    {
                        <option value="@type">@type</option>
                    }
                </InputSelect>
            </div>
            <div>
                <label class="form-label">@L["Priority"]</label>
                <InputSelect class="form-select" @bind-Value="_ticketForm.Priority">
                    @foreach (var priority in Enum.GetValues<CardPriority>())
                    {
                        <option value="@priority">@priority</option>
                    }
                </InputSelect>
            </div>
            <div>
                <label class="form-label">@L["Ticket.StoryPoints"]</label>
                <InputNumber class="form-input" @bind-Value="_ticketForm.StoryPoints" />
            </div>
            <div>
                <label class="form-label">@L["Ticket.DueDate"]</label>
                <InputDate class="form-input" @bind-Value="_ticketForm.DueDate" />
            </div>
            <div class="col-span-2">
                <label class="form-label">@L["Ticket.Sprint"]</label>
                <InputSelect class="form-select" @bind-Value="_ticketForm.SprintId">
                    <option value="">@L["Ticket.BacklogOption"]</option>
                    @foreach (var s in _sprints)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </InputSelect>
            </div>
        </div>
        @ModalError()
        <div class="flex justify-end gap-2 mt-4">
            <button type="button" class="btn btn-outline" @onclick="() => _showTicket = false">@L["Cancel"]</button>
            <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "..." : @L["Create"])</button>
        </div>
    </EditForm>
</Modal>

<Modal Title="@L["Sprint.CreateTitle"]" Visible="_showSprint" OnClose="() => _showSprint = false">
    <EditForm Model="_sprintForm" OnValidSubmit="CreateSprintAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">@L["Name"]</label>
            <InputText class="form-input" @bind-Value="_sprintForm.Name" />
            <ValidationMessage For="() => _sprintForm.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["Sprint.Goal"]</label>
            <InputTextArea class="form-textarea" rows="3" @bind-Value="_sprintForm.Goal" />
        </div>
        <p class="text-xs text-gray-500">@(string.Format(L["Sprint.TicketsMoved"], _selectedTicketIds.Count))</p>
        @ModalError()
        <div class="flex justify-end gap-2">
            <button type="button" class="btn btn-outline" @onclick="() => _showSprint = false">@L["Cancel"]</button>
            <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "..." : @L["Sprint.CreateButton"])</button>
        </div>
    </EditForm>
</Modal>

<Modal Title="@(_editingStatus is null ? @L["Status.CreateTitle"] : @L["Status.EditTitle"])" Visible="_showStatus" OnClose="() => _showStatus = false">
    <EditForm Model="_statusForm" OnValidSubmit="SaveStatusAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">@L["Name"]</label>
            <InputText class="form-input" @bind-Value="_statusForm.Name" />
            <ValidationMessage For="() => _statusForm.Name" />
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="form-label">@L["Status.Category"]</label>
                <InputSelect class="form-select" @bind-Value="_statusForm.Category">
                    @foreach (var category in Enum.GetValues<StatusCategory>())
                    {
                        <option value="@category">@category</option>
                    }
                </InputSelect>
            </div>
            <div>
                <label class="form-label">@L["Status.Color"]</label>
                <InputText class="form-input" @bind-Value="_statusForm.Color" />
            </div>
        </div>
        @ModalError()
        <div class="flex justify-end gap-2 mt-4">
            <button type="button" class="btn btn-outline" @onclick="() => _showStatus = false">@L["Cancel"]</button>
            <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "…" : L["Save"].Value)</button>
        </div>
    </EditForm>
</Modal>

<ConfirmModal Title="@L["Project.Delete.Title"]"
              Message="@(string.Format(L["Project.Delete.Confirm"], _project?.Name))"
              Visible="_showDeleteProject"
              OnCancel="() => _showDeleteProject = false"
              OnConfirm="DeleteProjectAsync" />

@code {
    [Parameter] public Guid Id { get; set; }

    private ProjectDetailDto? _project;
    private readonly List<TicketDto> _backlog = [];
    private readonly List<SprintDto> _sprints = [];
    private readonly Dictionary<Guid, List<TicketDto>> _ticketsBySprint = [];
    private readonly HashSet<Guid> _selectedTicketIds = [];

    private string? _currentUserId;

    private bool _loading = true;
    private bool _busy;
    private bool _defaultsBusy;
    private bool _defaultsSaved;
    private bool _showTicket;
    private bool _showSprint;
    private bool _showStatus;
    private bool _settingsEditMode;
    private bool _showDeleteProject;
    private bool _showTicketDetail;
    private string _tab = "active";
    private string _activeSprintView = "kanban";
    private string? _error;
    private string? _modalError;
    private TicketStatusDto? _editingStatus;
    private TicketDto? _detailTicket;
    private Guid? _draggingTicketId;
    private Guid? _dragOverStatusId;

    private TicketForm _ticketForm = new();
    private SprintForm _sprintForm = new();
    private StatusForm _statusForm = new();
    private ProjectForm _projectForm = new();
    private DefaultsForm _defaultsForm = new();

    private sealed class TicketForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public TicketType Type { get; set; } = TicketType.Story;
        public CardPriority Priority { get; set; } = CardPriority.Medium;
        public int? StoryPoints { get; set; }
        public DateTime? DueDate { get; set; }
        public Guid? SprintId { get; set; }
        public string? AssigneeId { get; set; }
    }

    private sealed class DefaultsForm
    {
        public TicketType DefaultTicketType { get; set; } = TicketType.Story;
        public DefaultAssigneePolicy DefaultAssigneePolicy { get; set; } = DefaultAssigneePolicy.None;
    }

    private sealed class SprintForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string Name { get; set; } = string.Empty;
        public string? Goal { get; set; }
    }

    private sealed class StatusForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;
        public StatusCategory Category { get; set; } = StatusCategory.Backlog;
        public string Color { get; set; } = "#6c757d";
    }

    private sealed class ProjectForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? authState.User.FindFirst("sub")?.Value;
        await LoadAsync();
    }

    private SprintDto? ActiveSprint
        => _sprints.FirstOrDefault(s => s.Status == SprintStatus.Active);

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _project = await Projects.GetProjectAsync(Id);
            if (_project is not null)
                _defaultsForm = new() { DefaultTicketType = _project.DefaultTicketType, DefaultAssigneePolicy = _project.DefaultAssigneePolicy };
            _backlog.Clear();
            _backlog.AddRange(await Tickets.GetBacklogAsync(Id) ?? []);
            _sprints.Clear();
            _sprints.AddRange((await Sprints.GetByProjectAsync(Id) ?? []).OrderByDescending(s => s.CreatedAt));
            _ticketsBySprint.Clear();
            foreach (var sprint in _sprints)
                _ticketsBySprint[sprint.Id] = await Tickets.GetBySprintAsync(sprint.Id) ?? [];
        }
        catch { _error = L["Error.Load"]; }
        finally { _loading = false; }
    }

    private RenderFragment TicketRow(TicketDto ticket) => @<div>
        <div class="flex flex-wrap items-center gap-2">
            <button class="text-xs font-semibold text-blue-600 hover:underline p-0"
                    @onclick="() => OpenTicketDetail(ticket)">@ticket.TicketRef</button>
            <button class="text-sm text-gray-800 hover:underline p-0"
                    @onclick="() => OpenTicketDetail(ticket)">@ticket.Title</button>
            <span class="badge badge-gray">@ticket.Type</span>
            <span class="badge @PriorityClass(ticket.Priority)">@ticket.Priority</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(ticket.Description))
        {
            <div class="text-gray-400 text-xs mt-1">@ticket.Description</div>
        }
        <div class="flex flex-wrap items-center gap-2 mt-2">
            <select class="form-select text-xs py-0.5" style="width:auto;"
                    value="@ticket.Status.Id"
                    @onchange="e => ChangeStatusAsync(ticket.Id, Guid.Parse(e.Value?.ToString() ?? string.Empty))">
                @foreach (var status in (_project?.Statuses ?? Array.Empty<TicketStatusDto>()).OrderBy(s => s.Order))
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
            @if (ticket.StoryPoints.HasValue)
            {
                <span class="text-gray-400 text-xs">@ticket.StoryPoints pts</span>
            }
            @if (ticket.DueDate.HasValue)
            {
                <span class="text-gray-400 text-xs">Due @ticket.DueDate.Value.ToLocalTime().ToString("dd/MM")</span>
            }
            @if (ActiveSprint is not null && ticket.SprintId is null)
            {
                <button class="btn btn-outline btn-sm py-0" title="Ajouter au sprint actif"
                        @onclick:stopPropagation @onclick="() => AddTicketToActiveSprintAsync(ticket.Id)">
                    <i class="bi bi-lightning mr-1"></i>Sprint
                </button>
            }
            <button class="btn-icon-danger" title="Supprimer"
                    @onclick:stopPropagation @onclick="() => DeleteTicketAsync(ticket.Id)">
                <i class="bi bi-trash"></i>
            </button>
        </div>
    </div>;

    private RenderFragment TicketCard(TicketDto ticket) => @<article class="ticket-card @(_draggingTicketId == ticket.Id ? "opacity-50" : string.Empty)" draggable="true" @ondragstart="() => _draggingTicketId = ticket.Id" @ondragend="() => { _draggingTicketId = null; _dragOverStatusId = null; }">
        <div class="p-3">
            <div class="flex justify-between items-start gap-2 cursor-pointer" @onclick="() => OpenTicketDetail(ticket)">
                <span class="text-xs font-semibold text-blue-600">@ticket.TicketRef</span>
                <span class="badge @PriorityClass(ticket.Priority)">@ticket.Priority</span>
            </div>
            <div class="font-medium text-sm text-gray-900 mt-1 cursor-pointer" @onclick="() => OpenTicketDetail(ticket)">@ticket.Title</div>
            @if (!string.IsNullOrWhiteSpace(ticket.Description))
            {
                <div class="ticket-card-description text-gray-400 text-xs mt-1">@ticket.Description</div>
            }
            <div class="flex flex-wrap items-center gap-1 mt-3">
                <span class="badge badge-gray">@ticket.Type</span>
                @if (ticket.StoryPoints.HasValue)
                {
                    <span class="badge badge-gray">@ticket.StoryPoints pts</span>
                }
                @if (ticket.DueDate.HasValue)
                {
                    <span class="text-gray-400 text-xs">@ticket.DueDate.Value.ToLocalTime().ToString("dd/MM")</span>
                }
            </div>
            @if (ticket.Labels.Count > 0)
            {
                <div class="flex flex-wrap gap-1 mt-2" @onclick:stopPropagation>
                    @foreach (var lbl in ticket.Labels)
                    {
                        var lblUrl = $"/labels/{lbl.Id}";
                        <a href="@lblUrl" class="label-badge"
                           style="background:@lbl.Color; color:@TicketLabelTextColor(lbl.Color)">@lbl.Name</a>
                    }
                </div>
            }
            <select class="form-select text-xs mt-3 py-1"
                    value="@ticket.Status.Id"
                    @onchange="e => ChangeStatusAsync(ticket.Id, Guid.Parse(e.Value?.ToString() ?? string.Empty))">
                @foreach (var status in (_project?.Statuses ?? Array.Empty<TicketStatusDto>()).OrderBy(s => s.Order))
                {
                    <option value="@status.Id">@status.Name</option>
                }
            </select>
            @if (ActiveSprint is not null && ticket.SprintId is null)
            {
                <button class="btn btn-outline btn-sm w-full mt-2"
                        @onclick:stopPropagation @onclick="() => AddTicketToActiveSprintAsync(ticket.Id)">
                    <i class="bi bi-lightning mr-1"></i>Ajouter au sprint
                </button>
            }
        </div>
    </article>;

    private RenderFragment ModalError() => @<div>
        @if (_modalError is not null)
        {
            <ErrorAlert Message="@_modalError" />
        }
    </div>;

    private string SprintViewCss(string view)
        => _activeSprintView == view ? "bg-gray-900 text-white" : "bg-white text-gray-600 hover:bg-gray-50";

    private static string PriorityClass(CardPriority priority) => priority switch
    {
        CardPriority.Low => "badge badge-prio-low",
        CardPriority.Medium => "badge badge-prio-medium",
        CardPriority.High => "badge badge-prio-high",
        CardPriority.Critical => "badge badge-prio-critical",
        _ => "badge badge-gray"
    };

    private static string TicketLabelTextColor(string hex)
    {
        try
        {
            hex = hex.TrimStart('#');
            if (hex.Length == 3) hex = string.Concat(hex.Select(c => $"{c}{c}"));
            var r = Convert.ToInt32(hex[0..2], 16);
            var g = Convert.ToInt32(hex[2..4], 16);
            var b = Convert.ToInt32(hex[4..6], 16);
            return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.55 ? "#1f2328" : "#ffffff";
        }
        catch { return "#ffffff"; }
    }

    private void ToggleTicketSelection(Guid ticketId, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected)
            _selectedTicketIds.Add(ticketId);
        else
            _selectedTicketIds.Remove(ticketId);
    }

    private void ShowCreateTicket()
    {
        var type = _project?.DefaultTicketType ?? TicketType.Story;
        var assigneeId = _project?.DefaultAssigneePolicy == DefaultAssigneePolicy.Creator ? _currentUserId : null;
        _ticketForm = new() { Type = type, AssigneeId = assigneeId };
        _modalError = null;
        _showTicket = true;
    }

    private void ShowCreateTicketForSprint(Guid? sprintId)
    {
        var type = _project?.DefaultTicketType ?? TicketType.Story;
        var assigneeId = _project?.DefaultAssigneePolicy == DefaultAssigneePolicy.Creator ? _currentUserId : null;
        _ticketForm = new() { SprintId = sprintId, Type = type, AssigneeId = assigneeId };
        _modalError = null;
        _showTicket = true;
    }

    private async Task CreateTicketAsync()
    {
        _busy = true;
        _modalError = null;
        try
        {
            await Tickets.CreateAsync(Id, new CreateTicketRequest(
                _ticketForm.Title,
                _ticketForm.Description,
                _ticketForm.Type,
                _ticketForm.Priority,
                _ticketForm.StoryPoints,
                _ticketForm.DueDate,
                _ticketForm.SprintId,
                null,
                _ticketForm.AssigneeId));
            _showTicket = false;
            await LoadAsync();
        }
        catch { _modalError = L["Error.Create"]; }
        finally { _busy = false; }
    }

    private void ShowCreateSprint()
    {
        _sprintForm = new() { Name = $"Sprint {_sprints.Count + 1}" };
        _modalError = null;
        _showSprint = true;
    }

    private async Task CreateSprintAsync()
    {
        _busy = true;
        _modalError = null;
        try
        {
            var sprint = await Sprints.CreateAsync(Id, new CreateSprintRequest(_sprintForm.Name, _sprintForm.Goal));
            if (sprint is not null)
            {
                foreach (var ticketId in _selectedTicketIds.ToList())
                    await Tickets.MoveToSprintAsync(ticketId, new MoveTicketToSprintRequest(sprint.Id));
            }
            _selectedTicketIds.Clear();
            _showSprint = false;
            await LoadAsync();
        }
        catch { _modalError = L["Error.Create"]; }
        finally { _busy = false; }
    }

    private async Task MoveTicketToSprintAsync(Guid ticketId, Guid? sprintId)
    {
        await Tickets.MoveToSprintAsync(ticketId, new MoveTicketToSprintRequest(sprintId));
        await LoadAsync();
    }

    private async Task DeleteTicketAsync(Guid ticketId)
    {
        await Tickets.DeleteAsync(ticketId);
        await LoadAsync();
    }

    private async Task AddTicketToActiveSprintAsync(Guid ticketId)
    {
        if (ActiveSprint is null) return;
        await MoveTicketToSprintAsync(ticketId, ActiveSprint.Id);
    }

    private async Task ChangeStatusAsync(Guid ticketId, Guid statusId)
    {
        await Tickets.ChangeStatusAsync(ticketId, new ChangeTicketStatusRequest(statusId));
        await LoadAsync();
    }

    private async Task StartSprintAsync(Guid sprintId)
    {
        try
        {
            var start = DateTime.Today;
            await Sprints.StartAsync(sprintId, new StartSprintRequest(start, start.AddDays(14)));
            _tab = "active";
            _activeSprintView = "kanban";
            await LoadAsync();
        }
        catch { _error = L["Sprint.AlreadyActive"]; }
    }

    private async Task CloseSprintAsync(Guid sprintId)
    {
        await Sprints.CloseAsync(sprintId);
        await LoadAsync();
    }

    private void ShowCreateStatus()
    {
        _editingStatus = null;
        _statusForm = new();
        _modalError = null;
        _showStatus = true;
    }

    private void ShowEditStatus(TicketStatusDto status)
    {
        _editingStatus = status;
        _statusForm = new() { Name = status.Name, Category = status.Category, Color = status.Color };
        _modalError = null;
        _showStatus = true;
    }

    private async Task SaveStatusAsync()
    {
        _busy = true;
        _modalError = null;
        try
        {
            if (_editingStatus is null)
                await Projects.AddStatusAsync(Id, new CreateTicketStatusRequest(_statusForm.Name, _statusForm.Category, _statusForm.Color));
            else
                await Projects.UpdateStatusAsync(Id, _editingStatus.Id, new UpdateTicketStatusRequest(_statusForm.Name, _statusForm.Category, _statusForm.Color));
            _showStatus = false;
            await LoadAsync();
        }
        catch { _modalError = L["Error.Update"]; }
        finally { _busy = false; }
    }

    private async Task DeleteStatusAsync(Guid statusId)
    {
        try
        {
            await Projects.DeleteStatusAsync(Id, statusId);
            await LoadAsync();
        }
        catch { _error = L["Error.Delete"]; }
    }

    private void ShowEditProject()
    {
        _projectForm = new() { Name = _project!.Name, Description = _project.Description };
        _modalError = null;
        _settingsEditMode = true;
        _tab = "settings";
    }

    private async Task SaveDefaultsAsync()
    {
        _defaultsBusy = true;
        _defaultsSaved = false;
        try
        {
            var updated = await Projects.UpdateDefaultsAsync(Id, new UpdateProjectDefaultsRequest(
                _defaultsForm.DefaultTicketType, _defaultsForm.DefaultAssigneePolicy));
            if (updated is not null) _project = updated;
            _defaultsSaved = true;
        }
        catch { _modalError = L["Error.Update"]; }
        finally { _defaultsBusy = false; }
    }

    private async Task UpdateProjectAsync()
    {
        _busy = true;
        _modalError = null;
        try
        {
            await Projects.UpdateProjectAsync(Id, new UpdateProjectRequest(_projectForm.Name, _projectForm.Description));
            _settingsEditMode = false;
            await LoadAsync();
        }
        catch { _modalError = "Impossible de modifier le projet."; }
        finally { _busy = false; }
    }

    private async Task DeleteProjectAsync()
    {
        await Projects.DeleteProjectAsync(Id);
        Nav.NavigateTo("/projects");
    }

    private void OpenTicketDetail(TicketDto ticket)
    {
        _detailTicket     = ticket;
        _showTicketDetail = true;
    }

    private async Task OnTicketChangedAsync()
    {
        var prevId = _detailTicket?.Id;
        await LoadAsync();
        if (prevId.HasValue && _showTicketDetail)
        {
            var updated = _backlog.FirstOrDefault(t => t.Id == prevId)
                ?? _ticketsBySprint.Values.SelectMany(t => t).FirstOrDefault(t => t.Id == prevId);
            _detailTicket = updated;
            if (_detailTicket is null) _showTicketDetail = false;
        }
    }

    private async Task DropToStatusAsync(Guid statusId)
    {
        if (_draggingTicketId is null) return;
        var ticketId     = _draggingTicketId.Value;
        _draggingTicketId = null;
        _dragOverStatusId = null;
        await ChangeStatusAsync(ticketId, statusId);
    }
}
