@page "/boards"
@attribute [Authorize]
@inject BoardApiClient Boards
@inject NavigationManager Nav
@inject IStringLocalizer<AppResources> L

<PageTitle>@L["Nav.Boards"]</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="page-title">@L["Nav.Boards"]</h1>
    <button class="btn btn-primary" @onclick="ShowCreateModal">
        <i class="bi bi-plus"></i> @L["Board.CreateTitle"]
    </button>
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorAlert Message="@_error" />
}
else if (_boards is not null)
{
    @if (_boards.Count == 0)
    {
        <div class="text-center py-20 text-gray-400">
            <span class="text-5xl block mb-3">&#9638;</span>
            <p class="text-sm">@L["Board.Empty"]</p>
            <button class="btn btn-primary mt-4" @onclick="ShowCreateModal">@L["Board.CreateFirst"]</button>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @{int idx = 0;}
            @foreach (var board in _boards)
            {
                var b = board;
                var accent = _accents[idx % _accents.Length];
                idx++;
                <div class="surface surface-hover" style="border-top: 3px solid @accent">
                    <div class="p-4 cursor-pointer" @onclick="() => NavigateToBoard(b.Id)">
                        <h2 class="font-semibold text-gray-900 text-base">@b.Name</h2>
                        @if (b.Description is not null)
                        {
                            <p class="text-gray-500 text-sm mt-1 line-clamp-2">@b.Description</p>
                        }
                    </div>
                    <div class="flex items-center justify-between px-4 py-2.5 border-t border-gray-100">
                        <span class="text-xs text-gray-400">
                            <span class="badge badge-gray mr-1">@b.ColumnCount col.</span>
                            @b.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                        </span>
                        <div class="flex gap-1" @onclick:stopPropagation>
                            <button class="btn-icon" title=@L["Edit"] @onclick="() => ShowEditModal(b)"><i class="bi bi-pencil text-xs"></i></button>
                            <button class="btn-icon btn-icon-danger" title=@L["Delete"] @onclick="() => ShowDeleteConfirm(b)"><i class="bi bi-trash text-xs"></i></button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@*Create/Edit modal *@
<Modal Title="@(_editTarget is null ? @L["Board.CreateTitle"] : @L["Board.EditTitle"])"
       Visible="_showForm" OnClose="CloseForm">
    <EditForm Model="_form" OnValidSubmit="SubmitBoardFormAsync">
        <DataAnnotationsValidator />
        <div class="mb-4">
            <label class="form-label">@L["Name"]</label>
            <InputText @bind-Value="_form.Name" class="form-input" />
            <ValidationMessage For="() => _form.Name" />
        </div>
        <div class="mb-5">
            <label class="form-label">@L["Board.Description"]</label>
            <InputTextArea @bind-Value="_form.Description" class="form-textarea" rows="2" />
        </div>
        @if (_formError is not null)
        {
            <div class="mb-4"><ErrorAlert Message="@_formError" /></div>
        }
        <div class="flex justify-end gap-2">
            <button type="button" class="btn btn-outline" @onclick="CloseForm">@L["Cancel"]</button>
            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @(_busy ? "--" : (_editTarget is null ? @L["Create"] : @L["Save"]))
            </button>
        </div>
    </EditForm>
</Modal>

@*Delete confirmation *@
<ConfirmModal Title=@L["Board.Delete.Title"]
              Message=@(string.Format(L["Board.Delete.Confirm"], _deleteTarget?.Name))
              Visible="_showDelete"
              OnCancel="() => _showDelete = false"
              OnConfirm="DeleteBoardAsync" />

@code {
    private sealed class BoardForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(100)]
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }

    private List<BoardSummaryDto>? _boards;
    private static readonly string[] _accents = ["#4f46e5", "#0ea5e9", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899"];
    private bool _loading = true;
    private string? _error;
    private bool _showForm, _showDelete, _busy;
    private string? _formError;
    private BoardForm _form = new();
    private BoardSummaryDto? _editTarget, _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        try { _boards = await Boards.GetBoardsAsync(); }
        catch { _error = L["Error.Load"]; }
        finally { _loading = false; }
    }

    private void ShowCreateModal() { _editTarget = null; _form = new(); _formError = null; _showForm = true; }
    private void ShowEditModal(BoardSummaryDto b) { _editTarget = b; _form = new() { Name = b.Name, Description = b.Description }; _formError = null; _showForm = true; }
    private void ShowDeleteConfirm(BoardSummaryDto b) { _deleteTarget = b; _showDelete = true; }
    private void CloseForm() { _showForm = false; _formError = null; }
    private void NavigateToBoard(Guid id) => Nav.NavigateTo($"/boards/{id}");

    private async Task SubmitBoardFormAsync()
    {
        _busy = true; _formError = null;
        try
        {
            if (_editTarget is null)
            {
                var created = await Boards.CreateBoardAsync(new CreateBoardRequest(_form.Name, _form.Description));
                if (created is not null) { _boards ??= []; _boards.Add(created); }
            }
            else
            {
                await Boards.UpdateBoardAsync(_editTarget.Id, new UpdateBoardRequest(_form.Name, _form.Description));
                var idx = _boards!.FindIndex(b => b.Id == _editTarget.Id);
                if (idx >= 0) _boards[idx] = _boards[idx] with { Name = _form.Name, Description = _form.Description };
            }
            _showForm = false;
        }
        catch { _formError = L["Error.Default"]; }
        finally { _busy = false; }
    }

    private async Task DeleteBoardAsync()
    {
        if (_deleteTarget is null) return;
        try
        {
            await Boards.DeleteBoardAsync(_deleteTarget.Id);
            _boards?.RemoveAll(b => b.Id == _deleteTarget.Id);
        }
        catch { _error = L["Error.Delete"]; }
        finally { _showDelete = false; _deleteTarget = null; }
    }
}
