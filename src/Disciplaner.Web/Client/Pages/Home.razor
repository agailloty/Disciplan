@page "/"
@attribute [Authorize]
@implements IDisposable
@inject TicketApiClient TicketApi
@inject ActivityApiClient ActivityApi
@inject SavedViewApiClient SavedViewApi
@inject SprintApiClient SprintApi
@inject DashboardConfigService DashConfig
@inject ThemeService Theme
@inject AuthenticationStateProvider AuthStateProvider
@inject UserProfileService UserProfile
@inject NavigationManager Nav
@inject IStringLocalizer<AppResources> L
@inject AttachmentApiClient AttachmentApi

@using System.Security.Claims
@using Disciplaner.Application.DTOs.Ticket
@using Disciplaner.Application.DTOs.Activity
@using Disciplaner.Application.DTOs.Attachment
@using Disciplaner.Application.DTOs.SavedView
@using Disciplaner.Application.DTOs.Sprint
@using Disciplaner.Domain.Enums
@using Disciplaner.Web.Client.Models

<PageTitle>@L["Nav.Home"] — Disciplaner</PageTitle>

@* ── Welcome banner ───────────────────────────────────────────────────────── *@
<div class="dashboard-banner">
    <div class="dashboard-banner-content">
        <div>
            <h1 class="dashboard-welcome">@L["Home.Welcome", _displayName ?? string.Empty]</h1>
            <p class="dashboard-date">@DateTime.Now.ToString("dddd d MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</p>
        </div>
        <button class="btn btn-primary flex items-center gap-1.5" @onclick="() => _showQuickCreate = true">
            <i class="bi bi-plus-lg"></i> Créer
        </button>
    </div>
</div>

<QuickCreateModal Visible="_showQuickCreate" OnClose="() => _showQuickCreate = false" />

@* ── Quick stats (optional) ───────────────────────────────────────────────── *@
@if (!_dashboardLoading && !_ticketsLoading && Theme.ShowStats)
{
    <div class="dashboard-stats-row">
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon" style="background:var(--accent-light);color:var(--accent)">
                <i class="bi bi-ticket-perforated-fill"></i>
            </div>
            <div>
                <div class="dashboard-stat-value">@(_tickets?.Count ?? 0)</div>
                <div class="dashboard-stat-label">@L["Home.MyTickets"]</div>
            </div>
        </div>
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon" style="background:#dcfce7;color:#16a34a">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div>
                <div class="dashboard-stat-value">@(_activeSprints?.Count ?? 0)</div>
                <div class="dashboard-stat-label">@L["Home.ActiveSprints"]</div>
            </div>
        </div>
        @{
            var overdueCount = _tickets?.Count(t => t.DueDate.HasValue && t.DueDate.Value.ToUniversalTime() < DateTime.UtcNow) ?? 0;
        }
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon" style="background:#fee2e2;color:#dc2626">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <div class="dashboard-stat-value @(overdueCount > 0 ? "text-red-600" : "")">@overdueCount</div>
                <div class="dashboard-stat-label">@L["Home.Overdue"]</div>
            </div>
        </div>
        @{
            var inProgressCount = _tickets?.Count(t => t.Status?.Category == Disciplaner.Domain.Enums.StatusCategory.InProgress) ?? 0;
        }
        <div class="dashboard-stat-card">
            <div class="dashboard-stat-icon" style="background:#fef3c7;color:#d97706">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <div class="dashboard-stat-value">@inProgressCount</div>
                <div class="dashboard-stat-label">@L["Home.InProgress"]</div>
            </div>
        </div>
    </div>
}

@if (_dashboardLoading)
{
    <LoadingSpinner />
}
else if (!_widgets.Any(w => w.Visible))
{
    <div class="surface py-12 text-center text-gray-400 text-sm">
        <i class="bi bi-layout-wtf text-3xl block mb-2"></i>
        @L["Home.NoDashboardWidgets"] <a href="/settings?tab=dashboard" class="text-blue-600">@L["Home.ConfigureDashboard"] →</a>
    </div>
}
else
{
    <div class="space-y-8">
        @foreach (var widget in _widgets.Where(w => w.Visible))
        {
            var w = widget;
            var wKey = DashboardConfigService.WidgetKey(w);

            <div class="surface">
                @* ── En-tête ── *@
                <div class="flex items-center gap-2 px-5 py-4 border-b" style="border-color:var(--border)">
                    <button class="flex-1 flex items-center gap-2 text-left"
                            @onclick="() => ToggleWidget(wKey)">
                        <i class="bi @(_expanded.Contains(wKey) ? "bi-chevron-down" : "bi-chevron-right") text-xs shrink-0" style="color:var(--text-muted)"></i>
                        <i class="bi @WidgetIcon(w) text-sm shrink-0" style="color:var(--text-muted)"></i>
                        <span class="text-sm font-semibold" style="color:var(--text-base)">@WidgetLabel(w)</span>
                        @if (w.Kind == "my_tickets" && _tickets is not null)
                        {
                            <span class="badge badge-gray shrink-0">@_tickets.Count</span>
                        }
                        @if (w.Kind == "active_sprints" && _activeSprints is not null)
                        {
                            <span class="badge badge-gray shrink-0">@_activeSprints.Count</span>
                        }
                        @if (w.Kind == "saved_view" && w.ViewId.HasValue && _viewTickets.TryGetValue(w.ViewId.Value, out var ct))
                        {
                            <span class="badge badge-gray shrink-0">@ct.Count</span>
                        }
                    </button>
                    @if (w.Kind == "my_tickets")
                    {
                        <a href="/my-tickets" class="text-xs text-blue-600 hover:text-blue-800 shrink-0 transition-colors"
                           @onclick:stopPropagation>@L["Home.ViewAll"] →</a>
                    }
                </div>

                @* ── Corps ── *@
                @if (_expanded.Contains(wKey))
                {
                    @if (w.Kind == "my_tickets")
                    {
                        @if (_ticketsLoading)
                        {
                            <div class="p-4"><LoadingSpinner /></div>
                        }
                        else if (_ticketsError is not null)
                        {
                            <div class="p-4"><ErrorAlert Message="@_ticketsError" /></div>
                        }
                        else if (_tickets is null || _tickets.Count == 0)
                        {
                            <div class="py-10 text-center text-gray-400 text-sm">
                                <i class="bi bi-inbox text-2xl block mb-1"></i>
                                @L["Home.NoTickets"]
                            </div>
                        }
                        else
                        {
                            <div class="divide-y" style="border-color:var(--border)">
                                @foreach (var ticket in _tickets.Take(7))
                                {
                                    var t = ticket;
                                    var ticketUrl = "/tickets/" + t.TicketRef;
                                    <div class="flex items-center gap-2 px-5 py-3 cursor-pointer transition-colors"
                                         @onclick="() => Nav.NavigateTo(ticketUrl)">
                                        <span class="flex items-center gap-1 shrink-0" style="max-width:5.5rem">
                                            <span class="w-2 h-2 rounded-full inline-block shrink-0" style="background:@t.Status.Color"></span>
                                            <span class="text-xs truncate" style="color:var(--text-muted)">@t.Status.Name</span>
                                        </span>
                                        <span class="badge badge-dark font-mono shrink-0">@t.TicketRef</span>
                                        <span class="text-sm font-medium flex-1 truncate" style="color:var(--text-base)">@t.Title</span>
                                        <span class="badge @PriorityBadge(t.Priority) shrink-0 hidden sm:flex">@t.Priority</span>
                                        @if (t.DueDate.HasValue)
                                        {
                                            var overdue = t.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                                            <span class="text-xs shrink-0 @(overdue ? "text-red-600 font-semibold" : "")" style="@(overdue ? "" : "color:var(--text-muted)")">@t.DueDate.Value.ToLocalTime().ToString("dd/MM")</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (w.Kind == "active_sprints")
                    {
                        @if (_activeSprintsLoading)
                        {
                            <div class="p-4"><LoadingSpinner /></div>
                        }
                        else if (_activeSprints is null || _activeSprints.Count == 0)
                        {
                            <div class="py-10 text-center text-gray-400 text-sm">
                                <i class="bi bi-calendar-check text-2xl block mb-1"></i>
                                @L["Sprint.NoneActive"]
                            </div>
                        }
                        else
                        {
                        <div class="divide-y" style="border-color:var(--border)">
                                @foreach (var sprint in _activeSprints)
                                {
                                    var sp = sprint;
                                    var sprintUrl = $"/sprints/{sp.Id}";
                                    <div class="flex items-center gap-3 px-5 py-4 cursor-pointer transition-colors"
                                         @onclick="() => Nav.NavigateTo(sprintUrl)">
                                        @if (sp.ProjectKey is not null)
                                        {
                                            <span class="badge badge-dark font-mono shrink-0">@sp.ProjectKey</span>
                                        }
                                        <span class="text-sm font-medium flex-1 truncate" style="color:var(--text-base)">@sp.Name</span>
                                        @if (sp.ProjectName is not null)
                                        {
                                            <span class="text-xs truncate hidden sm:block" style="color:var(--text-muted)">@sp.ProjectName</span>
                                        }
                                        <span class="badge badge-gray shrink-0">@sp.TicketCount @L["Sprint.Tickets"]</span>
                                        @if (sp.EndDate.HasValue)
                                        {
                                            var daysLeft = (int)(sp.EndDate.Value.ToUniversalTime() - DateTime.UtcNow).TotalDays;
                                            <span class="text-xs shrink-0 @(daysLeft < 3 ? "text-red-600 font-semibold" : "")" style="@(daysLeft < 3 ? "" : "color:var(--text-muted)")">@sp.EndDate.Value.ToLocalTime().ToString("dd/MM")</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (w.Kind == "recent_activity")
                    {
                        <div class="activity-scroll">
                            @if (_activityLoading)
                            {
                                <div class="p-4"><LoadingSpinner /></div>
                            }
                            else if (_activityError is not null)
                            {
                                <div class="p-4"><ErrorAlert Message="@_activityError" /></div>
                            }
                            else if (_activityGroups is null || _activityGroups.Count == 0)
                            {
                                <div class="py-10 text-center text-gray-400 text-sm">
                                    <i class="bi bi-calendar-x text-2xl block mb-1"></i>
                                    @L["Home.NoActivity"]
                                </div>
                            }
                            else
                            {
                        <div class="divide-y" style="border-color:var(--border)">
                                    @foreach (var group in _activityGroups)
                                    {
                                        var g = group;
                                        <div class="px-5 py-4">
                                            @* Ticket header *@
                                            <div class="flex items-center gap-2 mb-3">
                                                <a href="/tickets/@g.TicketRef" class="badge badge-dark font-mono text-xs hover:opacity-80">@g.TicketRef</a>
                                                <span class="text-xs font-semibold truncate" style="color:var(--text-base)">@g.TicketTitle</span>
                                                <span class="ml-auto shrink-0" style="font-size:.68rem;color:var(--text-muted)">@RelativeTime(g.LastOccurredAt)</span>
                                            </div>
                                            @* Event list *@
                                            <div class="flex flex-col gap-1.5 pl-2 border-l-2" style="border-color:var(--border)">
                                                @foreach (var ev in g.Events)
                                                {
                                                    var e = ev;
                                                    <div class="flex items-center gap-2">
                                                        <span class="shrink-0 w-3.5 text-center @ActivityIconColor(e.Kind)">
                                                            <i class="bi @ActivityIcon(e.Kind) text-xs"></i>
                                                        </span>
                                                        <span class="text-xs truncate flex-1" style="color:var(--text-muted)">@e.Summary</span>
                                                        @if (e.Kind == "attachment_added" && e.AttachmentId.HasValue)
                                                        {
                                                            var attachmentId = e.AttachmentId.Value;
                                                            var fileName = e.Summary;
                                                            <button class="att-action-btn shrink-0" title="@L["Attachment.Preview"]"
                                                                    @onclick="() => OpenHomeAttachmentPreviewAsync(attachmentId, fileName)">
                                                                <i class="bi bi-eye text-xs"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (w.Kind == "saved_view" && w.ViewId.HasValue)
                    {
                        var viewId = w.ViewId.Value;
                        @if (_viewLoading.Contains(viewId))
                        {
                            <div class="p-4"><LoadingSpinner /></div>
                        }
                        else if (_viewTickets.TryGetValue(viewId, out var svTickets))
                        {
                            @if (svTickets.Count == 0)
                            {
                                <div class="py-8 text-center text-gray-400 text-sm">
                                    <i class="bi bi-inbox text-2xl block mb-1"></i>
                                    @L["Home.NoViewTickets"]
                                </div>
                            }
                            else
                            {
                                <div class="divide-y" style="border-color:var(--border)">
                                    @foreach (var ticket in svTickets)
                                    {
                                        var t = ticket;
                                        var svTicketUrl = "/tickets/" + t.TicketRef;
                                        <div class="flex items-center gap-2 px-5 py-3 cursor-pointer transition-colors"
                                             @onclick="() => Nav.NavigateTo(svTicketUrl)">
                                            <span class="flex items-center gap-1 shrink-0" style="max-width:5.5rem">
                                                <span class="w-2 h-2 rounded-full inline-block shrink-0" style="background:@t.Status.Color"></span>
                                                <span class="text-xs truncate" style="color:var(--text-muted)">@t.Status.Name</span>
                                            </span>
                                            <span class="badge badge-dark font-mono shrink-0">@t.TicketRef</span>
                                            <span class="text-sm font-medium flex-1 truncate" style="color:var(--text-base)">@t.Title</span>
                                            <span class="badge @PriorityBadge(t.Priority) shrink-0 hidden sm:flex">@t.Priority</span>
                                            @if (t.DueDate.HasValue)
                                            {
                                                var overdue = t.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                                                <span class="text-xs shrink-0 @(overdue ? "text-red-600 font-semibold" : "")" style="@(overdue ? "" : "color:var(--text-muted)")">
                                                    @t.DueDate.Value.ToLocalTime().ToString("dd/MM")
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                }
            </div>
        }
    </div>
}

<FilePreviewModal Attachment="_homePreviewAttachment"
                  Visible="_homePreviewAttachment is not null"
                  OnClose="() => _homePreviewAttachment = null" />

@code {
    private string? _displayName;
    private bool _showQuickCreate;

    // ── Built-in widget data ───────────────────────────────────────────────────
    private List<TicketDto>? _tickets;
    private List<TicketActivityGroupDto>? _activityGroups;
    private AttachmentDto? _homePreviewAttachment;
    private List<SprintDto>? _activeSprints;
    private bool _ticketsLoading = true;
    private bool _activityLoading = true;
    private bool _activeSprintsLoading = true;
    private string? _ticketsError;
    private string? _activityError;

    // ── Dashboard config ───────────────────────────────────────────────────────
    private List<DashboardWidget> _widgets = [];
    private Dictionary<Guid, SavedViewDto> _savedViewsById = [];
    private bool _dashboardLoading = true;
    private readonly HashSet<string> _expanded = [];

    // ── Saved view tickets (lazy) ──────────────────────────────────────────────
    private readonly HashSet<Guid> _viewLoading = [];
    private readonly Dictionary<Guid, List<TicketDto>> _viewTickets = [];

    protected override async Task OnInitializedAsync()
    {
        if (UserProfile.DisplayName is not null)
        {
            _displayName = UserProfile.DisplayName;
        }
        else
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _displayName = authState.User.FindFirst("displayName")?.Value
                        ?? authState.User.FindFirst(ClaimTypes.Name)?.Value
                        ?? authState.User.FindFirst(ClaimTypes.Email)?.Value
                        ?? "vous";
            UserProfile.SetDisplayName(_displayName);
        }

        UserProfile.OnChange += OnProfileChanged;
        _ = LoadTicketsAsync();
        _ = LoadActivityAsync();
        _ = LoadActiveSprintsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var storedTask = DashConfig.LoadAsync();
        var viewsTask  = SavedViewApi.GetAllAsync();
        await Task.WhenAll(storedTask, viewsTask);

        var stored = storedTask.Result;
        var views  = viewsTask.Result ?? [];

        _savedViewsById = views.ToDictionary(v => v.Id);
        _widgets = DashboardConfigService.Merge(stored, views.Select(v => v.Id));
        await DashConfig.SaveAsync(_widgets);

        _expanded.Add("my_tickets");
        _expanded.Add("active_sprints");
        _expanded.Add("recent_activity");

        // Expand saved views that are not collapsed by default, and pre-load their tickets
        var preLoadTasks = new List<Task>();
        foreach (var w in _widgets.Where(w => w.Kind == "saved_view" && w.ViewId.HasValue))
        {
            if (_savedViewsById.TryGetValue(w.ViewId!.Value, out var view) && !view.IsCollapsedByDefault)
            {
                _expanded.Add(DashboardConfigService.WidgetKey(w));
                preLoadTasks.Add(LoadViewTicketsAsync(w.ViewId.Value));
            }
        }

        _dashboardLoading = false;
        StateHasChanged();
    }

    private void OnProfileChanged()
    {
        _displayName = UserProfile.DisplayName;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => UserProfile.OnChange -= OnProfileChanged;

    private async Task LoadTicketsAsync()
    {
        try { _tickets = await TicketApi.GetAssignedToMeAsync(); }
        catch { _ticketsError = L["Error.Load"]; }
        finally { _ticketsLoading = false; StateHasChanged(); }
    }

    private async Task LoadActivityAsync()
    {
        try { _activityGroups = await ActivityApi.GetGroupedAsync(20); }
        catch { _activityError = L["Error.Load"]; }
        finally { _activityLoading = false; StateHasChanged(); }
    }

    private async Task ToggleWidget(string key)
    {
        if (_expanded.Contains(key)) { _expanded.Remove(key); return; }
        _expanded.Add(key);

        if (key.StartsWith("saved_view:", StringComparison.Ordinal))
        {
            var viewId = Guid.Parse(key["saved_view:".Length..]);
            if (!_viewTickets.ContainsKey(viewId))
                await LoadViewTicketsAsync(viewId);
        }
    }

    private async Task LoadActiveSprintsAsync()
    {
        try { _activeSprints = await SprintApi.GetActiveForUserAsync(); }
        catch { _activeSprints = []; }
        finally { _activeSprintsLoading = false; StateHasChanged(); }
    }

    private async Task LoadViewTicketsAsync(Guid viewId)
    {
        _viewLoading.Add(viewId);
        StateHasChanged();
        try
        {
            var tickets = await SavedViewApi.ExecuteAsync(viewId);
            _viewTickets[viewId] = tickets ?? [];
        }
        catch { _viewTickets[viewId] = []; }
        finally
        {
            _viewLoading.Remove(viewId);
            StateHasChanged();
        }
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private string WidgetLabel(DashboardWidget w) => w.Kind switch
    {
        "my_tickets"      => L["Home.MyTickets"],
        "active_sprints"  => L["Sprint.MySprints"],
        "recent_activity" => L["Home.Activity"],
        "saved_view"      => w.ViewId.HasValue && _savedViewsById.TryGetValue(w.ViewId.Value, out var v) ? v.Name : L["SavedView.Label"],
        _                 => w.Kind
    };

    private static string WidgetIcon(DashboardWidget w) => w.Kind switch
    {
        "my_tickets"      => "bi-ticket-detailed",
        "active_sprints"  => "bi-lightning-charge",
        "recent_activity" => "bi-clock-history",
        _                 => "bi-funnel"
    };

    private static string PriorityBadge(CardPriority p) => p switch
    {
        CardPriority.Low      => "badge-prio-low",
        CardPriority.Medium   => "badge-prio-medium",
        CardPriority.High     => "badge-prio-high",
        CardPriority.Critical => "badge-prio-critical",
        _                     => "badge-gray"
    };

    private static string ActivityIcon(string kind) => kind switch
    {
        "ticket_created"  => "bi-plus-circle-fill",
        "ticket_updated"  => "bi-pencil-fill",
        "comment_added"   => "bi-chat-left-fill",
        "attachment_added"=> "bi-paperclip",
        _                 => "bi-activity"
    };

    private static string ActivityIconColor(string kind) => kind switch
    {
        "ticket_created"  => "text-green-500",
        "ticket_updated"  => "text-amber-500",
        "comment_added"   => "text-blue-500",
        "attachment_added"=> "text-yellow-500",
        _                 => "text-gray-400"
    };

    private string ActivityLabel(string kind) => kind switch
    {
        "ticket_created"  => L["Home.Activity.Created"],
        "ticket_updated"  => L["Home.Activity.Updated"],
        "comment_added"   => L["Home.Activity.Commented"],
        "attachment_added"=> L["Home.Activity.Attachment"],
        _                 => kind
    };

    private string RelativeTime(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1)  return L["Time.JustNow"];
        if (diff.TotalMinutes < 60) return L["Time.MinutesAgo", (int)diff.TotalMinutes];
        if (diff.TotalHours < 24)   return L["Time.HoursAgo", (int)diff.TotalHours];
        if (diff.TotalDays < 7)     return L["Time.DaysAgo", (int)diff.TotalDays];
        return utc.ToLocalTime().ToString("d", System.Globalization.CultureInfo.CurrentCulture);
    }

    // ── Home attachment preview / open-in-tab ──────────────────────────────────

    private void OpenHomeAttachmentPreviewAsync(Guid attachmentId, string fileName)
    {
        _homePreviewAttachment = new AttachmentDto(
            attachmentId, fileName, "application/octet-stream", 0, "", "", DateTime.UtcNow, null, null, null);
    }
}
