@page "/"
@attribute [Authorize]
@implements IDisposable
@inject TicketApiClient TicketApi
@inject ActivityApiClient ActivityApi
@inject SavedViewApiClient SavedViewApi
@inject DashboardConfigService DashConfig
@inject AuthenticationStateProvider AuthStateProvider
@inject UserProfileService UserProfile
@inject NavigationManager Nav
@inject IStringLocalizer<AppResources> L

@using System.Security.Claims
@using Disciplaner.Application.DTOs.Ticket
@using Disciplaner.Application.DTOs.Activity
@using Disciplaner.Application.DTOs.SavedView
@using Disciplaner.Domain.Enums
@using Disciplaner.Web.Client.Models

<PageTitle>@L["Nav.Home"] — Disciplaner</PageTitle>

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-semibold text-gray-900">@L["Home.Welcome", _displayName ?? string.Empty]</h1>
        <p class="text-sm text-gray-500 mt-0.5">@DateTime.Now.ToString("dddd d MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</p>
    </div>
    <a href="/settings?tab=dashboard" class="text-xs text-gray-400 hover:text-gray-700 transition-colors flex items-center gap-1">
        <i class="bi bi-sliders"></i> @L["Home.Configure"]
    </a>
</div>

@if (_dashboardLoading)
{
    <LoadingSpinner />
}
else if (!_widgets.Any(w => w.Visible))
{
    <div class="surface py-12 text-center text-gray-400 text-sm">
        <i class="bi bi-layout-wtf text-3xl block mb-2"></i>
        @L["Home.NoDashboardWidgets"] <a href="/settings?tab=dashboard" class="text-blue-600">@L["Home.ConfigureDashboard"] →</a>
    </div>
}
else
{
    <div class="space-y-4">
        @foreach (var widget in _widgets.Where(w => w.Visible))
        {
            var w = widget;
            var wKey = DashboardConfigService.WidgetKey(w);

            <div class="surface">
                @* ── En-tête ── *@
                <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
                    <button class="flex-1 flex items-center gap-2 text-left"
                            @onclick="() => ToggleWidget(wKey)">
                        <i class="bi @(_expanded.Contains(wKey) ? "bi-chevron-down" : "bi-chevron-right") text-gray-400 text-xs shrink-0"></i>
                        <i class="bi @WidgetIcon(w) text-gray-500 text-sm shrink-0"></i>
                        <span class="text-sm font-semibold text-gray-800">@WidgetLabel(w)</span>
                        @if (w.Kind == "my_tickets" && _tickets is not null)
                        {
                            <span class="badge badge-gray shrink-0">@_tickets.Count</span>
                        }
                        @if (w.Kind == "saved_view" && w.ViewId.HasValue && _viewTickets.TryGetValue(w.ViewId.Value, out var ct))
                        {
                            <span class="badge badge-gray shrink-0">@ct.Count</span>
                        }
                    </button>
                    @if (w.Kind == "my_tickets")
                    {
                        <a href="/my-tickets" class="text-xs text-blue-600 hover:text-blue-800 shrink-0 transition-colors"
                           @onclick:stopPropagation>@L["Home.ViewAll"] →</a>
                    }
                </div>

                @* ── Corps ── *@
                @if (_expanded.Contains(wKey))
                {
                    @if (w.Kind == "my_tickets")
                    {
                        @if (_ticketsLoading)
                        {
                            <div class="p-4"><LoadingSpinner /></div>
                        }
                        else if (_ticketsError is not null)
                        {
                            <div class="p-4"><ErrorAlert Message="@_ticketsError" /></div>
                        }
                        else if (_tickets is null || _tickets.Count == 0)
                        {
                            <div class="py-10 text-center text-gray-400 text-sm">
                                <i class="bi bi-inbox text-2xl block mb-1"></i>
                                @L["Home.NoTickets"]
                            </div>
                        }
                        else
                        {
                            <div class="divide-y divide-gray-50">
                                @foreach (var ticket in _tickets.Take(7))
                                {
                                    var t = ticket;
                                    var ticketUrl = "/tickets/" + t.TicketRef;
                                    <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 cursor-pointer transition-colors"
                                         @onclick="() => Nav.NavigateTo(ticketUrl)">
                                        <span class="badge badge-dark font-mono shrink-0">@t.TicketRef</span>
                                        <span class="text-sm font-medium text-gray-800 flex-1 truncate">@t.Title</span>
                                        <span class="badge @PriorityBadge(t.Priority) shrink-0">@t.Priority</span>
                                        <span class="flex items-center gap-1 shrink-0">
                                            <span class="w-2 h-2 rounded-full inline-block" style="background:@t.Status.Color"></span>
                                            <span class="text-xs text-gray-500 hidden sm:block">@t.Status.Name</span>
                                        </span>
                                        @if (t.DueDate.HasValue)
                                        {
                                            var overdue = t.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                                            <span class="text-xs shrink-0 @(overdue ? "text-red-600 font-semibold" : "text-gray-400")">
                                                @t.DueDate.Value.ToLocalTime().ToString("dd/MM")
                                            </span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (w.Kind == "recent_activity")
                    {
                        <div class="overflow-y-auto" style="max-height:420px">
                            @if (_activityLoading)
                            {
                                <div class="p-4"><LoadingSpinner /></div>
                            }
                            else if (_activityError is not null)
                            {
                                <div class="p-4"><ErrorAlert Message="@_activityError" /></div>
                            }
                            else if (_activity is null || _activity.Count == 0)
                            {
                                <div class="py-10 text-center text-gray-400 text-sm">
                                    <i class="bi bi-calendar-x text-2xl block mb-1"></i>
                                    @L["Home.NoActivity"]
                                </div>
                            }
                            else
                            {
                                <div class="divide-y divide-gray-50">
                                    @foreach (var item in _activity)
                                    {
                                        var a = item;
                                        <div class="flex items-start gap-3 px-4 py-3">
                                            <span class="mt-0.5 shrink-0 @ActivityIconColor(a.Kind)">
                                                <i class="bi @ActivityIcon(a.Kind) text-sm"></i>
                                            </span>
                                            <div class="flex-1 min-w-0">
                                                <div class="text-xs font-semibold text-gray-700">@ActivityLabel(a.Kind)</div>
                                                <div class="text-xs text-gray-500 truncate">@a.Summary</div>
                                            </div>
                                            <div class="text-right shrink-0">
                                                @if (a.TicketRef is not null && a.TicketId.HasValue)
                                                {
                                                    <a href="/tickets/@a.TicketRef" class="badge badge-dark font-mono text-xs hover:opacity-80">@a.TicketRef</a>
                                                }
                                                <div class="text-gray-400" style="font-size:.68rem;margin-top:.1rem">@RelativeTime(a.OccurredAt)</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (w.Kind == "saved_view" && w.ViewId.HasValue)
                    {
                        var viewId = w.ViewId.Value;
                        @if (_viewLoading.Contains(viewId))
                        {
                            <div class="p-4"><LoadingSpinner /></div>
                        }
                        else if (_viewTickets.TryGetValue(viewId, out var svTickets))
                        {
                            @if (svTickets.Count == 0)
                            {
                                <div class="py-8 text-center text-gray-400 text-sm">
                                    <i class="bi bi-inbox text-2xl block mb-1"></i>
                                    @L["Home.NoViewTickets"]
                                </div>
                            }
                            else
                            {
                                <div class="divide-y divide-gray-50">
                                    @foreach (var ticket in svTickets)
                                    {
                                        var t = ticket;
                                        var svTicketUrl = "/tickets/" + t.TicketRef;
                                        <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 cursor-pointer transition-colors"
                                             @onclick="() => Nav.NavigateTo(svTicketUrl)">
                                            <span class="badge badge-dark font-mono shrink-0">@t.TicketRef</span>
                                            <span class="text-sm font-medium text-gray-800 flex-1 truncate">@t.Title</span>
                                            <span class="badge @PriorityBadge(t.Priority) shrink-0">@t.Priority</span>
                                            <span class="flex items-center gap-1 shrink-0">
                                                <span class="w-2 h-2 rounded-full inline-block" style="background:@t.Status.Color"></span>
                                                <span class="text-xs text-gray-500 hidden sm:block">@t.Status.Name</span>
                                            </span>
                                            @if (t.DueDate.HasValue)
                                            {
                                                var overdue = t.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                                                <span class="text-xs shrink-0 @(overdue ? "text-red-600 font-semibold" : "text-gray-400")">
                                                    @t.DueDate.Value.ToLocalTime().ToString("dd/MM")
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                }
            </div>
        }
    </div>
}

@code {
    private string? _displayName;

    // ── Built-in widget data ───────────────────────────────────────────────────
    private List<TicketDto>? _tickets;
    private List<ActivityItemDto>? _activity;
    private bool _ticketsLoading = true;
    private bool _activityLoading = true;
    private string? _ticketsError;
    private string? _activityError;

    // ── Dashboard config ───────────────────────────────────────────────────────
    private List<DashboardWidget> _widgets = [];
    private Dictionary<Guid, SavedViewDto> _savedViewsById = [];
    private bool _dashboardLoading = true;
    private readonly HashSet<string> _expanded = [];

    // ── Saved view tickets (lazy) ──────────────────────────────────────────────
    private readonly HashSet<Guid> _viewLoading = [];
    private readonly Dictionary<Guid, List<TicketDto>> _viewTickets = [];

    protected override async Task OnInitializedAsync()
    {
        if (UserProfile.DisplayName is not null)
        {
            _displayName = UserProfile.DisplayName;
        }
        else
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _displayName = authState.User.FindFirst("displayName")?.Value
                        ?? authState.User.FindFirst(ClaimTypes.Name)?.Value
                        ?? authState.User.FindFirst(ClaimTypes.Email)?.Value
                        ?? "vous";
            UserProfile.SetDisplayName(_displayName);
        }

        UserProfile.OnChange += OnProfileChanged;
        _ = LoadTicketsAsync();
        _ = LoadActivityAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var storedTask = DashConfig.LoadAsync();
        var viewsTask  = SavedViewApi.GetAllAsync();
        await Task.WhenAll(storedTask, viewsTask);

        var stored = storedTask.Result;
        var views  = viewsTask.Result ?? [];

        _savedViewsById = views.ToDictionary(v => v.Id);
        _widgets = DashboardConfigService.Merge(stored, views.Select(v => v.Id));
        await DashConfig.SaveAsync(_widgets);

        _expanded.Add("my_tickets");
        _expanded.Add("recent_activity");

        // Expand saved views that are not collapsed by default, and pre-load their tickets
        var preLoadTasks = new List<Task>();
        foreach (var w in _widgets.Where(w => w.Kind == "saved_view" && w.ViewId.HasValue))
        {
            if (_savedViewsById.TryGetValue(w.ViewId!.Value, out var view) && !view.IsCollapsedByDefault)
            {
                _expanded.Add(DashboardConfigService.WidgetKey(w));
                preLoadTasks.Add(LoadViewTicketsAsync(w.ViewId.Value));
            }
        }

        _dashboardLoading = false;
        StateHasChanged();
    }

    private void OnProfileChanged()
    {
        _displayName = UserProfile.DisplayName;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => UserProfile.OnChange -= OnProfileChanged;

    private async Task LoadTicketsAsync()
    {
        try { _tickets = await TicketApi.GetAssignedToMeAsync(); }
        catch { _ticketsError = L["Error.Load"]; }
        finally { _ticketsLoading = false; StateHasChanged(); }
    }

    private async Task LoadActivityAsync()
    {
        try { _activity = await ActivityApi.GetRecentAsync(20); }
        catch { _activityError = L["Error.Load"]; }
        finally { _activityLoading = false; StateHasChanged(); }
    }

    private async Task ToggleWidget(string key)
    {
        if (_expanded.Contains(key)) { _expanded.Remove(key); return; }
        _expanded.Add(key);

        if (key.StartsWith("saved_view:", StringComparison.Ordinal))
        {
            var viewId = Guid.Parse(key["saved_view:".Length..]);
            if (!_viewTickets.ContainsKey(viewId))
                await LoadViewTicketsAsync(viewId);
        }
    }

    private async Task LoadViewTicketsAsync(Guid viewId)
    {
        _viewLoading.Add(viewId);
        StateHasChanged();
        try
        {
            var tickets = await SavedViewApi.ExecuteAsync(viewId);
            _viewTickets[viewId] = tickets ?? [];
        }
        catch { _viewTickets[viewId] = []; }
        finally
        {
            _viewLoading.Remove(viewId);
            StateHasChanged();
        }
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private string WidgetLabel(DashboardWidget w) => w.Kind switch
    {
        "my_tickets"      => L["Home.MyTickets"],
        "recent_activity" => L["Home.Activity"],
        "saved_view"      => w.ViewId.HasValue && _savedViewsById.TryGetValue(w.ViewId.Value, out var v) ? v.Name : L["SavedView.Label"],
        _                 => w.Kind
    };

    private static string WidgetIcon(DashboardWidget w) => w.Kind switch
    {
        "my_tickets"      => "bi-ticket-detailed",
        "recent_activity" => "bi-clock-history",
        _                 => "bi-funnel"
    };

    private static string PriorityBadge(CardPriority p) => p switch
    {
        CardPriority.Low      => "badge-prio-low",
        CardPriority.Medium   => "badge-prio-medium",
        CardPriority.High     => "badge-prio-high",
        CardPriority.Critical => "badge-prio-critical",
        _                     => "badge-gray"
    };

    private static string ActivityIcon(string kind) => kind switch
    {
        "ticket_created" => "bi-plus-circle-fill",
        "ticket_updated" => "bi-pencil-fill",
        "comment_added"  => "bi-chat-left-fill",
        _                => "bi-activity"
    };

    private static string ActivityIconColor(string kind) => kind switch
    {
        "ticket_created" => "text-green-500",
        "ticket_updated" => "text-amber-500",
        "comment_added"  => "text-blue-500",
        _                => "text-gray-400"
    };

    private string ActivityLabel(string kind) => kind switch
    {
        "ticket_created" => L["Home.Activity.Created"],
        "ticket_updated" => L["Home.Activity.Updated"],
        "comment_added"  => L["Home.Activity.Commented"],
        _                => kind
    };

    private string RelativeTime(DateTime utc)
    {
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1)  return L["Time.JustNow"];
        if (diff.TotalMinutes < 60) return L["Time.MinutesAgo", (int)diff.TotalMinutes];
        if (diff.TotalHours < 24)   return L["Time.HoursAgo", (int)diff.TotalHours];
        if (diff.TotalDays < 7)     return L["Time.DaysAgo", (int)diff.TotalDays];
        return utc.ToLocalTime().ToString("d", System.Globalization.CultureInfo.CurrentCulture);
    }
}
