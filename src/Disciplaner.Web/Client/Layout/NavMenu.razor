@using System.Security.Claims
@inject IStringLocalizer<AppResources> L
@inject NavigationManager Nav
@implements IDisposable

<header class="sticky top-0 z-50" style="background:#24292f">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center h-14">
            @* Brand *@
            <a href="/" class="font-semibold text-white text-sm mr-4 flex items-center gap-1.5 shrink-0 hover:text-gray-200 transition-colors">
                <span style="font-size:1rem">&#9654;</span> Disciplaner
            </a>

            @* Desktop primary links — hidden on mobile *@
            <div class="hidden sm:flex items-center gap-1 flex-1 min-w-0">
                <NavLink class="topnav-link" href="" Match="NavLinkMatch.All">@L["Nav.Home"]</NavLink>
                <NavLink class="topnav-link" href="boards">@L["Nav.Boards"]</NavLink>
                <NavLink class="topnav-link" href="projects">@L["Nav.Projects"]</NavLink>
                <NavLink class="topnav-link" href="my-tickets">@L["Nav.MyTickets"]</NavLink>
                <NavLink class="topnav-link" href="labels">@L["Nav.Labels"]</NavLink>

                @* Right side — desktop *@
                <div class="ml-auto flex items-center gap-3 shrink-0">
                    <AuthorizeView>
                        <Authorized>
                            <span class="text-gray-400 text-sm hidden md:block truncate max-w-[140px]">
                                @context.User.FindFirst("displayName")?.Value
                            </span>
                            <NavLink class="topnav-link" href="settings" title="Settings">
                                <i class="bi bi-gear"></i>
                            </NavLink>
                            <button class="topnav-link" @onclick="OnLogout">@L["Nav.Logout"]</button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>

            @* Mobile right: user name + hamburger *@
            <div class="ml-auto sm:hidden flex items-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <span class="text-gray-400 text-xs truncate max-w-[100px]">
                            @context.User.FindFirst("displayName")?.Value
                        </span>
                        <button class="topnav-link px-2 py-1.5 text-lg leading-none"
                                @onclick="ToggleMenu"
                                aria-label="Menu"
                                aria-expanded="@_menuOpen">
                            <i class="bi @(_menuOpen ? "bi-x-lg" : "bi-list")"></i>
                        </button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>
    </div>

    @* Mobile dropdown *@
    @if (_menuOpen)
    {
        <div class="sm:hidden" style="background:#2d333b; border-top:1px solid rgba(255,255,255,.08)">
            <div class="px-4 py-3 flex flex-col gap-1">
                <NavLink class="mobile-nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">
                    <i class="bi bi-house mr-2"></i>@L["Nav.Home"]
                </NavLink>
                <NavLink class="mobile-nav-link" href="boards" @onclick="CloseMenu">
                    <i class="bi bi-kanban mr-2"></i>@L["Nav.Boards"]
                </NavLink>
                <NavLink class="mobile-nav-link" href="projects" @onclick="CloseMenu">
                    <i class="bi bi-folder mr-2"></i>@L["Nav.Projects"]
                </NavLink>
                <NavLink class="mobile-nav-link" href="my-tickets" @onclick="CloseMenu">
                    <i class="bi bi-ticket-perforated mr-2"></i>@L["Nav.MyTickets"]
                </NavLink>
                <NavLink class="mobile-nav-link" href="labels" @onclick="CloseMenu">
                    <i class="bi bi-tag mr-2"></i>@L["Nav.Labels"]
                </NavLink>

                <div class="border-t border-white/10 mt-2 pt-2 flex items-center justify-between">
                    <NavLink class="mobile-nav-link flex-1" href="settings" @onclick="CloseMenu">
                        <i class="bi bi-gear mr-2"></i>Settings
                    </NavLink>
                    <button class="text-gray-300 text-sm px-3 py-2 rounded-md hover:bg-white/10 transition-colors"
                            @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right mr-1"></i>@L["Nav.Logout"]
                    </button>
                </div>
            </div>
        </div>
    }
</header>

@code {
    [Parameter] public EventCallback OnLogout { get; set; }

    private bool _menuOpen;

    protected override void OnInitialized()
        => Nav.LocationChanged += OnLocationChanged;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;

    private async Task HandleLogout()
    {
        _menuOpen = false;
        await OnLogout.InvokeAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;
}
