<div class="sidebar d-flex flex-column h-100">
    <div class="sidebar-brand px-3 py-3 d-flex align-items-center gap-2">
        <span class="fw-bold fs-5 text-white">&#9654; Disciplaner</span>
        <button class="btn btn-sm text-white ms-auto d-md-none" @onclick="ToggleNavMenu" title="Menu">
            &#9776;
        </button>
    </div>

    <div class="@NavMenuCssClass flex-grow-1 overflow-auto">
        <nav class="nav flex-column px-2 py-2 gap-1">
            <NavLink class="nav-link sidebar-link" href="" Match="NavLinkMatch.All">
                &#9632; Tableaux
            </NavLink>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <hr class="border-secondary my-2" />
                    <span class="sidebar-section-label px-2">Administration</span>
                    <NavLink class="nav-link sidebar-link" href="admin/users">
                        &#128100; Utilisateurs
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>
    </div>
</div>

@code {
    private bool collapseNavMenu = false;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
