@using System.Security.Claims

<header class="sticky top-0 z-50" style="background:#24292f">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex items-center h-14 gap-1">
            @* Brand *@
            <a href="/" class="font-semibold text-white text-sm mr-4 flex items-center gap-1.5 shrink-0 hover:text-gray-200 transition-colors">
                <span style="font-size:1rem">&#9654;</span> Disciplaner
            </a>

            @* Primary links *@
            <NavLink class="topnav-link" href="" Match="NavLinkMatch.All">Accueil</NavLink>
            <NavLink class="topnav-link" href="boards">Tableaux</NavLink>
            <NavLink class="topnav-link" href="projects">Projets</NavLink>
            <NavLink class="topnav-link" href="my-tickets">Mes tickets</NavLink>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <span class="text-gray-600 mx-1">|</span>
                    <NavLink class="topnav-link" href="admin/users">Utilisateurs</NavLink>
                </Authorized>
            </AuthorizeView>

            @* Right side *@
            <div class="ml-auto flex items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <span class="text-gray-400 text-sm hidden sm:block">
                            @context.User.FindFirst("displayName")?.Value
                        </span>
                        <button class="topnav-link" @onclick="OnLogout">Déconnexion</button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnLogout { get; set; }
}
