@using System.Security.Claims
@inject IStringLocalizer<AppResources> L
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@* ── Mobile top bar ──────────────────────────────────────────────────────── *@
<div class="sidebar-mobile-bar">
    <button class="sidebar-mobile-toggle" @onclick="ToggleMobileMenu" aria-label="@L["Nav.Menu"]">
        <i class="bi @(_mobileOpen ? "bi-x-lg" : "bi-list")"></i>
    </button>
    <a href="/" class="sidebar-brand-mini">
        <span class="sidebar-brand-icon">&#9654;</span>
        <span>Disciplaner</span>
    </a>
    <AuthorizeView>
        <Authorized>
            <span class="sidebar-mobile-username">@context.User.FindFirst("displayName")?.Value</span>
        </Authorized>
    </AuthorizeView>
</div>

@* ── Mobile overlay ───────────────────────────────────────────────────────── *@
@if (_mobileOpen)
{
    <div class="sidebar-overlay" @onclick="CloseMobileMenu"></div>
}

@* ── Sidebar ──────────────────────────────────────────────────────────────── *@
<aside class="sidebar @(_collapsed ? "sidebar-collapsed" : "") @(_mobileOpen ? "sidebar-mobile-open" : "")">

    @* Brand *@
    <div class="sidebar-brand">
        <a href="/" class="sidebar-brand-link" title="Disciplaner">
            <span class="sidebar-brand-icon">&#9654;</span>
            @if (!_collapsed)
            {
                <span class="sidebar-brand-text">Disciplaner</span>
            }
        </a>
        <button class="sidebar-collapse-btn" @onclick="ToggleCollapse" title="@(_collapsed ? "Agrandir" : "Reduire")">
            <i class="bi @(_collapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
        </button>
    </div>

    @* Nav section *@
    <nav class="sidebar-nav">
        <SidebarLink Href="" Match="NavLinkMatch.All" Icon="bi-house-door-fill" Label="@L["Nav.Home"]" Collapsed="_collapsed" OnClick="CloseMobileMenu" />
        <SidebarLink Href="boards" Icon="bi-kanban-fill" Label="@L["Nav.Boards"]" Collapsed="_collapsed" OnClick="CloseMobileMenu" />
        <SidebarLink Href="projects" Icon="bi-folder-fill" Label="@L["Nav.Projects"]" Collapsed="_collapsed" OnClick="CloseMobileMenu" />
        <SidebarLink Href="my-tickets" Icon="bi-ticket-perforated-fill" Label="@L["Nav.MyTickets"]" Collapsed="_collapsed" OnClick="CloseMobileMenu" />
        <SidebarLink Href="calendar" Icon="bi-calendar3" Label="@L["Nav.Calendar"]" Collapsed="_collapsed" OnClick="CloseMobileMenu" />
        <SidebarLink Href="labels" Icon="bi-tags-fill" Label="@L["Nav.Labels"]" Collapsed="_collapsed" OnClick="CloseMobileMenu" />
        <AuthorizeView Roles="Admin">
            <Authorized>
                <SidebarLink Href="admin/users" Icon="bi-people-fill" Label="@L["Nav.Admin"]" Collapsed="_collapsed" OnClick="CloseMobileMenu" />
            </Authorized>
        </AuthorizeView>
    </nav>

    @* Bottom: user info + logout *@
    <div class="sidebar-footer">
        <AuthorizeView>
            <Authorized>
                @if (!_collapsed)
                {
                    <div class="sidebar-user">
                        <a href="/settings" class="sidebar-user-avatar" @onclick="CloseMobileMenu" title="@L["Nav.Settings"]"
                           style="text-decoration:none;cursor:pointer">
                            @(context.User.FindFirst("displayName")?.Value?.FirstOrDefault().ToString().ToUpper() ?? "U")
                        </a>
                        <span class="sidebar-user-name truncate flex-1">@context.User.FindFirst("displayName")?.Value</span>
                        <button class="sidebar-icon-btn sidebar-logout-btn" @onclick="HandleLogout" title="@L["Nav.Logout"]">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </div>
                }
                else
                {
                    <div class="flex flex-col items-center gap-1 py-1">
                        <a href="/settings" class="sidebar-icon-btn" @onclick="CloseMobileMenu" title="@L["Nav.Settings"]">
                            <div class="sidebar-user-avatar sidebar-user-avatar-sm">
                                @(context.User.FindFirst("displayName")?.Value?.FirstOrDefault().ToString().ToUpper() ?? "U")
                            </div>
                        </a>
                        <button class="sidebar-icon-btn sidebar-logout-btn" @onclick="HandleLogout" title="@L["Nav.Logout"]">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </div>
</aside>

@code {
    [Parameter] public EventCallback OnLogout { get; set; }

    private bool _collapsed;
    private bool _mobileOpen;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "sidebar:collapsed");
            _collapsed = stored == "true";
        }
        catch { /* SSR / prerender */ }
    }

    private async Task ToggleCollapse()
    {
        _collapsed = !_collapsed;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "sidebar:collapsed", _collapsed.ToString().ToLower()); }
        catch { }
    }

    private void ToggleMobileMenu() => _mobileOpen = !_mobileOpen;
    private void CloseMobileMenu() => _mobileOpen = false;

    private async Task HandleLogout()
    {
        _mobileOpen = false;
        await OnLogout.InvokeAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _mobileOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;
}
