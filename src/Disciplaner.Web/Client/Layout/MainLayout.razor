@inherits LayoutComponentBase
@inject AuthApiClient Auth
@inject NavigationManager Nav

<div class="app-shell d-flex" style="min-height:100vh">
    <aside class="app-sidebar d-flex flex-column" style="width:220px; flex-shrink:0; background:#1e293b">
        <NavMenu />
    </aside>

    <div class="d-flex flex-column flex-grow-1 overflow-hidden">
        <header class="app-topbar d-flex align-items-center justify-content-end px-4 py-2 border-bottom bg-white shadow-sm"
                style="height:52px">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3 text-muted small fw-semibold">@context.User.FindFirst("displayName")?.Value</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LogoutAsync">Déconnexion</button>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="flex-grow-1 overflow-auto p-4">
            @Body
        </main>
    </div>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
