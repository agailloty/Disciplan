@inherits LayoutComponentBase
@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject ThemeService Theme
@implements IDisposable
@using System.Security.Claims

<div class="app-shell">
    <NavMenu OnLogout="LogoutAsync" />
    <main class="app-main">
        <header class="app-topbar">
            <div class="app-topbar-right">
                <a href="/settings" class="topbar-theme-btn" title="Paramètres">
                    <i class="bi bi-gear-fill"></i>
                </a>
                <button class="topbar-theme-btn" @onclick="ToggleDark"
                        title="@(Theme.IsDark ? "Passer en mode clair" : "Passer en mode sombre")">
                    <i class="bi @(Theme.IsDark ? "bi-sun-fill" : "bi-moon-fill")"></i>
                </button>
            </div>
        </header>
        <div class="app-content">
            @Body
        </div>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Theme.LoadAsync();
        Theme.OnChange += StateHasChanged;
    }

    public void Dispose() => Theme.OnChange -= StateHasChanged;

    private async Task ToggleDark()
    {
        await Theme.ToggleDarkAsync();
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
