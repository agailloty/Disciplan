@inherits LayoutComponentBase
@inject AuthApiClient Auth
@inject NavigationManager Nav
@inject ThemeService Theme
@inject IJSRuntime JS
@inject IStringLocalizer<AppResources> L
@implements IDisposable
@using System.Security.Claims

<div class="app-shell">
    @if (_updateAvailable)
    {
        <div class="pwa-update-banner">
            <i class="bi bi-arrow-repeat"></i>
            <span>@L["Pwa.UpdateAvailable"]</span>
            <button class="btn btn-sm" style="background:rgba(255,255,255,.2);color:#fff;border:none" @onclick="ApplyUpdateAsync">
                @L["Pwa.Update"]
            </button>
            <button class="pwa-update-dismiss" @onclick="() => _updateAvailable = false" aria-label="Fermer">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }
    <NavMenu OnLogout="LogoutAsync" />
    <main class="app-main">
        <header class="app-topbar">
            <div class="workspace-breadcrumb"><i class="bi bi-grid-1x2"></i><span>Disciplaner</span><span class="breadcrumb-divider">/</span><strong>@L[CurrentSection]</strong></div>
            <div class="app-topbar-right">
                <button class="btn btn-primary btn-sm" @onclick="() => _showQuickCreate = true"><i class="bi bi-plus-lg"></i> @L["Create"]</button>
                <a href="/settings" class="topbar-theme-btn" title="@L["Nav.Settings"]">
                    <i class="bi bi-gear-fill"></i>
                </a>
                <button class="topbar-theme-btn" @onclick="ToggleDark"
                        title="@(Theme.IsDark ? L["Settings.Theme.ToLight"].Value : L["Settings.Theme.ToDark"].Value)">
                    <i class="bi @(Theme.IsDark ? "bi-sun-fill" : "bi-moon-fill")"></i>
                </button>
            </div>
        </header>
        <div class="app-content">
            @Body
        </div>
    </main>
</div>

<QuickCreateModal Visible="_showQuickCreate" OnClose="() => _showQuickCreate = false" />

@code {
    private bool _showQuickCreate;
    private string CurrentSection => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Split('/')[0] switch
    {
        "projects" => "Nav.Projects", "boards" => "Nav.Boards",
        "my-tickets" or "tickets" => "Nav.MyTickets", "calendar" => "Nav.Calendar",
        "labels" => "Nav.Labels", "settings" => "Nav.Settings", "admin" => "Nav.Admin",
        "sprints" => "Home.ActiveSprints", _ => "Nav.Home"
    };
    private bool _updateAvailable;
    private DotNetObjectReference<MainLayout>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        await Theme.LoadAsync();
        Theme.OnChange += StateHasChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("disciplaner.registerPwaUpdateCallback", _selfRef);
        }
    }

    [JSInvokable]
    public void NotifyUpdateAvailable()
    {
        _updateAvailable = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task ApplyUpdateAsync()
    {
        await JS.InvokeVoidAsync("disciplaner.applyPwaUpdate");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Theme.OnChange -= StateHasChanged;
        _selfRef?.Dispose();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private async Task ToggleDark()
    {
        await Theme.ToggleDarkAsync();
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
