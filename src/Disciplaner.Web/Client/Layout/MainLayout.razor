@inherits LayoutComponentBase
@inject AuthApiClient Auth
@inject NavigationManager Nav
@using System.Security.Claims

<div class="min-h-screen flex flex-col">
    <NavMenu OnLogout="LogoutAsync" />
    <main class="flex-1 w-full max-w-screen-xl mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-8" style="padding-bottom: calc(1.25rem + env(safe-area-inset-bottom))">
        @Body
    </main>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}
