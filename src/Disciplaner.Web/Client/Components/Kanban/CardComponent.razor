@inject KanbanDragState DragState
@inject IJSRuntime JS
@inject CardApiClient CardApi
@inject CommentApiClient CommentApi
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Disciplaner.Application.DTOs.Comment

@* ── Card tile ── *@
<div class="kanban-card card shadow-sm priority-@PriorityCssName @(_isDragging ? "opacity-50" : "")"
     draggable="true"
     @ondragstart="OnDragStart"
     @ondragend="OnDragEnd"
     @onclick="OnShowDetailAsync"
     style="cursor:pointer">
    <div class="card-body p-2">
        <div class="d-flex justify-content-between align-items-start gap-1">
            <span class="fw-semibold small text-dark flex-grow-1 lh-sm">@Card.Title</span>
            <div class="card-actions d-flex gap-1 flex-shrink-0" @onclick:stopPropagation>
                <button class="btn-icon" title="Modifier" @onclick="ShowEditModal">✎</button>
                <button class="btn-icon btn-icon-danger" title="Supprimer" @onclick="ShowDeleteConfirm">✕</button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Card.Description))
        {
            <p class="card-desc-preview text-muted mt-1 mb-1">@Card.Description</p>
        }
        <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-1">
            <span class="badge @PriorityBadgeClass" style="font-size:.68rem">@PriorityLabel</span>
            @if (Card.DueDate.HasValue)
            {
                var overdue = Card.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                <small class="@(overdue ? "text-danger fw-semibold" : "text-muted")">
                    &#128197; @Card.DueDate.Value.ToLocalTime().ToString("dd/MM")
                </small>
            }
        </div>
    </div>
</div>

@* ── Detail modal ── *@
<Modal Title="@Card.Title" Visible="_showDetail" OnClose="() => _showDetail = false" SizeClass="modal-lg">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <span class="badge @PriorityBadgeClass px-2 py-1">@PriorityLabel</span>
        @if (!string.IsNullOrWhiteSpace(ColumnName))
        {
            <span class="badge bg-light text-dark border px-2 py-1">&#9642; @ColumnName</span>
        }
        @if (Card.DueDate.HasValue)
        {
            var overdue = Card.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
            <span class="badge @(overdue ? "bg-danger" : "bg-secondary") px-2 py-1">
                &#128197; @Card.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")
                @(overdue ? " — en retard" : "")
            </span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Card.Description))
    {
        <div class="mb-3">
            <p class="form-label fw-semibold text-muted small text-uppercase mb-1">Description</p>
            <div class="card-detail-description">@Card.Description</div>
        </div>
    }
    else
    {
        <p class="text-muted fst-italic small mb-3">Aucune description.</p>
    }

    <div class="text-muted small mt-2 d-flex gap-3 flex-wrap border-top pt-2">
        <span>Créée le @Card.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        @if (Card.UpdatedAt.HasValue)
        {
            <span>Modifiée le @Card.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        }
    </div>

    @* ── Comments ── *@
    <div class="mt-4">
        <p class="form-label fw-semibold text-muted small text-uppercase mb-2">Commentaires</p>

        @if (_commentsLoading)
        {
            <p class="text-muted small">Chargement…</p>
        }
        else if (_comments.Count == 0)
        {
            <p class="text-muted fst-italic small">Aucun commentaire pour l'instant.</p>
        }
        else
        {
            <div class="comment-list d-flex flex-column gap-2 mb-3">
                @foreach (var c in _comments)
                {
                    var comment = c;
                    <div class="comment-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fw-semibold small">@comment.AuthorName</span>
                                <span class="text-muted small ms-2">@comment.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                @if (comment.UpdatedAt.HasValue)
                                {
                                    <span class="text-muted small ms-1">(modifié)</span>
                                }
                            </div>
                            @if (comment.AuthorId == _currentUserId)
                            {
                                <div class="d-flex gap-1">
                                    <button class="btn-icon" title="Modifier" @onclick="() => StartEditComment(comment)">✎</button>
                                    <button class="btn-icon btn-icon-danger" title="Supprimer" @onclick="() => DeleteCommentAsync(comment.Id)">✕</button>
                                </div>
                            }
                        </div>
                        @if (_editingCommentId == comment.Id)
                        {
                            <div class="mt-1">
                                <textarea class="form-control form-control-sm" rows="2" @bind="_editCommentContent"></textarea>
                                <div class="d-flex gap-1 mt-1 justify-content-end">
                                    <button class="btn btn-sm btn-secondary py-0" @onclick="() => _editingCommentId = null">Annuler</button>
                                    <button class="btn btn-sm btn-primary py-0" @onclick="() => SaveEditCommentAsync(comment.Id)" disabled="@_commentBusy">Enregistrer</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="comment-content mb-0">@comment.Content</p>
                        }
                    </div>
                }
            </div>
        }

        <div class="comment-input-row d-flex gap-2 align-items-end">
            <textarea class="form-control form-control-sm flex-grow-1" rows="2"
                      placeholder="Ajouter un commentaire…"
                      @bind="_newCommentContent"
                      disabled="@_commentBusy"></textarea>
            <button class="btn btn-sm btn-primary align-self-end"
                    @onclick="AddCommentAsync"
                    disabled="@(string.IsNullOrWhiteSpace(_newCommentContent) || _commentBusy)">
                Envoyer
            </button>
        </div>
        @if (_commentError is not null)
        {
            <div class="alert alert-danger py-1 small mt-2">@_commentError</div>
        }
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 border-top pt-3">
        <button class="btn btn-sm btn-outline-danger" @onclick="() => { _showDetail = false; ShowDeleteConfirm(); }">
            Supprimer
        </button>
        <button class="btn btn-sm btn-primary" @onclick="() => { _showDetail = false; ShowEditModal(); }">
            ✎ Modifier
        </button>
    </div>
</Modal>

@* ── Edit modal ── *@
<Modal Title="Modifier la carte" Visible="_showEdit" OnClose="() => _showEdit = false">
    <EditForm Model="_form" OnValidSubmit="UpdateCardAsync">
        <DataAnnotationsValidator />
        <div class="mb-3">
            <label class="form-label">Titre</label>
            <InputText @bind-Value="_form.Title" class="form-control" />
            <ValidationMessage For="() => _form.Title" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <InputTextArea @bind-Value="_form.Description" class="form-control" rows="4" />
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Priorité</label>
                <InputSelect @bind-Value="_form.Priority" class="form-select">
                    @foreach (var p in Enum.GetValues<CardPriority>())
                    {
                        <option value="@p">@PriorityLabelFor(p)</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6">
                <label class="form-label">Échéance</label>
                <InputDate @bind-Value="_form.DueDate" class="form-control" />
            </div>
        </div>
        @if (_editError is not null)
        {
            <div class="alert alert-danger py-1 small mt-3">@_editError</div>
        }
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-secondary" @onclick="() => _showEdit = false">Annuler</button>
            <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "…" : "Enregistrer")</button>
        </div>
    </EditForm>
</Modal>

@* ── Delete confirmation ── *@
<ConfirmModal Title="Supprimer la carte"
              Message="@($"Supprimer \"{Card.Title}\" ?")"
              Visible="_showDelete"
              OnCancel="() => _showDelete = false"
              OnConfirm="DeleteCardAsync" />

@code {
    [Parameter, EditorRequired] public CardDto Card { get; set; } = default!;
    [Parameter, EditorRequired] public Guid ColumnId { get; set; }
    [Parameter] public string ColumnName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChanged { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // ── Drag ──────────────────────────────────────────────────────────────────
    private bool _isDragging;

    private void OnDragStart()
    {
        _isDragging = true;
        DragState.Begin(Card, ColumnId);
        _ = JS.InvokeVoidAsync("kanban.setDragData", Card.Id.ToString());
    }

    private void OnDragEnd()
    {
        _isDragging = false;
        if (DragState.IsDragging) DragState.Cancel();
    }

    // ── Detail + Comments ─────────────────────────────────────────────────────
    private bool _showDetail;
    private string? _currentUserId;
    private List<CommentDto> _comments = [];
    private bool _commentsLoading;
    private string? _newCommentContent;
    private bool _commentBusy;
    private string? _commentError;
    private Guid? _editingCommentId;
    private string _editCommentContent = string.Empty;

    private async Task OnShowDetailAsync()
    {
        _showDetail = true;
        var authState = await AuthState;
        _currentUserId = authState.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value
            ?? authState.User.Claims.FirstOrDefault(c => c.Type == "sub")?.Value;
        await LoadCommentsAsync();
    }

    private async Task LoadCommentsAsync()
    {
        _commentsLoading = true;
        _commentError = null;
        try { _comments = (await CommentApi.GetByCardAsync(Card.Id)).ToList(); }
        catch { _commentError = "Impossible de charger les commentaires."; }
        finally { _commentsLoading = false; }
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCommentContent)) return;
        _commentBusy = true; _commentError = null;
        try
        {
            await CommentApi.CreateAsync(Card.Id, new CreateCommentRequest(_newCommentContent.Trim()));
            _newCommentContent = null;
            await LoadCommentsAsync();
        }
        catch { _commentError = "Impossible d'ajouter le commentaire."; }
        finally { _commentBusy = false; }
    }

    private void StartEditComment(CommentDto c)
    {
        _editingCommentId = c.Id;
        _editCommentContent = c.Content;
    }

    private async Task SaveEditCommentAsync(Guid commentId)
    {
        if (string.IsNullOrWhiteSpace(_editCommentContent)) return;
        _commentBusy = true; _commentError = null;
        try
        {
            await CommentApi.UpdateAsync(commentId, new UpdateCommentRequest(_editCommentContent.Trim()));
            _editingCommentId = null;
            await LoadCommentsAsync();
        }
        catch { _commentError = "La modification a échoué."; }
        finally { _commentBusy = false; }
    }

    private async Task DeleteCommentAsync(Guid commentId)
    {
        _commentBusy = true; _commentError = null;
        try
        {
            await CommentApi.DeleteAsync(commentId);
            await LoadCommentsAsync();
        }
        catch { _commentError = "La suppression a échoué."; }
        finally { _commentBusy = false; }
    }

    // ── Edit ──────────────────────────────────────────────────────────────────
    private bool _showEdit;
    private bool _busy;
    private string? _editError;
    private CardForm _form = new();

    private sealed class CardForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.MaxLength(2000)]
        public string? Description { get; set; }
        public CardPriority Priority { get; set; } = CardPriority.Medium;
        public DateTime? DueDate { get; set; }
    }

    private void ShowEditModal()
    {
        _form = new() { Title = Card.Title, Description = Card.Description, Priority = Card.Priority, DueDate = Card.DueDate };
        _editError = null;
        _showEdit = true;
    }

    private async Task UpdateCardAsync()
    {
        _busy = true; _editError = null;
        try
        {
            await CardApi.UpdateAsync(Card.Id,
                new UpdateCardRequest(_form.Title, _form.Description, _form.Priority, _form.DueDate));
            _showEdit = false;
            await OnChanged.InvokeAsync();
        }
        catch { _editError = "La mise à jour a échoué."; }
        finally { _busy = false; }
    }

    // ── Delete ────────────────────────────────────────────────────────────────
    private bool _showDelete;
    private void ShowDeleteConfirm() => _showDelete = true;

    private async Task DeleteCardAsync()
    {
        try { await CardApi.DeleteAsync(Card.Id); await OnChanged.InvokeAsync(); }
        catch { }
        finally { _showDelete = false; }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private string PriorityCssName => Card.Priority.ToString().ToLower();

    private string PriorityLabel => PriorityLabelFor(Card.Priority);

    private static string PriorityLabelFor(CardPriority p) => p switch
    {
        CardPriority.Low      => "Faible",
        CardPriority.Medium   => "Moyenne",
        CardPriority.High     => "Haute",
        CardPriority.Critical => "Critique",
        _                     => p.ToString()
    };

    private string PriorityBadgeClass => Card.Priority switch
    {
        CardPriority.Low      => "bg-secondary",
        CardPriority.Medium   => "bg-info text-dark",
        CardPriority.High     => "bg-warning text-dark",
        CardPriority.Critical => "bg-danger",
        _                     => "bg-secondary"
    };
}

