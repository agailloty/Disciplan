@inject KanbanDragState DragState
@inject IJSRuntime JS
@inject CardApiClient CardApi
@inject CommentApiClient CommentApi
@inject UserApiClient UserApi
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Disciplaner.Application.DTOs.Comment
@using Disciplaner.Application.DTOs.User
@inject IStringLocalizer<AppResources> L

@* ── Card tile ── *@
<div class="kanban-card kc-prio-@PriorityCssName @(_isDragging ? "opacity-50" : "")"
     draggable="true"
     @ondragstart="OnDragStart"
     @ondragend="OnDragEnd"
     @onclick="OnShowDetailAsync"
     style="cursor:pointer">
    <div class="flex items-start justify-between gap-1">
        <span class="text-sm font-medium text-gray-900 leading-snug flex-1">@Card.Title</span>
        <div class="card-actions flex gap-1 shrink-0" @onclick:stopPropagation>
            <button class="btn-icon" title="Modifier" @onclick="ShowEditModal"><i class="bi bi-pencil text-xs"></i></button>
            <button class="btn-icon btn-icon-danger" title="Supprimer" @onclick="ShowDeleteConfirm"><i class="bi bi-x text-xs"></i></button>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Card.Description))
    {
        <p class="card-desc-preview text-gray-500 text-xs mt-1 mb-1">@Card.Description</p>
    }
    <div class="flex items-center justify-between mt-2 flex-wrap gap-1">
        <span class="badge @PriorityBadgeClass" style="font-size:.65rem">@PriorityLabel</span>
        @if (Card.DueDate.HasValue)
        {
            var overdue = Card.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
            <span class="text-xs @(overdue ? "text-red-600 font-semibold" : "text-gray-400")">
                &#128197; @Card.DueDate.Value.ToLocalTime().ToString("dd/MM")
            </span>
        }
        @if (Card.AssigneeName is not null)
        {
            <span class="text-xs text-gray-400 ml-auto"><i class="bi bi-person-fill mr-0.5"></i>@Card.AssigneeName.Split(' ')[0]</span>
        }
    </div>
</div>

@* ── Detail modal ── *@
<Modal Title="@Card.Title" Visible="_showDetail" OnClose="() => _showDetail = false" SizeClass="modal-lg">
    <div class="flex flex-wrap gap-2 mb-4">
        <span class="badge @PriorityBadgeClass">@PriorityLabel</span>
        @if (!string.IsNullOrWhiteSpace(ColumnName))
        {
            <span class="badge badge-gray">&#9642; @ColumnName</span>
        }
        @if (Card.DueDate.HasValue)
        {
            var overdue = Card.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
            <span class="badge @(overdue ? "badge-prio-critical" : "badge-gray")">
                &#128197; @Card.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")@(overdue ? " — en retard" : "")
            </span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Card.Description))
    {
        <div class="mb-4">
            <p class="section-label mb-1">Description</p>
            <div class="detail-description">@Card.Description</div>
        </div>
    }
    else
    {
        <p class="text-gray-400 text-sm italic mb-4">Aucune description.</p>
    }

    <div class="flex flex-wrap gap-4 text-xs text-gray-400 border-t border-gray-100 pt-3 mb-1">
        <span>Créée le @Card.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        @if (Card.UpdatedAt.HasValue)
        {
            <span>Modifiée le @Card.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        }
    </div>
    <div class="flex flex-wrap gap-4 text-xs text-gray-500 mb-4">
        <span><i class="bi bi-person mr-1"></i><strong>Créé par&nbsp;:</strong> @(Card.CreatedByName ?? Card.CreatedById)</span>
        @if (Card.AssignedToId is not null)
        {
            <span><i class="bi bi-person-check mr-1"></i><strong>Assigné à&nbsp;:</strong> @(Card.AssigneeName ?? Card.AssignedToId)</span>
        }
    </div>

    @* ── Comments ── *@
    <div class="mt-4">
        <p class="section-label mb-3">Commentaires</p>

        @if (_commentsLoading)
        {
            <p class="text-sm text-gray-400">Chargement…</p>
        }
        else if (_comments.Count == 0)
        {
            <p class="text-sm text-gray-400 italic">Aucun commentaire pour l'instant.</p>
        }
        else
        {
            <div class="flex flex-col gap-3 mb-4">
                @foreach (var c in _comments)
                {
                    var comment = c;
                    <div class="bg-gray-50 rounded-lg p-3">
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-sm font-semibold text-gray-800">@comment.AuthorName</span>
                                <span class="text-xs text-gray-400 ml-2">@comment.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                @if (comment.UpdatedAt.HasValue)
                                {
                                    <span class="text-xs text-gray-400 ml-1">(modifié)</span>
                                }
                            </div>
                            @if (comment.AuthorId == _currentUserId)
                            {
                                <div class="flex gap-1">
                                    <button class="btn-icon" title="Modifier" @onclick="() => StartEditComment(comment)"><i class="bi bi-pencil text-xs"></i></button>
                                    <button class="btn-icon btn-icon-danger" title="Supprimer" @onclick="() => DeleteCommentAsync(comment.Id)"><i class="bi bi-x text-xs"></i></button>
                                </div>
                            }
                        </div>
                        @if (_editingCommentId == comment.Id)
                        {
                            <div class="mt-2">
                                <textarea class="form-textarea" rows="2" @bind="_editCommentContent"></textarea>
                                <div class="flex gap-1 mt-1 justify-end">
                                    <button class="btn btn-outline btn-sm" @onclick="() => _editingCommentId = null">@L["Cancel"]</button>
                                    <button class="btn btn-primary btn-sm" @onclick="() => SaveEditCommentAsync(comment.Id)" disabled="@_commentBusy">@L["Save"]</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="comment-content text-sm text-gray-700 mt-1 mb-0">@comment.Content</p>
                        }
                    </div>
                }
            </div>
        }

        <div class="flex gap-2 items-end">
            <textarea class="form-textarea flex-1" rows="2"
                      placeholder="Ajouter un commentaire…"
                      @bind="_newCommentContent"
                      disabled="@_commentBusy"></textarea>
            <button class="btn btn-primary btn-sm shrink-0 self-end"
                    @onclick="AddCommentAsync"
                    disabled="@(string.IsNullOrWhiteSpace(_newCommentContent) || _commentBusy)">
                Envoyer
            </button>
        </div>
        @if (_commentError is not null)
        {
            <div class="mt-2"><ErrorAlert Message="@_commentError" /></div>
        }
    </div>

    <div class="flex justify-end gap-2 mt-5 border-t border-gray-100 pt-4">
        <button class="btn btn-danger btn-sm" @onclick="() => { _showDetail = false; ShowDeleteConfirm(); }">
            <i class="bi bi-trash mr-1"></i>@L["Delete"]
        </button>
        <button class="btn btn-primary btn-sm" @onclick="() => { _showDetail = false; ShowEditModal(); }">
            <i class="bi bi-pencil mr-1"></i>@L["Edit"]
        </button>
    </div>
</Modal>

@* ── Edit modal ── *@
<Modal Title="Modifier la carte" Visible="_showEdit" OnClose="() => _showEdit = false">
    <EditForm Model="_form" OnValidSubmit="UpdateCardAsync">
        <DataAnnotationsValidator />
        <div class="mb-4">
            <label class="form-label">@L["Title"]</label>
            <InputText @bind-Value="_form.Title" class="form-input" />
            <ValidationMessage For="() => _form.Title" />
        </div>
        <div class="mb-4">
            <label class="form-label">@L["Description"]</label>
            <InputTextArea @bind-Value="_form.Description" class="form-textarea" rows="4" />
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="form-label">@L["Priority"]</label>
                <InputSelect @bind-Value="_form.Priority" class="form-select">
                    @foreach (var p in Enum.GetValues<CardPriority>())
                    {
                        <option value="@p">@PriorityLabelFor(p)</option>
                    }
                </InputSelect>
            </div>
            <div>
                <label class="form-label">@L["Ticket.DueDate"]</label>
                <InputDate @bind-Value="_form.DueDate" class="form-input" />
            </div>
        </div>
        <div class="mb-4 mt-3">
            <label class="form-label">@L["Ticket.Assignee"]</label>
            <select class="form-select" @bind="_form.AssignedToId">
                <option value="">— @L["Ticket.NoAssignee"] —</option>
                @foreach (var u in _users)
                {
                    <option value="@u.Id">@u.DisplayName</option>
                }
            </select>
        </div>
        @if (_editError is not null)
        {
            <div class="mb-4"><ErrorAlert Message="@_editError" /></div>
        }
        <div class="flex justify-end gap-2 mt-4">
            <button type="button" class="btn btn-outline" @onclick="() => _showEdit = false">Annuler</button>
            <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "…" : "Enregistrer")</button>
        </div>
    </EditForm>
</Modal>

@* ── Delete confirmation ── *@
<ConfirmModal Title="Supprimer la carte"
              Message="@($"Supprimer \"{Card.Title}\" ?")"
              Visible="_showDelete"
              OnCancel="() => _showDelete = false"
              OnConfirm="DeleteCardAsync" />

@code {
    [Parameter, EditorRequired] public CardDto Card { get; set; } = default!;
    [Parameter, EditorRequired] public Guid ColumnId { get; set; }
    [Parameter] public string ColumnName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChanged { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // ── Drag ──────────────────────────────────────────────────────────────────
    private bool _isDragging;

    private void OnDragStart()
    {
        _isDragging = true;
        DragState.Begin(Card, ColumnId);
        _ = JS.InvokeVoidAsync("kanban.setDragData", Card.Id.ToString());
    }

    private void OnDragEnd()
    {
        _isDragging = false;
        if (DragState.IsDragging) DragState.Cancel();
    }

    // ── Detail + Comments ─────────────────────────────────────────────────────
    private bool _showDetail;
    private string? _currentUserId;
    private List<CommentDto> _comments = [];
    private bool _commentsLoading;
    private string? _newCommentContent;
    private bool _commentBusy;
    private string? _commentError;
    private Guid? _editingCommentId;
    private string _editCommentContent = string.Empty;

    private async Task OnShowDetailAsync()
    {
        _showDetail = true;
        var authState = await AuthState;
        _currentUserId = authState.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value
            ?? authState.User.Claims.FirstOrDefault(c => c.Type == "sub")?.Value;
        await LoadCommentsAsync();
    }

    private async Task LoadCommentsAsync()
    {
        _commentsLoading = true;
        _commentError = null;
        try { _comments = (await CommentApi.GetByCardAsync(Card.Id)).ToList(); }
        catch { _commentError = "Impossible de charger les commentaires."; }
        finally { _commentsLoading = false; }
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCommentContent)) return;
        _commentBusy = true; _commentError = null;
        try
        {
            await CommentApi.CreateAsync(Card.Id, new CreateCommentRequest(_newCommentContent.Trim()));
            _newCommentContent = null;
            await LoadCommentsAsync();
        }
        catch { _commentError = "Impossible d'ajouter le commentaire."; }
        finally { _commentBusy = false; }
    }

    private void StartEditComment(CommentDto c)
    {
        _editingCommentId = c.Id;
        _editCommentContent = c.Content;
    }

    private async Task SaveEditCommentAsync(Guid commentId)
    {
        if (string.IsNullOrWhiteSpace(_editCommentContent)) return;
        _commentBusy = true; _commentError = null;
        try
        {
            await CommentApi.UpdateAsync(commentId, new UpdateCommentRequest(_editCommentContent.Trim()));
            _editingCommentId = null;
            await LoadCommentsAsync();
        }
        catch { _commentError = "La modification a échoué."; }
        finally { _commentBusy = false; }
    }

    private async Task DeleteCommentAsync(Guid commentId)
    {
        _commentBusy = true; _commentError = null;
        try
        {
            await CommentApi.DeleteAsync(commentId);
            await LoadCommentsAsync();
        }
        catch { _commentError = "La suppression a échoué."; }
        finally { _commentBusy = false; }
    }

    // ── Edit ──────────────────────────────────────────────────────────────────
    private bool _showEdit;
    private bool _busy;
    private string? _editError;
    private CardForm _form = new();

    private sealed class CardForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.MaxLength(2000)]
        public string? Description { get; set; }
        public CardPriority Priority { get; set; } = CardPriority.Medium;
        public DateTime? DueDate { get; set; }
        public string? AssignedToId { get; set; }
    }

    private List<UserSummaryDto> _users = [];

    private void ShowEditModal()
    {
        _form = new() { Title = Card.Title, Description = Card.Description, Priority = Card.Priority, DueDate = Card.DueDate, AssignedToId = Card.AssignedToId };
        _editError = null;
        _showEdit = true;
        _ = LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        try { _users = await UserApi.GetAllAsync() ?? []; }
        catch { _users = []; }
    }

    private async Task UpdateCardAsync()
    {
        _busy = true; _editError = null;
        try
        {
            await CardApi.UpdateAsync(Card.Id,
                new UpdateCardRequest(_form.Title, _form.Description, _form.Priority, _form.DueDate,
                    string.IsNullOrEmpty(_form.AssignedToId) ? null : _form.AssignedToId));
            _showEdit = false;
            await OnChanged.InvokeAsync();
        }
        catch { _editError = "La mise à jour a échoué."; }
        finally { _busy = false; }
    }

    // ── Delete ────────────────────────────────────────────────────────────────
    private bool _showDelete;
    private void ShowDeleteConfirm() => _showDelete = true;

    private async Task DeleteCardAsync()
    {
        try { await CardApi.DeleteAsync(Card.Id); await OnChanged.InvokeAsync(); }
        catch { }
        finally { _showDelete = false; }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private string PriorityCssName => Card.Priority.ToString().ToLower();

    private string PriorityLabel => PriorityLabelFor(Card.Priority);

    private static string PriorityLabelFor(CardPriority p) => p switch
    {
        CardPriority.Low      => "Faible",
        CardPriority.Medium   => "Moyenne",
        CardPriority.High     => "Haute",
        CardPriority.Critical => "Critique",
        _                     => p.ToString()
    };

    private string PriorityBadgeClass => Card.Priority switch
    {
        CardPriority.Low      => "badge badge-prio-low",
        CardPriority.Medium   => "badge badge-prio-medium",
        CardPriority.High     => "badge badge-prio-high",
        CardPriority.Critical => "badge badge-prio-critical",
        _                     => "badge badge-gray"
    };
}

