@* Confirmation modal for destructive actions. *@

<Modal Title="@Title" Visible="Visible" OnClose="OnCancel">
    <p class="text-sm text-gray-700 mb-5">@Message</p>
    <div class="flex justify-end gap-2">
        <button class="btn btn-outline" type="button" @onclick="OnCancel">Annuler</button>
        <button class="btn btn-danger" type="button" @onclick="OnConfirmAsync" disabled="@_busy">
            @(_busy ? "Suppression…" : ConfirmLabel)
        </button>
    </div>
</Modal>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "Confirmer la suppression";
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    [Parameter] public string ConfirmLabel { get; set; } = "Supprimer";
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool _busy;

    private async Task OnConfirmAsync()
    {
        _busy = true;
        await OnConfirm.InvokeAsync();
        _busy = false;
    }
}
