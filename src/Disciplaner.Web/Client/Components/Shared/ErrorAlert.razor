<div class="flex items-center gap-2 px-4 py-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg" role="alert">
    <i class="bi bi-exclamation-circle text-red-500 shrink-0"></i>
    <span>@Message</span>
</div>

@code {
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
}
