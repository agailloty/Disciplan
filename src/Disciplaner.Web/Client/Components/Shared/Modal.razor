@if (Visible)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto"
         style="background:rgba(0,0,0,.5); padding-top:3rem; padding-bottom:3rem"
         @onclick="OnOverlayClick">
        <div class="bg-white rounded-2xl shadow-2xl w-full @MaxWidthClass mx-4 flex flex-col"
             style="max-height:90vh"
             @onclick:stopPropagation
             @onkeydown="OnKeyDown" tabindex="-1">
            @if (string.IsNullOrEmpty(Title))
            {
                @* Compact header — close button + optional extra actions *@
                <div class="modal-close-only">
                    @ExtraHeaderContent
                    <button class="modal-close-btn" @onclick="CloseAsync" type="button" aria-label="Fermer">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }
            else
            {
                @* Standard header with title *@
                <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
                    <h2 class="font-semibold text-sm text-gray-900">@Title</h2>
                    <button class="modal-close-btn" @onclick="CloseAsync" type="button" aria-label="Fermer">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            }
            @* Body *@
            <div class="@(string.IsNullOrEmpty(Title) ? "px-6 pb-6 pt-1" : "px-6 py-5") overflow-y-auto flex-1">
                @ChildContent
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public RenderFragment? ExtraHeaderContent { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>"modal-lg" | "modal-sm" | "" (default)</summary>
    [Parameter] public string SizeClass { get; set; } = string.Empty;

    private string MaxWidthClass => SizeClass switch
    {
        "modal-lg" => "max-w-3xl",
        "modal-xl" => "max-w-5xl",
        "modal-sm" => "max-w-sm",
        _          => "max-w-lg"
    };

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task OnOverlayClick() => await CloseAsync();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }
}
