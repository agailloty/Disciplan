@inject AttachmentApiClient AttachmentApi
@inject IJSRuntime JS
@inject IStringLocalizer<AppResources> L
@implements IAsyncDisposable

@if (Visible && Attachment is not null)
{
    <div class="fixed inset-0 z-[500] flex items-center justify-center bg-black/75 backdrop-blur-sm"
         @onclick="CloseAsync">
        <div class="relative bg-white dark:bg-gray-900 rounded-2xl shadow-2xl w-full max-w-5xl mx-4 flex flex-col"
             style="max-height: 90vh;"
             @onclick:stopPropagation>

            @* ── Header ── *@
            <div class="flex items-center gap-3 px-5 py-3 border-b border-gray-200 dark:border-gray-700 shrink-0">
                <i class="@FileIcon(Attachment.ContentType) text-xl text-gray-500 shrink-0"></i>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate">@Attachment.FileName</p>
                    <p class="text-xs text-gray-400">@FormatSize(Attachment.SizeBytes) · @Attachment.UploadedByName · @Attachment.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <button class="btn btn-outline btn-sm" @onclick="OpenInNewTabAsync" disabled="@(_loading || _bytes is null)" title="@L["Attachment.OpenInNewTab"]">
                        <i class="bi bi-box-arrow-up-right mr-1"></i>@L["Attachment.NewTab"]
                    </button>
                    <button class="btn btn-outline btn-sm" @onclick="DownloadAsync" disabled="@(_loading || _bytes is null)">
                        <i class="bi bi-download mr-1"></i>@L["Attachment.Download"]
                    </button>
                    <button class="modal-close-btn" title="@L["Close"]" @onclick="CloseAsync">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            @* ── Body ── *@
            <div class="flex-1 overflow-auto flex items-center justify-center p-4 min-h-0">
                @if (_loading)
                {
                    <div class="flex flex-col items-center gap-3 text-gray-400 py-12">
                        <div class="animate-spin rounded-full h-10 w-10 border-4 border-gray-200 border-t-blue-500"></div>
                        <span class="text-sm">@L["Attachment.LoadingPreview"]</span>
                    </div>
                }
                else if (_error is not null)
                {
                    <div class="flex flex-col items-center gap-3 text-red-500 py-12">
                        <i class="bi bi-exclamation-triangle text-4xl"></i>
                        <p class="text-sm">@_error</p>
                        <button class="btn btn-outline btn-sm" @onclick="LoadAsync">@L["Attachment.Retry"]</button>
                    </div>
                }
                else if (IsImage(Attachment.ContentType))
                {
                    <img src="@_dataUrl"
                         alt="@Attachment.FileName"
                         class="max-w-full max-h-full object-contain rounded-lg select-none" />
                }
                else if (IsPdf(Attachment.ContentType) && _blobUrl is not null)
                {
                    <iframe src="@_blobUrl"
                            title="@Attachment.FileName"
                            class="w-full rounded-lg border border-gray-200"
                            style="height: 72vh;"
                            loading="lazy"></iframe>
                }
                else
                {
                    <div class="flex flex-col items-center gap-4 py-12 text-gray-500">
                        <i class="@FileIcon(Attachment.ContentType) text-7xl"></i>
                        <p class="text-sm">@L["Attachment.NoPreview"]</p>
                        <button class="btn btn-primary btn-sm" @onclick="DownloadAsync" disabled="@(_bytes is null)">
                            <i class="bi bi-download mr-1.5"></i>@L["Attachment.DownloadFile"]
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public AttachmentDto? Attachment { get; set; }
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _loading;
    private string? _error;
    private string? _dataUrl;   // base64 data URI for images
    private string? _blobUrl;   // blob: URL for PDFs
    private byte[]? _bytes;
    private Guid? _loadedId;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && Attachment is not null && Attachment.Id != _loadedId)
            await LoadAsync();

        if (!Visible)
            await CleanupPreviewAsync();
    }

    private async Task LoadAsync()
    {
        if (Attachment is null) return;

        _loading = true;
        _error   = null;
        _dataUrl = null;
        await CleanupPreviewAsync(cleanLoaded: false);
        StateHasChanged();

        try
        {
            var (bytes, contentType) = await AttachmentApi.DownloadAsync(Attachment.Id);
            _bytes    = bytes;
            _loadedId = Attachment.Id;

            if (IsImage(Attachment.ContentType))
            {
                _dataUrl = $"data:{Attachment.ContentType};base64,{Convert.ToBase64String(_bytes)}";
            }
            else if (IsPdf(Attachment.ContentType))
            {
                _blobUrl = await JS.InvokeAsync<string>("disciplaner.createBlobUrl", _bytes, Attachment.ContentType);
            }
        }
        catch (Exception ex)
        {
            _error = L["Attachment.Error.Load", ex.Message];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (_bytes is null || Attachment is null) return;
        await JS.InvokeVoidAsync("disciplaner.downloadBlob", _bytes, Attachment.ContentType, Attachment.FileName);
    }

    private async Task OpenInNewTabAsync()
    {
        if (_bytes is null || Attachment is null) return;
        await JS.InvokeVoidAsync("disciplaner.openBlobInTab", _bytes, Attachment.ContentType);
    }

    private async Task CloseAsync()
    {
        await CleanupPreviewAsync();
        await OnClose.InvokeAsync();
    }

    private async Task CleanupPreviewAsync(bool cleanLoaded = true)
    {
        if (_blobUrl is not null)
        {
            await JS.InvokeVoidAsync("disciplaner.revokeBlobUrl", _blobUrl);
            _blobUrl = null;
        }
        if (cleanLoaded)
        {
            _loadedId = null;
            _dataUrl  = null;
            _bytes    = null;
        }
    }

    public async ValueTask DisposeAsync()
        => await CleanupPreviewAsync();

    // ── Helpers ─────────────────────────────────────────────────────────────

    private static bool IsImage(string ct) =>
        ct.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static bool IsPdf(string ct) =>
        ct.Equals("application/pdf", StringComparison.OrdinalIgnoreCase);

    internal static string FileIcon(string ct) => ct switch
    {
        var t when t.StartsWith("image/", StringComparison.OrdinalIgnoreCase)               => "bi bi-file-earmark-image text-green-500",
        "application/pdf"                                                                    => "bi bi-file-earmark-pdf text-red-500",
        var t when t.Contains("word", StringComparison.OrdinalIgnoreCase)                   => "bi bi-file-earmark-word text-blue-600",
        var t when t.Contains("excel", StringComparison.OrdinalIgnoreCase)
                || t.Contains("spreadsheet", StringComparison.OrdinalIgnoreCase)            => "bi bi-file-earmark-excel text-green-600",
        var t when t.Contains("powerpoint", StringComparison.OrdinalIgnoreCase)
                || t.Contains("presentation", StringComparison.OrdinalIgnoreCase)           => "bi bi-file-earmark-ppt text-orange-500",
        "text/plain"                                                                         => "bi bi-file-earmark-text text-gray-500",
        "text/csv"                                                                           => "bi bi-file-earmark-spreadsheet text-teal-500",
        var t when t.Contains("zip", StringComparison.OrdinalIgnoreCase)
                || t.Contains("compressed", StringComparison.OrdinalIgnoreCase)             => "bi bi-file-earmark-zip text-yellow-500",
        _                                                                                    => "bi bi-file-earmark text-gray-400"
    };

    internal static string FormatSize(long bytes) => bytes switch
    {
        < 1024           => $"{bytes} o",
        < 1024 * 1024    => $"{bytes / 1024.0:F1} Ko",
        _                => $"{bytes / 1024.0 / 1024.0:F1} Mo"
    };
}
