@inject IStringLocalizer<AppResources> L

<div class="border border-gray-200 rounded-lg overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 bg-gray-50 border-b border-gray-200">
        <h3 class="font-semibold text-gray-800 text-sm">@L["Members.Title"] (@Members.Count)</h3>
        @if (CanAdminister)
        {
            <button class="btn btn-primary btn-sm" @onclick="() => _showAdd = true">
                <i class="bi bi-person-plus me-1"></i>@L["Members.Add"]
            </button>
        }
    </div>

    @if (Members.Count == 0)
    {
        <p class="px-4 py-3 text-sm text-gray-400 italic">@L["Members.None"]</p>
    }
    else
    {
        <ul class="divide-y divide-gray-100">
            @foreach (var m in Members)
            {
                <li class="flex items-center gap-3 px-4 py-2">
                    <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-sm font-semibold flex-shrink-0">
                        @m.DisplayName[0]
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-gray-900 truncate">@m.DisplayName</p>
                        <p class="text-xs text-gray-400 truncate">@m.Email</p>
                    </div>
                    <span class="@RoleBadgeClass(m.Role) text-xs px-2 py-0.5 rounded-full font-medium">
                        @m.Role.ToString()
                    </span>
                    @if (CanAdminister)
                    {
                        <div class="flex gap-1 flex-shrink-0">
                            <button class="btn btn-outline btn-xs" @onclick="() => OpenEditRole(m)" title="@L["Members.ChangeRole"]">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-danger btn-xs" @onclick="() => OpenRemove(m)" title="@L["Members.Remove"]">
                                <i class="bi bi-person-dash"></i>
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

@* ── Add member modal ── *@
@if (_showAdd)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center z-50" @onclick="() => _showAdd = false">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-md" @onclick:stopPropagation="true">
            <h2 class="text-lg font-semibold mb-4">@L["Members.Add"]</h2>
            <div class="mb-3">
                <label class="form-label">@L["Members.SelectUser"]</label>
                <select class="form-select" @bind="_addUserId">
                    <option value="">— @L["Members.SelectUser"] —</option>
                    @foreach (var u in AvailableUsers)
                    {
                        <option value="@u.Id">@u.DisplayName (@u.Email)</option>
                    }
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">@L["Members.Role"]</label>
                <select class="form-select" @bind="_addRole">
                    @foreach (var role in AllowedRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            @if (_addError is not null)
            {
                <p class="text-sm text-red-600 mb-3">@_addError</p>
            }
            <div class="flex justify-end gap-2">
                <button class="btn btn-outline" @onclick="() => _showAdd = false">@L["Cancel"]</button>
                <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrEmpty(_addUserId))" @onclick="AddMemberAsync">
                    @(_busy ? "…" : L["Members.Add"].Value)
                </button>
            </div>
        </div>
    </div>
}

@* ── Change role modal ── *@
@if (_editMember is not null)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center z-50" @onclick="() => _editMember = null">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm" @onclick:stopPropagation="true">
            <h2 class="text-lg font-semibold mb-4">@L["Members.ChangeRole"] — @_editMember.DisplayName</h2>
            <div class="mb-4">
                <label class="form-label">@L["Members.Role"]</label>
                <select class="form-select" @bind="_editRole">
                    @foreach (var role in AllowedRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            @if (_editError is not null)
            {
                <p class="text-sm text-red-600 mb-3">@_editError</p>
            }
            <div class="flex justify-end gap-2">
                <button class="btn btn-outline" @onclick="() => _editMember = null">@L["Cancel"]</button>
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveRoleAsync">
                    @(_busy ? "…" : L["Save"].Value)
                </button>
            </div>
        </div>
    </div>
}

@* ── Remove confirmation ── *@
@if (_removeMember is not null)
{
    <div class="fixed inset-0 bg-black/40 flex items-center justify-center z-50" @onclick="() => _removeMember = null">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-sm" @onclick:stopPropagation="true">
            <h2 class="text-lg font-semibold mb-3">@L["Members.Remove"]</h2>
            <p class="text-sm text-gray-600 mb-4">@string.Format(L["Members.RemoveConfirm"].Value, _removeMember.DisplayName)</p>
            @if (_removeError is not null)
            {
                <p class="text-sm text-red-600 mb-3">@_removeError</p>
            }
            <div class="flex justify-end gap-2">
                <button class="btn btn-outline" @onclick="() => _removeMember = null">@L["Cancel"]</button>
                <button class="btn btn-danger" disabled="@_busy" @onclick="RemoveMemberAsync">
                    @(_busy ? "…" : L["Members.Remove"].Value)
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MemberDto> Members { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<UserSummaryDto> AvailableUsers { get; set; } = [];
    [Parameter, EditorRequired] public bool CanAdminister { get; set; }
    [Parameter, EditorRequired] public Func<AddMemberRequest, Task> OnAdd { get; set; } = null!;
    [Parameter, EditorRequired] public Func<string, UpdateMemberRoleRequest, Task> OnUpdateRole { get; set; } = null!;
    [Parameter, EditorRequired] public Func<string, Task> OnRemove { get; set; } = null!;

    private static readonly MemberRole[] AllowedRoles =
        [MemberRole.Guest, MemberRole.Member, MemberRole.Supervisor];

    private bool _showAdd;
    private string _addUserId = string.Empty;
    private MemberRole _addRole = MemberRole.Member;
    private string? _addError;

    private MemberDto? _editMember;
    private MemberRole _editRole = MemberRole.Member;
    private string? _editError;

    private MemberDto? _removeMember;
    private string? _removeError;

    private bool _busy;

    private void OpenEditRole(MemberDto m)
    {
        _editMember = m;
        _editRole = m.Role;
        _editError = null;
    }

    private void OpenRemove(MemberDto m)
    {
        _removeMember = m;
        _removeError = null;
    }

    private async Task AddMemberAsync()
    {
        _busy = true; _addError = null;
        try
        {
            await OnAdd(new AddMemberRequest(_addUserId, _addRole));
            _showAdd = false;
            _addUserId = string.Empty;
            _addRole = MemberRole.Member;
        }
        catch (Exception ex) { _addError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SaveRoleAsync()
    {
        if (_editMember is null) return;
        _busy = true; _editError = null;
        try
        {
            await OnUpdateRole(_editMember.UserId, new UpdateMemberRoleRequest(_editRole));
            _editMember = null;
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RemoveMemberAsync()
    {
        if (_removeMember is null) return;
        _busy = true; _removeError = null;
        try
        {
            await OnRemove(_removeMember.UserId);
            _removeMember = null;
        }
        catch (Exception ex) { _removeError = ex.Message; }
        finally { _busy = false; }
    }

    private static string RoleBadgeClass(MemberRole role) => role switch
    {
        MemberRole.Admin      => "bg-red-100 text-red-700",
        MemberRole.Supervisor => "bg-orange-100 text-orange-700",
        MemberRole.Member     => "bg-blue-100 text-blue-700",
        MemberRole.Guest      => "bg-gray-100 text-gray-600",
        _                     => "bg-gray-100 text-gray-600"
    };
}
