@inject TicketApiClient TicketApi
@inject CommentApiClient CommentApi
@inject UserApiClient UserApi
@inject LabelApiClient LabelApi
@inject AttachmentApiClient AttachmentApi
@inject IStringLocalizer<AppResources> L
@using Disciplaner.Application.DTOs.User

@if (Visible && Ticket is not null)
{
    <Modal Title="" Visible="true" OnClose="CloseAsync" SizeClass="modal-lg">
        <ExtraHeaderContent>
            @if (!_editing)
            {
                <button type="button" class="modal-close-btn" title="@L["Edit"]" @onclick="EnterEdit">
                    <i class="bi bi-pencil"></i>
                </button>
            }
        </ExtraHeaderContent>
        <ChildContent>
        @if (!_editing)
        {
            @* ── Ticket header ── *@
            <div class="mb-4">
                <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
                    <span class="font-mono text-xs font-semibold text-gray-400 tracking-wide">@Ticket.TicketRef</span>
                    <span class="tdm-type-badge">@Ticket.Type</span>
                    <span class="badge @PriorityBadgeClass(Ticket.Priority)">@Ticket.Priority</span>
                </div>
                <h2 class="text-base font-semibold text-gray-900 leading-snug">@Ticket.Title</h2>
            </div>

            @* ── Two-column layout ── *@
            <div class="flex flex-col lg:flex-row gap-6">

                @* ── Main column ── *@
                <div class="flex-1 min-w-0 flex flex-col gap-5">

                    @* Description *@
                    <div>
                        <span class="tdm-section-label mb-2">@L["Description"]</span>
                        @if (!string.IsNullOrWhiteSpace(Ticket.Description))
                        {
                            <div class="tdm-description">@Ticket.Description</div>
                        }
                        else
                        {
                            <p class="text-gray-400 text-sm italic py-1">@L["Ticket.NoDescription"]</p>
                        }
                    </div>

                    @* Comments *@
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <span class="tdm-section-label">@L["Ticket.Comments"]</span>
                            @if (_comments.Count > 0)
                            {
                                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-gray-100 text-gray-500 text-xs font-semibold">@_comments.Count</span>
                            }
                        </div>

                        @if (_commentsLoading)
                        {
                            <p class="text-sm text-gray-400 py-2">@L["Loading"]</p>
                        }
                        else
                        {
                            @if (_comments.Count > 0)
                            {
                                <div class="flex flex-col gap-3 mb-4">
                                    @foreach (var c in _comments)
                                    {
                                        <div class="tdm-comment-row group">
                                            <div class="tdm-avatar @AvatarColor(c.AuthorName)">
                                                @(c.AuthorName.Length > 0 ? c.AuthorName[0].ToString().ToUpper() : "?")
                                            </div>
                                            <div class="tdm-comment-body">
                                                <div class="tdm-comment-header">
                                                    <span class="tdm-comment-author">@c.AuthorName</span>
                                                    <span class="tdm-comment-date">@c.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                                </div>
                                                @if (_editingCommentId == c.Id)
                                                {
                                                    <textarea class="form-textarea text-sm" rows="2" @bind="_editCommentContent"></textarea>
                                                    <div class="flex gap-1.5 mt-1.5">
                                                        <button class="btn btn-primary btn-sm" @onclick="() => SaveCommentEditAsync(c.Id)">@L["Ticket.Comment.Save"]</button>
                                                        <button class="btn btn-outline btn-sm" @onclick="() => _editingCommentId = null">@L["Cancel"]</button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="tdm-comment-bubble">@c.Content</div>
                                                    <div class="mt-1.5 pl-0.5">
                                                        <AttachmentPanel CommentId="c.Id" />
                                                    </div>
                                                    <div class="tdm-comment-actions">
                                                        <button class="text-xs text-gray-400 hover:text-gray-700 transition-colors" @onclick="() => StartEditComment(c)">@L["Ticket.Comment.Edit"]</button>
                                                        <button class="text-xs text-red-400 hover:text-red-600 transition-colors" @onclick="() => DeleteCommentAsync(c.Id)">@L["Ticket.Comment.Delete"]</button>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @* Add comment *@
                            <div class="flex gap-2.5 items-start">
                                <div class="tdm-avatar av-gray shrink-0">
                                    <i class="bi bi-person" style="font-size:.8rem"></i>
                                </div>
                                <div class="flex-1">
                                    <textarea class="form-textarea text-sm"
                                              rows="2"
                                              placeholder="@L["Ticket.Comment.Add"]"
                                              @bind="_newCommentContent"
                                              @bind:event="oninput"></textarea>

                                    @* Pending files chips *@
                                    @if (_pendingCommentFiles.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1.5 mt-1.5">
                                            @foreach (var f in _pendingCommentFiles)
                                            {
                                                var file = f;
                                                <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 border border-blue-200 px-2 py-0.5 text-xs text-blue-700 max-w-[180px]">
                                                    <i class="bi bi-paperclip shrink-0"></i>
                                                    <span class="truncate">@file.Name</span>
                                                    <button type="button" class="ml-0.5 text-blue-400 hover:text-red-500 shrink-0"
                                                            @onclick="() => _pendingCommentFiles.Remove(file)">
                                                        <i class="bi bi-x"></i>
                                                    </button>
                                                </span>
                                            }
                                        </div>
                                    }

                                    <div class="flex items-center justify-between mt-1.5">
                                        <label class="inline-flex items-center gap-1 text-xs cursor-pointer select-none px-2 py-1 rounded hover:bg-gray-100 transition-colors text-gray-400"
                                               title="Joindre des fichiers">
                                            <i class="bi bi-paperclip text-sm"></i>Joindre
                                            <InputFile OnChange="HandlePendingCommentFilesAsync" class="hidden" multiple
                                                       accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip" />
                                        </label>
                                        <button class="btn btn-primary btn-sm"
                                                @onclick="AddCommentAsync"
                                                disabled="@(string.IsNullOrWhiteSpace(_newCommentContent) && _pendingCommentFiles.Count == 0)">
                                            <i class="bi bi-send-fill"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* ── Attachments ── *@
                    <div>
                        <AttachmentPanel TicketId="Ticket.Id" />
                    </div>
                </div>

                @* ── Sidebar ── *@
                <div class="lg:w-52 shrink-0">

                    @* Status *@
                    <div class="tdm-prop">
                        <span class="tdm-sidebar-label">@L["Status"]</span>
                        <div class="tdm-select-wrap">
                            <span class="tdm-status-dot" style="background:@Ticket.Status.Color"></span>
                            <select class="tdm-select tdm-select-with-dot"
                                    value="@Ticket.Status.Id"
                                    @onchange="OnStatusChangeAsync"
                                    disabled="@_busy">
                                @foreach (var s in Statuses.OrderBy(s => s.Order))
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* Assignee *@
                    <div class="tdm-prop">
                        <span class="tdm-sidebar-label">@L["Ticket.Assignee"]</span>
                        <div class="tdm-select-wrap">
                            <select class="tdm-select"
                                    value="@(Ticket.AssigneeId ?? string.Empty)"
                                    @onchange="OnAssigneeChangeAsync"
                                    disabled="@_busy">
                                <option value="">@L["Ticket.NoAssignee"]</option>
                                @foreach (var u in _users)
                                {
                                    <option value="@u.Id">@u.DisplayName</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* Sprint *@
                    @if (Sprints.Any())
                    {
                        <div class="tdm-prop">
                            <span class="tdm-sidebar-label">Sprint</span>
                            <div class="tdm-select-wrap">
                                <select class="tdm-select"
                                        value="@(Ticket.SprintId?.ToString() ?? string.Empty)"
                                        @onchange="OnSprintChangeAsync"
                                        disabled="@_busy">
                                    <option value="">— Backlog —</option>
                                    @foreach (var s in Sprints)
                                    {
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }

                    <div class="border-t border-gray-100 my-3"></div>

                    @* Meta *@
                    @if (Ticket.StoryPoints.HasValue)
                    {
                        <div class="tdm-meta-row">
                            <i class="bi bi-stars tdm-meta-icon"></i>
                            <span class="tdm-meta-label">@L["Ticket.StoryPoints"]</span>
                            <span class="tdm-meta-value">@Ticket.StoryPoints pts</span>
                        </div>
                    }
                    @if (Ticket.DueDate.HasValue)
                    {
                        var overdue = Ticket.DueDate.Value.ToUniversalTime() < DateTime.UtcNow;
                        <div class="tdm-meta-row @(overdue ? "text-red-600" : "")">
                            <i class="bi bi-calendar3 tdm-meta-icon @(overdue ? "text-red-500" : "")"></i>
                            <span class="tdm-meta-label">@L["Ticket.DueDate"]</span>
                            <span class="tdm-meta-value @(overdue ? "font-semibold text-red-600" : "")">@Ticket.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                    @if (Ticket.ParentTicketRef is not null)
                    {
                        <div class="tdm-meta-row">
                            <i class="bi bi-diagram-3 tdm-meta-icon"></i>
                            <span class="tdm-meta-label">Parent</span>
                            <span class="tdm-meta-value font-mono">@Ticket.ParentTicketRef</span>
                        </div>
                    }

                    <div class="border-t border-gray-100 my-3"></div>

                    @* Labels *@
                    <div class="tdm-prop">
                        <span class="tdm-sidebar-label">@L["Label.Field"]</span>
                        <LabelPicker SelectedLabels="_labels" Editable="true"
                                     OnAttach="async l => { await LabelApi.AttachToTicketAsync(l.Id, Ticket!.Id); }"
                                     OnDetach="async l => { await LabelApi.DetachFromTicketAsync(l.Id, Ticket!.Id); }" />
                    </div>

                    <div class="border-t border-gray-100 my-3"></div>

                    @* Reporter + timestamps *@
                    <div class="tdm-meta-row">
                        <i class="bi bi-person tdm-meta-icon"></i>
                        <span class="tdm-meta-label">@L["Ticket.Reporter"]</span>
                        <span class="tdm-meta-value">@Ticket.ReporterName</span>
                    </div>
                    <div class="tdm-meta-row">
                        <i class="bi bi-clock-history tdm-meta-icon"></i>
                        <span class="tdm-meta-label">@L["Created"]</span>
                        <span class="tdm-meta-value">@Ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    </div>
                    @if (Ticket.UpdatedAt.HasValue)
                    {
                        <div class="tdm-meta-row">
                            <i class="bi bi-pencil-square tdm-meta-icon"></i>
                            <span class="tdm-meta-label">@L["Updated"]</span>
                            <span class="tdm-meta-value">@Ticket.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                </div>
            </div>

            @if (_error is not null)
            {
                <div class="mt-4"><ErrorAlert Message="@_error" /></div>
            }

            @* ── Footer actions ── *@
            <div class="flex justify-between items-center mt-5 pt-4 border-t border-gray-100">
                <a href="/tickets/@Ticket.TicketRef" class="btn btn-ghost btn-sm">
                    <i class="bi bi-box-arrow-up-right mr-1"></i>@L["Ticket.OpenPage"]
                </a>
                <div class="flex gap-2">
                    @if (ActiveSprintId.HasValue && Ticket.SprintId is null)
                    {
                        <button class="btn btn-outline btn-sm" @onclick="OnAddToSprintAsync" disabled="@_busy">
                            <i class="bi bi-lightning mr-1"></i>@L["Sprint.AddTicket"]
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            @* ── Edit form ── *@
            <EditForm Model="_form" OnValidSubmit="OnSaveAsync">
                <DataAnnotationsValidator />

                <div class="mb-4">
                    <label class="form-label">@L["Title"]</label>
                    <InputText class="form-input" @bind-Value="_form.Title" />
                    <ValidationMessage For="() => _form.Title" />
                </div>

                <div class="mb-4">
                    <label class="form-label">@L["Description"]</label>
                    <InputTextArea class="form-textarea" rows="5" @bind-Value="_form.Description" />
                </div>

                <div class="grid grid-cols-2 gap-3 mb-3">
                    <div>
                        <label class="form-label">@L["Type"]</label>
                        <div class="tdm-select-wrap">
                            <InputSelect class="tdm-select" @bind-Value="_form.Type">
                                @foreach (var type in Enum.GetValues<TicketType>())
                                {
                                    <option value="@type">@type</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div>
                        <label class="form-label">@L["Priority"]</label>
                        <div class="tdm-select-wrap">
                            <InputSelect class="tdm-select" @bind-Value="_form.Priority">
                                @foreach (var priority in Enum.GetValues<CardPriority>())
                                {
                                    <option value="@priority">@priority</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3 mb-4">
                    <div>
                        <label class="form-label">@L["Ticket.StoryPoints"]</label>
                        <InputNumber class="form-input" @bind-Value="_form.StoryPoints" />
                    </div>
                    <div>
                        <label class="form-label">@L["Ticket.DueDate"]</label>
                        <InputDate class="form-input" @bind-Value="_form.DueDate" />
                    </div>
                </div>

                @if (_error is not null)
                {
                    <div class="mb-4"><ErrorAlert Message="@_error" /></div>
                }

                <div class="flex justify-end gap-2 pt-4 border-t border-gray-100">
                    <button type="button" class="btn btn-outline" @onclick="() => _editing = false" disabled="@_busy">@L["Cancel"]</button>
                    <button type="submit" class="btn btn-primary" disabled="@_busy">@(_busy ? "…" : L["Save"].Value)</button>
                </div>
            </EditForm>
        }

        </ChildContent>
    </Modal>
}

@code {
    [Parameter, EditorRequired] public TicketDto? Ticket { get; set; }
    [Parameter, EditorRequired] public IEnumerable<TicketStatusDto> Statuses { get; set; } = [];
    [Parameter] public IEnumerable<SprintDto> Sprints { get; set; } = [];
    [Parameter] public bool Visible { get; set; }
    [Parameter] public Guid? ActiveSprintId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _editing;
    private bool _busy;
    private string? _error;
    private TicketEditForm _form = new();
    private List<UserSummaryDto> _users = [];

    // Comments state
    private IReadOnlyList<CommentDto> _comments = [];
    private bool _commentsLoading;
    private string _newCommentContent = string.Empty;
    private Guid? _editingCommentId;
    private string _editCommentContent = string.Empty;
    private List<IBrowserFile> _pendingCommentFiles = [];
    private Guid? _lastLoadedTicketId;
    private List<LabelDto> _labels = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && Ticket is not null && Ticket.Id != _lastLoadedTicketId)
        {
            _lastLoadedTicketId = Ticket.Id;
            _labels = Ticket.Labels.ToList();
            _commentsLoading = true;
            try { _comments = await CommentApi.GetByTicketAsync(Ticket.Id); }
            catch { _comments = []; }
            finally { _commentsLoading = false; }

            if (_users.Count == 0)
            {
                try { _users = await UserApi.GetAllAsync() ?? []; }
                catch { _users = []; }
            }
        }
        if (!Visible) _lastLoadedTicketId = null;
    }

    private async Task AddCommentAsync()
    {
        if (Ticket is null) return;
        if (string.IsNullOrWhiteSpace(_newCommentContent) && _pendingCommentFiles.Count == 0) return;
        try
        {
            var content = string.IsNullOrWhiteSpace(_newCommentContent) ? "📎" : _newCommentContent;
            var comment = await CommentApi.CreateForTicketAsync(Ticket.Id, new CreateCommentRequest(content));
            if (comment is not null)
            {
                _comments = [.. _comments, comment];
                foreach (var file in _pendingCommentFiles)
                {
                    try { await AttachmentApi.UploadForCommentAsync(comment.Id, file); } catch { /* ignore */ }
                }
                _pendingCommentFiles.Clear();
            }
            _newCommentContent = string.Empty;
        }
        catch { /* silently ignore */ }
    }

    private void HandlePendingCommentFilesAsync(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
            _pendingCommentFiles.Add(file);
    }

    private void StartEditComment(CommentDto c)
    {
        _editingCommentId   = c.Id;
        _editCommentContent = c.Content;
    }

    private async Task SaveCommentEditAsync(Guid commentId)
    {
        try
        {
            var updated = await CommentApi.UpdateAsync(commentId, new UpdateCommentRequest(_editCommentContent));
            if (updated is not null)
                _comments = _comments.Select(c => c.Id == commentId ? updated : c).ToList().AsReadOnly();
            _editingCommentId = null;
        }
        catch { /* silently ignore */ }
    }

    private async Task DeleteCommentAsync(Guid commentId)
    {
        try
        {
            await CommentApi.DeleteAsync(commentId);
            _comments = _comments.Where(c => c.Id != commentId).ToList().AsReadOnly();
        }
        catch { /* silently ignore */ }
    }

    private sealed class TicketEditForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public TicketType Type { get; set; } = TicketType.Story;
        public CardPriority Priority { get; set; } = CardPriority.Medium;
        public int? StoryPoints { get; set; }
        public DateTime? DueDate { get; set; }
    }

    private void EnterEdit()
    {
        if (Ticket is null) return;
        _form = new()
        {
            Title       = Ticket.Title,
            Description = Ticket.Description,
            Type        = Ticket.Type,
            Priority    = Ticket.Priority,
            StoryPoints = Ticket.StoryPoints,
            DueDate     = Ticket.DueDate
        };
        _error   = null;
        _editing = true;
    }

    private async Task CloseAsync()
    {
        _editing = false;
        _error   = null;
        await OnClose.InvokeAsync();
    }

    private async Task OnStatusChangeAsync(ChangeEventArgs e)
    {
        if (Ticket is null || !Guid.TryParse(e.Value?.ToString(), out var statusId)) return;
        _busy = true; _error = null;
        try
        {
            await TicketApi.ChangeStatusAsync(Ticket.Id, new ChangeTicketStatusRequest(statusId));
            await OnChanged.InvokeAsync();
        }
        catch { _error = "Impossible de changer le statut."; }
        finally { _busy = false; }
    }

    private async Task OnSprintChangeAsync(ChangeEventArgs e)
    {
        if (Ticket is null) return;
        _busy = true; _error = null;
        try
        {
            var raw = e.Value?.ToString();
            var sprintId = string.IsNullOrEmpty(raw) ? (Guid?)null : Guid.Parse(raw);
            await TicketApi.MoveToSprintAsync(Ticket.Id, new MoveTicketToSprintRequest(sprintId));
            await OnChanged.InvokeAsync();
        }
        catch { _error = "Impossible de changer le sprint."; }
        finally { _busy = false; }
    }

    private async Task OnAssigneeChangeAsync(ChangeEventArgs e)
    {
        if (Ticket is null) return;
        _busy = true; _error = null;
        try
        {
            var raw = e.Value?.ToString();
            var assigneeId = string.IsNullOrEmpty(raw) ? null : raw;
            await TicketApi.UpdateAsync(Ticket.Id, new UpdateTicketRequest(
                Ticket.Title, Ticket.Description, Ticket.Type, Ticket.Priority,
                Ticket.StoryPoints, Ticket.DueDate, assigneeId));
            await OnChanged.InvokeAsync();
        }
        catch { _error = "Impossible de changer l'assigné."; }
        finally { _busy = false; }
    }

    private async Task OnSaveAsync()
    {
        if (Ticket is null) return;
        _busy = true; _error = null;
        try
        {
            await TicketApi.UpdateAsync(Ticket.Id, new UpdateTicketRequest(
                _form.Title, _form.Description, _form.Type, _form.Priority,
                _form.StoryPoints, _form.DueDate, Ticket.AssigneeId));
            _editing = false;
            await OnChanged.InvokeAsync();
        }
        catch { _error = "La mise à jour a échoué."; }
        finally { _busy = false; }
    }

    private async Task OnDeleteAsync()
    {
        if (Ticket is null) return;
        _busy = true; _error = null;
        try
        {
            await TicketApi.DeleteAsync(Ticket.Id);
            await OnChanged.InvokeAsync();
            await CloseAsync();
        }
        catch { _error = "Impossible de supprimer ce ticket."; }
        finally { _busy = false; }
    }

    private async Task OnAddToSprintAsync()
    {
        if (Ticket is null || !ActiveSprintId.HasValue) return;
        _busy = true; _error = null;
        try
        {
            await TicketApi.MoveToSprintAsync(Ticket.Id, new MoveTicketToSprintRequest(ActiveSprintId));
            await OnChanged.InvokeAsync();
        }
        catch { _error = "Impossible d'ajouter au sprint."; }
        finally { _busy = false; }
    }

    private static string PriorityBadgeClass(CardPriority priority) => priority switch
    {
        CardPriority.Low      => "badge badge-prio-low",
        CardPriority.Medium   => "badge badge-prio-medium",
        CardPriority.High     => "badge badge-prio-high",
        CardPriority.Critical => "badge badge-prio-critical",
        _                     => "badge badge-gray"
    };

    private static string AvatarColor(string name) => (name.Length > 0 ? char.ToUpper(name[0]) : '?') switch
    {
        >= 'A' and <= 'D' => "av-sky",
        >= 'E' and <= 'H' => "av-violet",
        >= 'I' and <= 'L' => "av-green",
        >= 'M' and <= 'P' => "av-amber",
        >= 'Q' and <= 'T' => "av-rose",
        _                 => "av-gray",
    };
}
