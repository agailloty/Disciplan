# Copy this file to .env and fill in the values.
# Generate a JWT secret with: openssl rand -base64 48

JWT_SECRET_KEY=replace_with_a_random_string_of_at_least_32_characters
JWT_ISSUER=Disciplaner
JWT_AUDIENCE=Disciplaner

# Optional: first admin account created on startup.
# Leave empty to use the /setup wizard on first run instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
