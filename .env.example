# Copy this file to .env and fill in the values.
# Generate a JWT secret with: openssl rand -base64 48

JWT_SECRET_KEY=replace_with_a_random_string_of_at_least_32_characters
JWT_ISSUER=Disciplaner
JWT_AUDIENCE=Disciplaner

# Optional: first admin account created on startup.
# Leave empty to use the /setup wizard on first run instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Database Configuration ────────────────────────────────────────────────────
# 1. For compose.yml (SQLite fallback by default, or external Cloud PostgreSQL):
#    Leave DATABASE_URL and POSTGRES_CONNECTION_STRING empty to fallback to SQLite (/data/disciplaner.db),
#    or set either variable to connect to a Cloud managed PostgreSQL (Neon, Supabase, RDS, etc.):
DATABASE_URL=
POSTGRES_CONNECTION_STRING=

# 2. For compose.postgres.yml (self-hosted PostgreSQL 17 container):
POSTGRES_DB=disciplaner
POSTGRES_USER=disciplaner
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
